is_debug = false
# A static release build links more slowly but produces fewer/lower-size runtime
# binaries than a component build. Keep one compact output tree for the pilot.
is_component_build = false
symbol_level = 0
# Keep the two largest language runtimes from retaining separate debug symbols.
blink_symbol_level = 0
v8_symbol_level = 0
is_official_build = false
# Match production browser runtime checks. Non-official Chromium builds enable
# DCHECK and EXPENSIVE_DCHECK by default even when is_debug is false.
dcheck_always_on = false
# Non-Chrome-branded builds otherwise enable Chromium's fieldtrial testing
# config, including a macOS experiment that caps main-thread frames at 60 Hz.
disable_fieldtrial_testing_config = true
