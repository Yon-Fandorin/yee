+TEST_F(LegacyCleanupsTest, YeeRemovalPreservesOtherBrowserRegistration) {
+  registry_util::RegistryOverrideManager machine_registry;
+  ASSERT_NO_FATAL_FAILURE(
+      machine_registry.OverrideRegistry(HKEY_LOCAL_MACHINE));
+  const base::FilePath chrome_exe =
+      installer_state().target_path().Append(kChromeExe);
+  ASSERT_TRUE(base::WriteFile(chrome_exe, "test executable"));
+  const wchar_t* shared_keys[] = {
+      L"Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\chrome.exe",
+      L"Software\\Classes\\Applications\\chrome.exe\\shell\\open\\command",
+      L"Software\\Classes\\.html\\OpenWithList\\chrome.exe",
+      L"Software\\Classes\\ChromiumExt",
+      L"Software\\Classes\\.crx",
+      L"Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\Yee.exe",
+      L"Software\\Classes\\Applications\\Yee.exe\\shell\\open\\command",
+  };
+  for (auto* key_name : shared_keys) {
+    base::win::RegKey key(HKEY_CURRENT_USER, key_name, KEY_ALL_ACCESS);
+    ASSERT_TRUE(key.Valid());
+    ASSERT_EQ(ERROR_SUCCESS,
+              key.WriteValue(L"", L"C:\\Other Browser\\chrome.exe"));
+  }
+  InstallStatus status = UNKNOWN_STATUS;
+  EXPECT_TRUE(DeleteChromeRegistrationKeys(installer_state(), HKEY_CURRENT_USER,
+                                           L"", &status));
+  RemoveChromeLegacyRegistryKeys(chrome_exe);
+  for (auto* key_name : shared_keys) {
+    base::win::RegKey key(HKEY_CURRENT_USER, key_name, KEY_QUERY_VALUE);
+    std::wstring value;
+    ASSERT_EQ(ERROR_SUCCESS, key.ReadValue(L"", &value));
+    EXPECT_EQ(value, L"C:\\Other Browser\\chrome.exe");
+  }
+  // 같은 Yee 등록 이름이라도 제거 대상의 실행 경로를 소유한 경우만 지운다.
+  const wchar_t* app_path =
+      L"Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\Yee.exe";
+  const wchar_t* application = L"Software\\Classes\\Applications\\Yee.exe";
+  base::win::RegKey owned_path(HKEY_CURRENT_USER, app_path, KEY_ALL_ACCESS);
+  ASSERT_EQ(ERROR_SUCCESS,
+            owned_path.WriteValue(L"", chrome_exe.value().c_str()));
+  owned_path.Close();
+  base::win::RegKey owned_application(
+      HKEY_CURRENT_USER,
+      (std::wstring(application) + L"\\shell\\open\\command").c_str(),
+      KEY_ALL_ACCESS);
+  ASSERT_EQ(
+      ERROR_SUCCESS,
+      owned_application.WriteValue(
+          L"", base::CommandLine(chrome_exe).GetCommandLineString().c_str()));
+  owned_application.Close();
+  EXPECT_TRUE(DeleteChromeRegistrationKeys(installer_state(), HKEY_CURRENT_USER,
+                                           L"", &status));
+  EXPECT_FALSE(
+      base::win::RegKey(HKEY_CURRENT_USER, app_path, KEY_READ).Valid());
+  EXPECT_FALSE(
+      base::win::RegKey(HKEY_CURRENT_USER, application, KEY_READ).Valid());
