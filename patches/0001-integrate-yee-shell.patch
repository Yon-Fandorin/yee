+void TabGroupHeaderView::UpdateForegroundColor(SkColor foreground_color) {
+  group_header_label_->SetEnabledColor(foreground_color);
+
+  sync_icon_->SetVisible(is_shared_);
+  if (is_shared_) {
+    sync_icon_->SetImage(ui::ImageModel::FromVectorIcon(
+        features::IsRoundedIconsEnabled() ? kGroupCustomIcon
+                                          : kPeopleGroupOldIcon,
+        foreground_color, kIconSize));
+  }
+
+  if (editor_bubble_button_) {
+    UpdateEditorButtonColors(editor_bubble_button_, foreground_color);
+    UpdateEditorBubbleButtonVisibility();
+  }
+
+  if (color_mark_) {
+    color_mark_->SetDisclosureAppearance(!tab_group_visual_data_.is_collapsed(),
+                                         foreground_color);
+  }
+  if (collapse_icon_) {
+    collapse_icon_->SetVisible(!yee::UsesExpandedSidebarPresentation() &&
+                               !delegate_->IsGroupFocused());
+    collapse_icon_->SetImage(ui::ImageModel::FromVectorIcon(
+        tab_group_visual_data_.is_collapsed()
+            ? features::IsRoundedIconsEnabled()
+                  ? kKeyboardArrowDownIcon
+                  : kKeyboardArrowDownChromeRefreshOldIcon
+        : features::IsRoundedIconsEnabled()
+            ? vector_icons::kKeyboardArrowUpIcon
+            : kKeyboardArrowUpChromeRefreshOldIcon,
+        foreground_color, kIconSize));
+  }
+}
+
+void TabGroupHeaderView::UpdateVerticalColorsForCurrentState() {
+  UpdateVerticalHoverBackground(IsMouseHovered());
+}
+
+void TabGroupHeaderView::UpdateVerticalHoverBackground(bool hovered) {
+  if (color_mark_ && GetColorProvider()) {
+    color_mark_->SetDisclosureState(
+        yee::UsesExpandedSidebarPresentation() &&
+            !delegate_->IsGroupFocused() && (hovered || HasFocus()),
+        !tab_group_visual_data_.is_collapsed(), GetForegroundColor());
+  }
+  yee::UpdateTabGroupPreviewColors(*this, hovered);
+  if (orientation_ != TabStripOrientation::kVertical) {
+    if (!GetColorProvider()) {
+      return;
+    }
+    const SkColor group_color = GetColorProvider()->GetColor(
+        GetTabGroupTabStripColorId(tab_group_visual_data_.color(),
+                                   GetWidget()->ShouldPaintAsActive()));
+    const auto colors =
+        yee::ResolveHorizontalTabGroupColors(*this, group_color, hovered);
+    UpdateForegroundColor(
+        colors ? colors->foreground
+               : color_utils::GetColorWithMaxContrast(group_color));
+    SetBackground(colors
+                      ? yee::CreateHorizontalTabGroupBackground(
+                            colors->background, hovered)
+                      : views::CreateRoundedRectBackground(
+                            group_color,
+                            yee::kSidebarMetrics.group_header_corner_radius));
+    if (auto* ring = views::FocusRing::Get(this)) {
+      ring->SetColorId(
+          colors ? std::make_optional(yee::ResolveBrowserSurfaceFocusColorId(
+                       *GetColorProvider(), colors->background,
+                       ui::kColorSysStateFocusRing))
+                 : std::nullopt);
+    }
+    return;
+  }
+  const views::Widget* const widget = GetWidget();
+  const yee::SidebarItemColors colors = yee::ResolveSidebarItemColors(
+      *GetColorProvider(),
+      hovered ? yee::SidebarItemVisualState::kHovered
+              : yee::SidebarItemVisualState::kResting,
+      hovered ? 1.0 : 0.0, !widget || widget->ShouldPaintAsActive(),
+      /*persistent_surface=*/false);
+  UpdateForegroundColor(colors.foreground);
+  if (hovered) {
+    SetBackground(views::CreateRoundedRectBackground(
+        colors.fill, yee::kSidebarMetrics.group_header_corner_radius));
+  } else {
+    SetBackground(nullptr);
+  }
+}
+
+void TabGroupHeaderView::SetMarkSignals(const yee::GroupMarkSignals& signals) {
+  if (!color_mark_) {
+    return;
+  }
+  color_mark_->SetNeedsInput(signals.needs_input);
+  color_mark_->SetAudioActive(signals.audio);
+  color_mark_->SetUnread(signals.unread);
+}
