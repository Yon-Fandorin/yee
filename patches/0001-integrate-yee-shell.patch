+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!HasValidSandboxFlags()) {
+    mojo::ReportBadMessage(ServiceWorkerConsts::kBadMessageFromSandboxedClient);
+    return;
