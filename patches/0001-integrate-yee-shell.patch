+#define CHROME_BROWSER_UI_VIEWS_FRAME_LAYOUT_BROWSER_VIEW_TABBED_LAYOUT_NATIVE_GEOMETRY_H_
+
+#include <optional>
+
+#include "chrome/browser/ui/views/frame/layout/browser_view_layout_delegate.h"
