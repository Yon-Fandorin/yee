+          std::max(compact_group_bottom,
+                   header_layout ? header_layout->bounds.bottom() : 0);
+      const int group_tabs_top =
+          compact_child_y +
+          (header_layout ? header_layout->bounds.bottom() + row_margin : 0);
+      if (!group->IsCollapsed() && dragged_row_center >= group_tabs_top &&
+          dragged_row_center < compact_child_y + compact_group_height) {
+        incoming_group_id_ = group->GetTabGroup().id();
+        int group_index = 0;
+        const int dragged_row_center_in_group =
+            dragged_row_center - compact_child_y;
+        // Hit-test the pointer-aligned row center against compact group
+        // geometry, not the animated target layout's child y positions. This
+        // gives every tab an upper-half "before" target and a lower-half
+        // "after" target, including the otherwise unreachable gap after the
+        // final tab. The target layout already contains the previous incoming
+        // gap, so feeding it back into the next hit test would also make that
+        // first gap sticky.
+        int compact_group_tab_y =
+            header_layout ? header_layout->bounds.bottom() + row_margin : 0;
+        for (const views::ChildLayout* grouped_layout : visible_group_layouts) {
+          if (!header_layout && group_index == 0) {
+            compact_group_tab_y = grouped_layout->bounds.y();
+          }
+          const int compact_center_y =
+              compact_group_tab_y + grouped_layout->bounds.height() / 2;
+          if (dragged_row_center_in_group < compact_center_y) {
+            incoming_group_gap_before_ = group_index;
+            return;
+          }
+          compact_group_tab_y += grouped_layout->bounds.height() + row_margin;
+          ++group_index;
+        }
+        incoming_group_gap_before_ = group_index;
+        return;
+      }
+      if (dragged_row_top < compact_child_y + compact_group_height / 2) {
+        incoming_unpinned_gap_before_ = visible_index;
+        return;
+      }
+      compact_child_y += compact_group_height + row_margin;
+      ++visible_index;
+      continue;
+    }
+    const int compact_child_height = child_layout.bounds.height();
+    if (dragged_row_top < compact_child_y + compact_child_height / 2) {
+      incoming_unpinned_gap_before_ = visible_index;
+      return;
+    }
+    compact_child_y += compact_child_height + row_margin;
+    ++visible_index;
+  }
+  incoming_unpinned_gap_before_ = visible_index;
+}
+
+void TabDragHandlerImpl::SetDraggedTabViewsHidden(bool hidden) {
+  if (!drag_controller_ || IsDraggingGroups()) {
+    return;
+  }
+  for (TabSlotView* slot_view :
+       drag_controller_->GetSessionData().attached_views()) {
+    if (!slot_view) {
+      continue;
+    }
+    views::View* const dragged_view = ViewFromTabSlot(slot_view);
+    if (!dragged_view) {
+      continue;
+    }
+    if (!dragged_view->layer()) {
+      if (!hidden) {
+        continue;
+      }
+      dragged_view->SetPaintToLayer();
+      dragged_view->layer()->SetFillsBoundsOpaquely(false);
+    }
+    dragged_view->layer()->SetOpacity(hidden ? 0.f : 1.f);
+  }
+}
