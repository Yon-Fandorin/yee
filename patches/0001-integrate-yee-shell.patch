+        initial_footer_width = footer->width();
+        region->OnResize(
+            std::min(VerticalTabStripRegionView::kUncollapsedMaxWidth,
+                     original_sidebar_width + 40) -
+                original_sidebar_width,
+            /*done_resizing=*/true);
+        footer->GetWidget()->LayoutRootViewIfNecessary();
+      }),
+      Check([&]() {
+        views::View* const menu = yee::GetSidebarFooterMenuForTesting(*footer);
+        return menu && footer->width() > initial_footer_width &&
+               menu->GetPreferredSize().width() == footer->width();
+      }),
+      MoveMouseTo(kFooter, CenterPoint()), ClickMouse(), Check([&]() {
+        return footer && !yee::GetSidebarFooterMenuForTesting(*footer);
