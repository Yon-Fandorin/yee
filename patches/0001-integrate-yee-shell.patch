+
+void MultiContentsViewMiniToolbar::SetYeePresentationUpdatesSuspended(
+    bool suspended) {
+  if (yee_presentation_updates_suspended_ == suspended) {
+    return;
+  }
+  yee_presentation_updates_suspended_ = suspended;
+  if (!suspended && yee_presentation_update_pending_) {
+    yee_presentation_update_pending_ = false;
+    UpdateYeeHeaderPresentation();
+  }
+}
+
+void MultiContentsViewMiniToolbar::AddedToWidget() {
+  views::View::AddedToWidget();
+  UpdateYeeHeaderPresentation();
+}
+
+void MultiContentsViewMiniToolbar::AttachYeeSplitLocationBar(
+    views::View* location_bar) {
+  CHECK(uses_yee_browser_surface_geometry_);
+  CHECK(location_bar);
+  CHECK(!yee_location_bar_);
+  const size_t insertion_index = GetIndexOf(favicon_).value();
+  yee_location_bar_ = AddChildViewAt(location_bar, insertion_index);
+  yee_location_bar_->SetVisible(true);
+  InvalidateLayout();
+}
+
+views::View*
+MultiContentsViewMiniToolbar::ReleaseYeeSplitLocationBarForReparent() {
+  CHECK(yee_location_bar_);
+  views::View* const location_bar = yee_location_bar_;
+  yee_location_bar_ = nullptr;
+  InvalidateLayout();
+  return location_bar;
+}
+
 void MultiContentsViewMiniToolbar::UpdateState(bool is_active,
                                                bool is_highlighted) {
+  if (uses_yee_browser_surface_geometry_) {
+    is_active_ = is_active;
+    UpdateYeeInteriorMargin();
+
+    SetVisible(!is_highlighted);
+    favicon_->SetVisible(!is_active);
+    domain_label_->SetVisible(false);
+    if (yee_resting_text_) {
+      yee_resting_text_->SetVisible(!is_active);
+    }
+    alert_state_indicator_->SetVisible(!is_active);
+    if (yee_sidebar_button_) {
+      yee_sidebar_button_->SetVisible(is_active);
+    }
+    yee_back_button_->SetVisible(true);
+    yee_forward_button_->SetVisible(true);
