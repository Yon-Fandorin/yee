+  manager_web_contents_ =
+      content_manager ? content_manager->web_contents()->GetWeakPtr() : nullptr;
+  infobars::InfoBarContainerWithPriority::ChangeInfoBarManager(infobar_manager);
+}
+
+void InfoBarContainerView::OnManagerWillBeDestroyed(
+    infobars::InfoBarManager* infobar_manager) {
