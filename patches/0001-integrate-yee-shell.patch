+void LocationBarView::RefreshCompactShellControlColors() {
+  if (!compact_shell_mode_) {
+    return;
+  }
+
+  const bool high_contrast = GetNativeTheme()->preferred_contrast() ==
+                             ui::NativeTheme::PreferredContrast::kMore;
+  const bool custom_colors =
+      compact_shell_presentation_.has_value() && !high_contrast &&
+      compact_shell_presentation_->palette_mode ==
+          yee::BrowserSurfacePresentation::PaletteMode::kCustomSurface;
+  const SkColor icon_color =
+      custom_colors ? compact_shell_presentation_->primary
+                    : GetColorProvider()->GetColor(kColorOmniboxActionIcon);
+  for (ContentSettingImageView* image_view : content_setting_views_) {
+    image_view->SetIconColor(icon_color);
+  }
+  location_icon_view_->Update(/*suppress_animations=*/true,
+                              /*force_hide_background=*/false);
+  page_action_container_->RefreshColors();
+  if (yee_site_controls_button_) {
+    yee_site_controls_button_->SetIconColor(custom_colors
+                                                ? std::optional<SkColor>(
+                                                      compact_shell_presentation_
+                                                          ->primary)
+                                                : std::nullopt);
+  }
+}
+
+void LocationBarView::UpdateCompactShellRestingText() {
+  if (!compact_shell_resting_text_view_) {
+    return;
+  }
+
+  std::u16string title;
+  std::u16string origin;
+  bool visible =
+      compact_shell_mode_ && !HasFocus() &&
+      !GetOmniboxController()->edit_model()->user_input_in_progress() &&
+      compact_shell_presentation_.has_value() &&
+      compact_shell_presentation_->palette_mode ==
+          yee::BrowserSurfacePresentation::PaletteMode::kCustomSurface &&
+      GetNativeTheme()->preferred_contrast() !=
+          ui::NativeTheme::PreferredContrast::kMore;
+
+  if (visible && browser_) {
+    content::WebContents* const contents =
+        browser_->tab_strip_model()->GetActiveWebContents();
+    if (contents) {
+      const GURL& url = contents->GetVisibleURL();
+      title = contents->GetTitle();
+      if (url.SchemeIsHTTPOrHTTPS()) {
+        origin = url_formatter::FormatUrlForSecurityDisplay(
+            url, url_formatter::SchemeDisplay::OMIT_HTTP_AND_HTTPS);
+        if (base::StartsWith(origin, u"www.", base::CompareCase::SENSITIVE)) {
+          origin.erase(0, 4);
+        }
+      }
+    }
+  }
+
+  visible = visible && !title.empty() && !origin.empty();
+  if (compact_shell_presentation_.has_value()) {
+    yee::UpdateOmniboxRestingTextView(*compact_shell_resting_text_view_, title,
+                                      origin, *compact_shell_presentation_,
+                                      visible);
+  } else {
+    compact_shell_resting_text_view_->SetVisible(false);
+  }
+}
