+IN_PROC_BROWSER_TEST_P(MultiContentsViewUiTest,
+                       YeeSidebarHeaderControlsPersistAcrossSplitAndCollapse) {
+  ASSERT_TRUE(yee::IsShellEnabled());
+  views::View* original_actions = nullptr;
+  views::View* original_create = nullptr;
+  views::View* original_agent = nullptr;
+  auto controls_match = [this, &original_actions, &original_create,
+                         &original_agent](bool visible) {
+    auto* region = BrowserView::GetBrowserViewForBrowser(browser())
+                       ->vertical_tab_strip_region_view_for_testing();
+    views::View* actions = region->sidebar_header_actions_for_testing();
+    if (!actions || actions->GetID() != yee::kSidebarHeaderActionsViewId ||
+        actions->parent() != region || !actions->GetVisible() ||
+        actions->children().size() != 2) {
+      return false;
+    }
+    int actions_count = 0;
+    for (views::View* child : region->children()) {
+      actions_count += child->GetID() == yee::kSidebarHeaderActionsViewId;
+    }
+    views::View* create = actions->GetViewByID(yee::kSidebarHeaderCreateViewId);
+    views::View* agent = actions->GetViewByID(yee::kSidebarHeaderAgentViewId);
+    if (actions_count != 1 || !create || !agent || create == agent ||
+        create->parent() != actions || agent->parent() != actions ||
+        actions->children()[0] != create || actions->children()[1] != agent) {
+      return false;
+    }
+    if (!original_actions) {
+      original_actions = actions;
+      original_create = create;
+      original_agent = agent;
+    }
+    return actions == original_actions && create == original_create &&
+           agent == original_agent && create->GetVisible() == visible &&
+           agent->GetVisible() == visible;
+  };
+
+  RunTestSequence(
+      Check([&]() { return controls_match(true); }),
+      CreateTabsAndEnterSplitView(), WaitForActiveTabChange(0),
+      Check([&]() { return controls_match(true); }), Do([&]() {
+        tabs::VerticalTabStripStateController::From(browser())->RequestCollapse(
+            true);
+      }),
+      WaitForEvent(kTabStripRegionElementId,
+                   VerticalTabStripRegionView::kAnimationCompletedEvent),
+      Check([&]() { return controls_match(false); }), Do([&]() {
+        tabs::VerticalTabStripStateController::From(browser())->RequestCollapse(
+            false);
+      }),
+      WaitForEvent(kTabStripRegionElementId,
+                   VerticalTabStripRegionView::kAnimationCompletedEvent),
+      Check([&]() { return controls_match(true); }));
+}
