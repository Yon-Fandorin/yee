+  disable(features::kWebUIExtensionsContainer);
+  disable(features::kWebUISplitTabsButton);
+  disable(features::kWebUILocationBar);
+  disable(features::kWebUIAvatarButton);
+  disable(features::kWebUIMediaButton);
+}
+#endif  // !BUILDFLAG(IS_ANDROID)
