+void ShowYeeAgentActivity(BrowserWindowInterface* browser, int event_flags) {
+  auto* const controller = tabs::VerticalTabStripStateController::From(browser);
+  if (controller && controller->GetCollapseState() !=
+                        tabs::VerticalTabStripCollapseState::kExpanded) {
+    chrome::ExecuteCommandWithDisposition(
+        browser, IDC_TOGGLE_VERTICAL_TABS_COLLAPSE,
+        ui::DispositionFromEventFlags(event_flags));
+  }
+}
+
+void ExecuteYeeCreateAction(BrowserWindowInterface* browser,
+                            yee::ShellCreateAction action,
+                            int event_flags) {
+  switch (action) {
+    case yee::ShellCreateAction::kNewTab:
+      chrome::ExecuteCommandWithDisposition(
+          browser, IDC_NEW_TAB, ui::DispositionFromEventFlags(event_flags));
+      break;
+    case yee::ShellCreateAction::kNewGroup:
+      chrome::ExecuteCommand(browser, IDC_CREATE_NEW_TAB_GROUP);
+      break;
+    case yee::ShellCreateAction::kNewProject:
+      if (auto* projects =
+              yee::projects::ProjectNavigationController::From(browser)) {
+        projects->CreateProject();
+      }
+      break;
+    case yee::ShellCreateAction::kChat:
+      ShowYeeAgentActivity(browser, event_flags);
+      break;
+  }
+}
+
+yee::SidebarFooterModel CreateYeeSidebarFooterModel(
+    BrowserWindowInterface* browser,
+    const AvatarMenu& profiles) {
+  Profile* const current = browser->GetProfile();
+  const std::u16string current_name =
+      base::UTF8ToUTF16(current->GetPrefs()->GetString(prefs::kProfileName));
+  const std::optional<size_t> active = profiles.GetActiveProfileIndex();
+  yee::SidebarFooterModel model;
+  model.selected_context_index = active.value_or(profiles.GetNumberOfItems());
+  ProfileAttributesStorage& attributes =
+      g_browser_process->profile_manager()->GetProfileAttributesStorage();
+  for (size_t index = 0; index < profiles.GetNumberOfItems(); ++index) {
+    const AvatarMenu::Item& item = profiles.GetItemAt(index);
+    const ProfileAttributesEntry* const entry =
+        attributes.GetProfileAttributesWithPath(item.profile_path);
+    auto local = yee::CreateLocalSidebarFooterModel(
+        item.name, entry ? entry->GetUserName() : std::u16string());
+    model.contexts.push_back(std::move(local.contexts.front()));
+  }
+  if (!active) {
+    // Guest·숨김 프로필에서도 다른 native 전환 대상은 유지한다.
+    auto local = yee::CreateLocalSidebarFooterModel(
+        current_name, base::UTF8ToUTF16(current->GetProfileUserName()));
+    model.contexts.push_back(std::move(local.contexts.front()));
+  }
+  return model;
+}
+
+void ExecuteYeeSidebarFooterBrowserAction(
+    BrowserWindowInterface* browser,
+    yee::SidebarFooterBrowserAction action) {
+  switch (action) {
+    case yee::SidebarFooterBrowserAction::kReopenClosedTab:
+      chrome::RestoreTab(browser);
+      break;
+    case yee::SidebarFooterBrowserAction::kDownloads:
+      chrome::ShowDownloads(browser);
+      break;
+    case yee::SidebarFooterBrowserAction::kHistory:
+      chrome::ShowHistory(browser);
+      break;
+    case yee::SidebarFooterBrowserAction::kTabsFromOtherDevices:
+      chrome::ShowHistorySubPage(browser, chrome::kChromeUIHistorySyncedTabs);
+      break;
+    case yee::SidebarFooterBrowserAction::kManageExtensions:
+      chrome::ShowExtensions(browser);
+      break;
+  }
+}
