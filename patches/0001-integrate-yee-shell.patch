+        *browser_view_->toolbar()->location_bar_view();
+    return yee::ResolveSplitPaneHeaderLayout(yee::SplitPaneHeaderLayoutInput{
+        canvas,
+        yee_header_layout_context_->window_controls_in_browser,
+        input.axis,
+        input.start_ratio,
+        input.divider_size,
+        input.minimums,
+        {contents_container_views_[0]->mini_toolbar()->GetYeeHeaderMetrics(
+             contents_container_views_[0]->contents_view() ==
+                 GetActiveContentsView(),
