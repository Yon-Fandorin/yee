+void MultiContentsViewMiniToolbar::UpdateYeeInteriorMargin() {
+  CHECK(uses_yee_browser_surface_geometry_);
+#if BUILDFLAG(IS_WIN)
+  if (yee_header_layout_) {
+    // 이번 부모 배치에서 정한 여백을 이전 Header bounds로 덮어쓰지 않는다.
+    static_cast<views::FlexLayout*>(GetLayoutManager())
+        ->SetInteriorMargin(yee_header_layout_->interior_margin);
+    return;
+  }
+#endif
+  const int horizontal_padding = std::max(
+      yee::kSidebarMetrics.browser_surface_header_control_edge_inset,
+      yee::kSidebarMetrics.split_pane_address_bar_inset +
+          (is_active_
+               ? yee::kSidebarMetrics.split_pane_address_bar_active_padding
+               : yee::kSidebarMetrics
+                     .split_pane_address_bar_horizontal_padding));
+  int leading_padding = horizontal_padding;
+
+  // A split Pane Header replaces the shared Toolbar, so it must independently
+  // respect platform-owned leading caption controls. Derive the safe edge from
+  // the real frame exclusion instead of copying macOS traffic-light geometry.
+  if (browser_view_ && parent()) {
+    gfx::Point header_origin;
+    views::View::ConvertPointToTarget(this, browser_view_, &header_origin);
+    const int safe_leading_edge =
+        browser_view_->GetYeeLeadingWindowControlsSafeEdge() +
+        yee::kSidebarMetrics.sidebar_header_controls_leading_inset();
+    leading_padding =
+        std::max(leading_padding, safe_leading_edge - header_origin.x());
+  }
+
+  gfx::Insets margins =
+      base::i18n::IsRTL()
+          ? gfx::Insets::TLBR(0, horizontal_padding, 0, leading_padding)
+          : gfx::Insets::TLBR(0, leading_padding, 0, horizontal_padding);
+#if BUILDFLAG(IS_WIN)
+  if (browser_view_ && parent()) {
+    const BrowserLayoutParams frame_params = browser_view_->browser_widget()
+                                                 ->GetFrameView()
+                                                 ->GetBrowserLayoutParams();
+    if (frame_params.IsEmpty()) {
+      // 테마 전환 중 새 프레임은 아직 client 배치를 받지 않았다. 마지막 유효
+      // 여백을 유지하고 다음 Layout에서 새 caption exclusion을 적용한다.
+      return;
+    }
+    const BrowserLayoutParams params =
+        frame_params.InLocalCoordinates(browser_view_->bounds());
+    const gfx::SizeF exclusion = params.trailing_exclusion.ContentWithPadding();
+    gfx::Point origin;
+    views::View::ConvertPointToTarget(this, browser_view_, &origin);
+    // 물리 Header 좌표를 frame exclusion과 Flex가 사용하는 논리 좌표로 맞춘다.
+    const gfx::Rect header =
+        browser_view_->GetMirroredRect(gfx::Rect(origin, size()));
+    const gfx::Rect controls(
+        params.visual_client_area.right() - base::ClampCeil(exclusion.width()),
+        params.visual_client_area.y(), base::ClampCeil(exclusion.width()),
+        base::ClampCeil(exclusion.height()));
+    if (header.Intersects(controls)) {
+      // Window Controls가 겹치는 윗줄 Pane만 가로 공간을 내준다.
+      // 실제 카드와 WebContents의 폭·곡률은 그대로 유지한다.
+      const gfx::Rect safe =
+          yee::ExcludeBrowserWindowControls(header, controls);
+      margins.set_left(std::max(margins.left(), safe.x() - header.x()));
+      margins.set_right(
+          std::max(margins.right(), header.right() - safe.right()));
+    }
+  }
+#endif
+  static_cast<views::FlexLayout*>(GetLayoutManager())
+      ->SetInteriorMargin(margins);
+}
