+yee::SplitPaneHeaderMetrics MultiContentsViewMiniToolbar::GetYeeHeaderMetrics(
+    bool active,
+    const views::View& native_location_bar) const {
+  yee::SplitPaneHeaderMetrics result;
+  result.active = active;
+  const auto measure = [](const views::View* control, bool minimum) {
+    yee::SplitPaneHeaderControlMetrics metric;
+    if (!control) {
+      return metric;
+    }
+    metric.width = minimum ? control->GetMinimumSize().width()
+                           : control->GetPreferredSize().width();
+    if (const auto* margins = control->GetProperty(views::kMarginsKey)) {
+      metric.margins = *margins;
+    }
+    if (const auto* padding =
+            control->GetProperty(views::kInternalPaddingKey)) {
+      metric.internal_padding = *padding;
+    }
+    return metric;
+  };
+  result.controls = {
+      measure(active ? yee_sidebar_button_.get() : nullptr, false),
+      measure(yee_back_button_, false),
+      measure(yee_forward_button_, false),
+      measure(yee_reload_button_, false),
+      measure(active ? &native_location_bar : nullptr, true),
+      measure(close_button_, false)};
+  return result;
+}
