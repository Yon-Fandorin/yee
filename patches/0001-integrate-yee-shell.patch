+class BrowserView::ScopedYeeBrowserSurfaceStructureUpdate {
+ public:
+  explicit ScopedYeeBrowserSurfaceStructureUpdate(BrowserView& browser_view)
+      : browser_view_(browser_view) {
+    browser_view_->BeginYeeBrowserSurfaceStructureUpdate();
+  }
+
+  ScopedYeeBrowserSurfaceStructureUpdate(
+      const ScopedYeeBrowserSurfaceStructureUpdate&) = delete;
+  ScopedYeeBrowserSurfaceStructureUpdate& operator=(
+      const ScopedYeeBrowserSurfaceStructureUpdate&) = delete;
+
+  ~ScopedYeeBrowserSurfaceStructureUpdate() {
+    browser_view_->EndYeeBrowserSurfaceStructureUpdate();
+  }
+
+ private:
+  const raw_ref<BrowserView> browser_view_;
+};
+
+void BrowserView::BeginYeeBrowserSurfaceStructureUpdate() {
+  if (yee_browser_surface_structure_update_depth_++ == 0) {
+    yee_browser_surface_transition_from_ = GetYeeHeaderPresentationColor();
+    if (multi_contents_view_) {
+      multi_contents_view_->SetYeePresentationUpdatesSuspended(true);
+    }
+  }
+}
+
+void BrowserView::EndYeeBrowserSurfaceStructureUpdate() {
+  CHECK_GT(yee_browser_surface_structure_update_depth_, 0);
+  if (--yee_browser_surface_structure_update_depth_ != 0) {
+    return;
+  }
+  if (multi_contents_view_) {
+    multi_contents_view_->SetYeePresentationUpdatesSuspended(false);
+  }
+  PrepareYeeInfoBarFlow();
+  BindYeeHeaderPresentationSource(
+      multi_contents_view_
+          ? multi_contents_view_->GetActiveContentsContainerView()
+          : nullptr,
+      yee_animate_next_active_binding_from_current_);
+  yee_animate_next_active_binding_from_current_ = false;
+  yee_browser_surface_transition_from_.reset();
+  yee_header_update_pending_ = false;
+  UpdateYeeBrowserSurfacePresentation();
+  if (yee_infobar_layout_pending_) {
+    const bool is_animating = yee_infobar_layout_pending_animated_;
+    yee_infobar_layout_pending_ = false;
+    yee_infobar_layout_pending_animated_ = false;
+    ToolbarSizeChanged(is_animating);
+  }
+}
+
+void BrowserView::PrepareYeeInfoBarFlow() {
+  if (!UsesYeeBrowserSurfaceGeometry() || !infobar_container_ ||
+      !multi_contents_view_) {
+    return;
+  }
+  const InfoBarFlowMetrics metrics =
+      infobar_container_->GetFlowMetricsForLayout();
+  content::WebContents* const manager_contents =
+      infobar_container_->GetWebContentsForLayout();
+  bool visible = !infobar_container_->IsEmpty();
+  if (visible && GetWidget() && GetWidget()->IsFullscreen()) {
+    visible = !infobar_container_->ShouldHideInFullscreen();
+  }
+  multi_contents_view_->PrepareExternalInfoBarFlow(
+      manager_contents ? manager_contents->GetWeakPtr() : nullptr,
+      visible ? metrics.semantic_stack_height : 0,
+      visible ? metrics.rigid_control_min_width : 0,
+      visible ? metrics.visible_bar_count : 0, metrics.animation_generation);
+}
