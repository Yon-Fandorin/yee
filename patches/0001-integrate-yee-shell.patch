+IN_PROC_BROWSER_TEST_F(BrowserViewTabbedLayoutImplUiTest,
+                       YeeSidebarFlyoutKeepsExpandedControlsAndPageBounds) {
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
