+}
+
+void InfoBarContainerView::SetPresentationForLayout(
+    const InfoBarContainerPresentation& presentation) {
+  if (presentation_ == presentation) {
+    return;
+  }
+  presentation_ = presentation;
+  static_cast<ContentShadow*>(content_shadow_.get())
+      ->SetContainHorizontalShadow(presentation_.contain_horizontal_shadow);
+  SetBackground(
+      presentation_.top_corner_radius > 0.0f
+          ? views::CreateRoundedRectBackground(
+                kColorInfoBarContentAreaSeparator,
+                gfx::RoundedCornersF(presentation_.top_corner_radius,
+                                     presentation_.top_corner_radius, 0.0f,
+                                     0.0f))
+          : views::CreateSolidBackground(kColorInfoBarContentAreaSeparator));
+  UpdateBarCornerRadii();
+  SchedulePaint();
+}
+
+void InfoBarContainerView::UpdateBarCornerRadii() {
+  bool has_positive_height_bar = false;
+  for (auto child = children().begin(); child != std::prev(children().end());
+       ++child) {
+    auto* const infobar_view = static_cast<InfoBarView*>(*child);
+    const int height = infobar_view->computed_height();
+    const float top_corner_radius =
+        height > 0 && !has_positive_height_bar
+            ? std::min(presentation_.top_corner_radius, height / 2.0f)
+            : 0.0f;
+    infobar_view->layer()->SetRoundedCornerRadius(
+        gfx::RoundedCornersF(top_corner_radius, top_corner_radius, 0.0f, 0.0f));
+    has_positive_height_bar |= height > 0;
+  }
+}
