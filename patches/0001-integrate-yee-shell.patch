+      tabs::VerticalTabStripStateController::From(browser_);
+  CHECK(vertical_tabs_controller);
+  auto sidebar_button = yee::CreateShellToolbarButton(base::BindRepeating(
+      &ToolbarView::ToggleCompactShellSidebar, base::Unretained(this)));
+  sidebar_button->SetVectorIcon(kDockToLeftIcon);
+  // Yee rehosts Chromium's vertical-tab collapse action in the Browser
+  // Surface Header. Preserve the native element contract so interaction
+  // tests, user education, and accessibility automation follow the visible
+  // control instead of waiting on the hidden stock top-container button.
+  sidebar_button->SetProperty(views::kElementIdentifierKey,
+                              kVerticalTabStripCollapseButtonElementId);
+
+  auto shell_column_spacer = std::make_unique<views::View>();
+  shell_column_spacer->SetCanProcessEventsWithinSubtree(false);
+  shell_column_spacer->SetProperty(views::kMarginsKey, gfx::Insets());
+  compact_shell_column_spacer_ =
+      AddChildViewAt(std::move(shell_column_spacer), 0);
+  compact_shell_sidebar_button_ = AddChildViewAt(std::move(sidebar_button), 1);
+  compact_shell_sidebar_subscription_ =
+      vertical_tabs_controller->RegisterOnCollapseChanged(
+          base::BindRepeating(&ToolbarView::UpdateCompactShellSidebarButton,
+                              base::Unretained(this)));
+  UpdateCompactShellSidebarButton(vertical_tabs_controller->GetCollapseState());
+
+  CHECK(location_bar_view_);
+  const size_t location_bar_index = GetIndexOf(location_bar_view_).value();
+  compact_shell_leading_divider_ =
+      AddChildViewAt(std::make_unique<ToolbarDivider>(), location_bar_index);
+  compact_shell_leading_divider_->SetVisible(false);
+
+  if (forward_) {
+    forward_->SetVisible(true);
+  }
+  if (home_) {
+    home_->SetVisible(false);
+  }
+  if (split_tabs_) {
+    split_tabs_->SetVisible(false);
+  }
+  if (glic_actor_button_container_) {
+    glic_actor_button_container_->SetVisible(false);
+  }
+  if (glic_button_) {
+    glic_button_->SetVisible(false);
+  }
+  if (glic_button_divider_) {
+    glic_button_divider_->SetVisible(false);
+  }
+  if (pinned_toolbar_actions_container_) {
+    pinned_toolbar_actions_container_->SetVisible(false);
+  }
+  if (battery_saver_button_) {
+    battery_saver_button_->SetVisible(false);
+  }
+  if (performance_intervention_button_) {
+    performance_intervention_button_->SetVisible(false);
+  }
+  if (avatar_) {
+    avatar_->SetVisible(false);
+  }
+  if (overflow_button_) {
+    overflow_button_->SetVisible(false);
+  }
+  if (app_menu_button_) {
+    app_menu_button_->SetVisible(false);
+  }
+  if (toolbar_divider_) {
+    toolbar_divider_->SetVisible(false);
+  }
+  location_bar_view_->ConfigureForCompactShell();
+  location_bar_view_->SetProperty(
+      views::kFlexBehaviorKey, CreateLocationBarFlexSpecification(
+                                   /*constrain_cross_axis_to_preferred=*/true));
+
+  yee::ApplyShellControlStyle(*compact_shell_sidebar_button_);
+  if (back_) {
+    yee::ApplyShellControlStyle(*back_);
+    static_cast<BackForwardButton*>(back_)->SetClickAnimationEnabled(false);
+  }
+  if (forward_) {
+    yee::ApplyShellControlStyle(*forward_);
+    static_cast<BackForwardButton*>(forward_)->SetClickAnimationEnabled(false);
+  }
+  if (reload_) {
+    yee::ApplyShellControlStyle(*reload_);
+  }
+  if (extensions_container_) {
+    yee::ApplyShellControlStyle(*extensions_container_->GetExtensionsButton());
+  }
+  compact_shell_leading_divider_->SetProperty(views::kMarginsKey,
+                                              gfx::Insets::VH(0, 7));
+  UpdateCompactShellLocationBarMargins();
+  if (extensions_container_) {
+    extensions_container_->SetProperty(
+        views::kMarginsKey,
+        gfx::Insets::VH(
+            0, yee::kSidebarMetrics.toolbar_extension_container_margin));
+  }
+
+  InvalidateLayout();
+  SchedulePaint();
+}
+
+void ToolbarView::ToggleCompactShellSidebar(const ui::Event& event) {
+  chrome::ExecuteCommandWithDisposition(
+      browser_, IDC_TOGGLE_VERTICAL_TABS_COLLAPSE,
+      ui::DispositionFromEventFlags(event.flags()));
+}
+
+void ToolbarView::SetCompactShellHeaderBoundsForLayout(
+    std::optional<gfx::Rect> header_bounds) {
+  if (compact_shell_header_bounds_ == header_bounds) {
+    return;
+  }
+  compact_shell_header_bounds_ = std::move(header_bounds);
+
+  // BrowserView's outer Toolbar bounds normally stay fixed while the pinned
+  // Sidebar animates. Mark this child layout dirty explicitly so the column
+  // spacer consumes the new current-frame Header edge even when SetBoundsRect
+  // has no reason to lay the Toolbar out again. The snapshot arrives while an
+  // ancestor layout is being calculated, so stop invalidation propagation at
+  // that active ancestor instead of scheduling a redundant BrowserView pass.
+  InvalidateLayout(/*avoid_propagate_during_layout=*/true);
+}
+
+void ToolbarView::UpdateCompactShellSidebarButton(
+    tabs::VerticalTabStripCollapseState state) {
+  CHECK(compact_shell_sidebar_button_);
+  const bool is_collapsed =
+      state != tabs::VerticalTabStripCollapseState::kExpanded;
+  const std::u16string sidebar_label = l10n_util::GetStringUTF16(
+      is_collapsed ? IDS_EXPAND_VERTICAL_TABS : IDS_COLLAPSE_VERTICAL_TABS);
+  compact_shell_sidebar_button_->SetTooltipText(sidebar_label);
+  compact_shell_sidebar_button_->GetViewAccessibility().SetName(sidebar_label);
+  InvalidateLayout();
+}
+
+void ToolbarView::SetCompactShellSurfacePresentation(
+    std::optional<yee::BrowserSurfacePresentation> presentation) {
+  if (!compact_shell_mode_ || !location_bar_view_) {
+    return;
+  }
+
+  if (presentation.has_value() &&
+      GetNativeTheme()->preferred_contrast() ==
+          ui::NativeTheme::PreferredContrast::kMore) {
+    presentation = yee::UseNativeBrowserSurfaceColors(*presentation);
+  }
+  location_bar_view_->SetCompactShellSurfacePresentation(presentation);
+
+  std::optional<SkColor> foreground;
+  std::optional<SkColor> disabled_foreground;
+  if (presentation.has_value() &&
+      presentation->palette_mode ==
+          yee::BrowserSurfacePresentation::PaletteMode::kCustomSurface) {
+    foreground = presentation->primary;
+    disabled_foreground = presentation->disabled;
+  }
+
+  const auto update_button = [&](ToolbarButton* button) {
+    if (button) {
+      button->SetForegroundColorOverrides(foreground, disabled_foreground);
+    }
+  };
+  update_button(compact_shell_sidebar_button_);
+  update_button(back_);
+  update_button(forward_);
+  update_button(reload_);
+  if (extensions_container_) {
+    update_button(extensions_container_->GetExtensionsButton());
+  }
+}
+
+void ToolbarView::SetCompactShellLocationBarHost(
+    ContentsContainerView* split_host,
+    std::optional<yee::BrowserSurfacePresentation> presentation) {
+  if (!compact_shell_mode_ || !location_bar_view_) {
+    return;
+  }
+
+  const bool in_split = split_host != nullptr;
+  const bool host_changed = compact_shell_location_bar_host_ != split_host;
+  if (host_changed) {
+    location_bar_view_->SetProperty(
+        views::kFlexBehaviorKey,
+        CreateLocationBarFlexSpecification(
+            /*constrain_cross_axis_to_preferred=*/true));
+
+    views::View* const location_bar_to_reparent = location_bar_view_;
+    if (compact_shell_location_bar_host_) {
+      CHECK_EQ(location_bar_to_reparent,
+               compact_shell_location_bar_host_
+                   ->ReleaseYeeSplitLocationBarForReparent());
+    } else {
+      CHECK_EQ(location_bar_view_->parent(), this);
+    }
+
+    compact_shell_location_bar_host_ = split_host;
+    if (split_host) {
+      split_host->AttachYeeSplitLocationBar(location_bar_to_reparent);
+    } else {
+      CHECK(compact_shell_leading_divider_);
+      const size_t location_bar_index =
+          GetIndexOf(compact_shell_leading_divider_).value() + 1;
+      AddChildViewAt(location_bar_to_reparent, location_bar_index);
+    }
+
+    location_bar_view_->SetCompactShellSplitMode(in_split);
+    compact_shell_sidebar_button_->SetVisible(!in_split);
+    back_->SetVisible(!in_split);
+    forward_->SetVisible(!in_split);
+    reload_->SetVisible(!in_split);
+    if (extensions_container_) {
+      if (in_split) {
+        // The split pane headers own their navigation controls, so suppress
+        // the top-level extension dock while the Omnibox is hosted in a pane.
+        extensions_container_->SetVisible(false);
+      } else {
+        // Chromium owns extension availability. In particular, an empty
+        // extension model must keep the dock hidden when leaving split view.
+        extensions_container_->UpdateContainerVisibility();
+      }
+    }
+    location_bar_view_->SetVisible(true);
+    InvalidateLayout();
+  }
+
+  // Apply the destination snapshot only after attach. The final parent then
+  // lays out once before popup anchors are synchronized for this generation.
+  SetCompactShellSurfacePresentation(std::move(presentation));
+  if (host_changed) {
+    CHECK(location_bar_view_->parent());
+    location_bar_view_->parent()->DeprecatedLayoutImmediately();
+    location_bar_view_->OnCompactShellLocationBarRehosted(
+        ++compact_shell_location_bar_rehost_generation_);
+  }
+}
+
+void ToolbarView::UpdateCompactShellLocationBarMargins() {
+  if (!compact_shell_mode_ || !location_bar_view_) {
+    return;
+  }
+
+  const int leading_margin = yee::kSidebarMetrics.location_bar_margin;
+  const int trailing_margin = yee::kSidebarMetrics.location_bar_margin;
+  location_bar_view_->SetProperty(
+      views::kMarginsKey,
+      base::i18n::IsRTL()
+          ? gfx::Insets::TLBR(0, trailing_margin, 0, leading_margin)
+          : gfx::Insets::TLBR(0, leading_margin, 0, trailing_margin));
+}
+
+void ToolbarView::UpdateCompactShellColumnSpacer() {
+  if (!compact_shell_mode_ || !compact_shell_column_spacer_) {
+    return;
+  }
+
+  int spacer_width = 0;
+  if (compact_shell_header_bounds_ &&
+      !compact_shell_header_bounds_->IsEmpty()) {
+    // Keep the Sidebar Header and pinned Tab Sidebar on one column boundary.
+    // Use the current proposed Header edge rather than the controller's
+    // discrete expanded/collapsed state. This keeps pinned collapse/expand
+    // motion continuous without letting an expand-on-hover flyout move the
+    // Browser Surface controls.
+    gfx::Point toolbar_origin;
+    views::View::ConvertPointToTarget(this, browser_view_, &toolbar_origin);
+    // Match the first control's visible edge to the Extensions control at the
+    // opposite side of the Browser Surface Header. Flex consumes the button's
+    // own one-DIP margin after the spacer, so remove it from the target here.
+    const int browser_toolbar_start =
+        compact_shell_header_bounds_->x() +
+        yee::kSidebarMetrics.browser_surface_header_control_edge_inset -
+        yee::kSidebarMetrics.shell_control_horizontal_margin;
+    const int shell_controls_span = yee::kSidebarMetrics.toolbar_interior_inset;
+    spacer_width = std::max(
+        0, browser_toolbar_start - toolbar_origin.x() - shell_controls_span);
+  }
+
+  const gfx::Size spacer_size(spacer_width, 1);
+  if (compact_shell_column_spacer_->GetPreferredSize() != spacer_size) {
+    compact_shell_column_spacer_->SetPreferredSize(spacer_size);
+  }
+}
