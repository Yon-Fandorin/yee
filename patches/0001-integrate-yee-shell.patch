+  const bool had_presentation = compact_shell_presentation_.has_value();
+  const bool has_presentation = presentation.has_value();
+  const bool presentation_changed =
+      had_presentation != has_presentation ||
+      (has_presentation &&
+       (compact_shell_presentation_->source_id != presentation->source_id ||
+        compact_shell_presentation_->revision != presentation->revision ||
+        compact_shell_presentation_->palette_mode !=
+            presentation->palette_mode));
+  const bool popup_policy_changed =
+      had_presentation != has_presentation ||
+      (has_presentation &&
+       (compact_shell_presentation_->source_id != presentation->source_id ||
+        compact_shell_presentation_->popup_revision !=
+            presentation->popup_revision ||
+        compact_shell_presentation_->palette_mode !=
+            presentation->palette_mode));
+  if (!presentation_changed && !popup_policy_changed) {
+    return;
+  }
+  compact_shell_presentation_ = std::move(presentation);
+  if (presentation_changed) {
+    RefreshCompactShellPresentation();
+  }
+  if (popup_policy_changed) {
+    if (omnibox_popup_view_) {
+      omnibox_popup_view_->RefreshCompactShellSurface();
+      if (auto* presenter = omnibox_popup_view_->presenter()) {
+        presenter->RefreshCompactShellSurface();
