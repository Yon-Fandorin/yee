+      browser_->GetType(), vertical_tab_strip_region_view_ != nullptr);
+}
+
+yee::BrowserSurfaceChromeState yee::ReadBrowserSurfaceChromeState(
+    BrowserView& browser_view) {
+  yee::BrowserSurfaceChromeState result;
+  result.toolbar_participates =
+      browser_view.IsToolbarVisible() &&
+      browser_view.top_container()->parent() == &browser_view;
+  result.sidebar_participates = browser_view.ShouldDrawVerticalTabStrip();
+  if (!browser_view.IsFullscreen()) {
+    return result;
+  }
+
+  auto* const manager = ExclusiveAccessManager::From(browser_view.browser());
+  result.content_fullscreen =
+      manager &&
+      manager->fullscreen_controller()->IsWindowFullscreenForTabOrPending();
+#if BUILDFLAG(IS_MAC)
+  const bool hide_top_ui =
+      fullscreen_utils::IsInContentFullscreen(browser_view.browser());
+  if (hide_top_ui) {
+    result.sidebar_participates = false;
+  }
+  if (fullscreen_utils::IsAlwaysShowToolbarEnabled(browser_view.browser()) &&
+      !hide_top_ui) {
+    result.stable_state =
+        yee::SurfaceGeometryStableState::kFullscreenWithToolbar;
+    return result;
+  }
+#endif
+
+  result.stable_state =
+      yee::SurfaceGeometryStableState::kFullscreenHiddenChrome;
+  result.toolbar_participates = false;
+  return result;
+}
