+void ApplyYeeNativeFeaturePolicy() {
+  base::ScopedAddFeatureFlags feature_flags(
+      base::CommandLine::ForCurrentProcess());
+  const auto disable = [&feature_flags](const base::Feature& feature) {
+    feature_flags.DisableIfNotSet(feature);
+  };
+
+  // Sidebar hover cards need tab thumbnails. macOS still ships the feature
+  // disabled, so turn it on unless the command line already chose.
+  feature_flags.EnableIfNotSet(features::kTabHoverCardImages);
+
+#if BUILDFLAG(IS_MAC)
+  // Native glass is a Yee product default on supported macOS versions. Keep
+  // it in compiled startup policy so Finder, Dock, tests, and run.sh all get
+  // the same shell without launcher-specific appearance flags.
+  feature_flags.EnableIfNotSet(features::kGlassFrame);
+#endif
+
+  // Yee owns the browser toolbar as one native Views surface. Keep all of its
+  // controls on the same implementation unless a developer explicitly opts
+  // into a WebUI toolbar feature on the command line.
+  disable(features::kWebUIToolbarProcessOverheadExperiment);
+  disable(features::kWebUIToolbar);
+  disable(features::kWebUIReloadButton);
+  disable(features::kWebUIHomeButton);
+  disable(features::kWebUIBatterySaverButton);
+  disable(features::kWebUIPerformanceInterventionButton);
+  disable(features::kWebUIAppMenuButton);
