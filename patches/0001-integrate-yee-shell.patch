+                           focus_manager->GetFocusedView()));
+    EXPECT_EQ(1, multi_contents_view->GetActiveIndex());
+
+    focus_manager->AdvanceFocus(/*reverse=*/true);
+    ASSERT_TRUE(
+        is_within(second->mini_toolbar(), focus_manager->GetFocusedView()));
