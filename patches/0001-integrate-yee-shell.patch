+    // 실제 Header의 최소 폭에 목록 양쪽 inset을 더해 Sidebar가 가리지 않게
+    // 한다.
+    for (const auto& id : tab_strip_model()->group_model()->ListTabGroups()) {
+      if (const auto* header = GetGroupHeaderView(id)) {
+        minimum = std::max(
+            minimum,
+            header->GetMinimumSize().width() +
+                2 * GetLayoutConstant(
+                        LayoutConstant::kVerticalTabStripHorizontalPadding));
+      }
+    }
+  }
+#endif
+  return minimum;
