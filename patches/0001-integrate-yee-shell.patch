+yee::BrowserSurfacePresentationBinding*
+BrowserFrameViewWin::GetCaptionPresentationBinding() const {
+  if (!GetBrowserView() || caption_button_container_->bounds().IsEmpty() ||
+      !GetBrowserView()->multi_contents_view() ||
+      CaptionControlsOverlapSidePanel()) {
+    return nullptr;
+  }
+  if (!GetBrowserView()->IsInSplitView()) {
+    auto* const container = GetBrowserView()->GetActiveContentsContainerView();
