+    const gfx::RoundedCornersF& radii,
+    ContentsWebView::RoundedCornerClipMode clip_mode) {
+  web_view->holder()->SetNativeViewCornerRadii(radii);
+  if (clip_mode == ContentsWebView::RoundedCornerClipMode::kSubtree &&
+      web_view->holder()->layer()) {
+    // Platform NativeViewHost implementations choose the fast rounded-corner
+    // path. Yee's inset surfaces need the host to mask renderer descendants,
+    // notably overlay scrollbars, at both normal and split card boundaries.
+    // Native surface 연결 전에는 host에 Views layer가 없을 수 있다.
+    web_view->holder()->layer()->SetIsFastRoundedCorner(false);
+    web_view->holder()->layer()->SetMasksToBounds(!radii.IsEmpty());
+  }
+}
+
+void SetYeeContentOverlayCornerRadii(views::View* overlay,
+                                     const gfx::RoundedCornersF& radii,
+                                     bool uses_yee_geometry) {
+  if (!uses_yee_geometry || !overlay || !overlay->layer()) {
+    return;
+  }
+  overlay->layer()->SetRoundedCornerRadius(radii);
+  overlay->layer()->SetIsFastRoundedCorner(false);
+  overlay->layer()->SetMasksToBounds(!radii.IsEmpty());
+}
+
+bool SetViewLayerClipRect(views::View* view, const gfx::Rect& local_clip_rect) {
+  if (!view || !view->layer() ||
+      view->layer()->clip_rect() == local_clip_rect) {
+    return false;
+  }
+  view->layer()->SetClipRect(local_clip_rect);
+  view->SchedulePaint();
+  return true;
+}
+
+void ApplyViewLocalClip(views::View* view, const gfx::Rect& local_clip_rect) {
+  if (!view) {
+    return;
+  }
+  SetViewLayerClipRect(view, local_clip_rect);
+}
+
+void ApplyWebViewLocalClip(views::WebView* web_view,
+                           const gfx::Rect& local_clip_rect) {
+  if (!web_view) {
+    return;
+  }
+  const bool native_clip_changed =
+      web_view->holder()->SetNativeViewClipRect(local_clip_rect);
+  const bool layer_clip_changed =
+      SetViewLayerClipRect(web_view, local_clip_rect);
+  if (native_clip_changed && !layer_clip_changed) {
+    web_view->SchedulePaint();
+  }
+}
+
+void ApplyDirectViewClip(views::View* view,
+                         const gfx::Rect& visible_bounds_in_container) {
+  if (!view) {
+    return;
+  }
+  const gfx::Rect local_clip = yee::ResolveDirectChildClipInLocalSpace(
+      view->bounds(), visible_bounds_in_container);
+  ApplyViewLocalClip(view, local_clip);
+}
+
+void ApplyDirectWebViewClip(views::WebView* web_view,
+                            const gfx::Rect& visible_bounds_in_container) {
+  if (!web_view) {
+    return;
+  }
+  const gfx::Rect local_clip = yee::ResolveDirectChildClipInLocalSpace(
+      web_view->bounds(), visible_bounds_in_container);
+  ApplyWebViewLocalClip(web_view, local_clip);
+}
+
+views::View* ResolvePageViewportChildParent(
+    views::View* contents_container,
+    views::View* page_viewport_clip_host,
+    yee::PageViewportChildFamily family) {
+  CHECK(contents_container);
+  if (!page_viewport_clip_host) {
+    return contents_container;
+  }
+
+  const yee::PageViewportChildPolicy policy =
+      yee::GetPageViewportChildPolicy(family);
+  CHECK_EQ(policy.status, yee::PageViewportMigrationStatus::kApproved);
+  switch (policy.host) {
+    case yee::PageViewportChildHost::kPageTargetHost:
+      return &yee::GetPageTargetHost(*page_viewport_clip_host);
+    case yee::PageViewportChildHost::kViewportOverlayHost:
+      return &yee::GetViewportOverlayHost(*page_viewport_clip_host);
+    case yee::PageViewportChildHost::kContentsContainer:
+      NOTREACHED();
+  }
+}
+
+gfx::Rect CalculateAiOverlayBounds(views::WebView* ai_overlay_dialog_view,
+                                   gfx::Rect parent_bounds,
+                                   bool clamp_to_parent) {
+  CHECK(ai_overlay_dialog_view);
+  gfx::Size size = ai_overlay_dialog_view->GetPreferredSize();
+  if (size.IsEmpty()) {
+    int dialog_width = 200;
+    int dialog_height = 200;
+    if (!features::kAiOverlayDialogMockJsonPath.Get().empty()) {
+      // 150px (buttons) + 20px (gap) + 100px (persona) = 270px
+      dialog_width = 270;
+      // 200px (max height of column)
+      dialog_height = 200;
+    }
+    size = gfx::Size(dialog_width, dialog_height);
+  }
+
+  constexpr int kXMargin = 15;
+  if (clamp_to_parent) {
+    size.SetToMin(parent_bounds.size());
+  }
+  const gfx::Point top_left =
+      parent_bounds.bottom_right() -
+      gfx::Vector2d(size.width() + kXMargin, size.height());
+  gfx::Rect bounds(top_left, size);
+  if (clamp_to_parent) {
+    bounds.AdjustToFit(parent_bounds);
+  }
+  return bounds;
+}
