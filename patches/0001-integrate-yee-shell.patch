+// The WebUI Omnibox popup owns a different Widget from the browser window.
+// Give that Widget the same page-aware palette as Yee's native Omnibox so its
+// WebContents and native frame resolve one presentation contract.
+class OmniboxPopupPresenterWidget final : public ThemeCopyingWidget {
+ public:
+  OmniboxPopupPresenterWidget(
+      views::Widget* role_model,
+      std::optional<yee::BrowserSurfacePresentation> compact_shell_presentation)
+      : ThemeCopyingWidget(role_model),
+        compact_shell_presentation_(std::move(compact_shell_presentation)) {
+    RebuildCompactShellColorProvider();
+  }
+
+  void SetCompactShellPresentation(
+      std::optional<yee::BrowserSurfacePresentation> presentation) {
+    if (compact_shell_presentation_ == presentation) {
+      return;
+    }
+    compact_shell_presentation_ = std::move(presentation);
+    RebuildCompactShellColorProvider();
+    ThemeChanged();
+  }
+
+  const ui::ColorProvider* GetColorProvider() const override {
+    return compact_shell_color_provider_
+               ? compact_shell_color_provider_.get()
+               : ThemeCopyingWidget::GetColorProvider();
+  }
+
+  ui::RendererColorMap GetRendererColorMap(
+      ui::ColorProviderKey::ColorMode color_mode,
+      ui::ColorProviderKey::ForcedColors forced_colors) const override {
+    if (!compact_shell_presentation_.has_value()) {
+      return ThemeCopyingWidget::GetRendererColorMap(color_mode, forced_colors);
+    }
+    ui::ColorProviderKey key = ThemeCopyingWidget::GetColorProviderKey();
+    key.color_mode = color_mode;
+    key.forced_colors = forced_colors;
+    std::unique_ptr<ui::ColorProvider> provider =
+        yee::CreateBrowserSurfaceOmniboxPopupColorProvider(
+            std::move(key), compact_shell_presentation_);
+    return ui::CreateRendererColorMap(*provider);
+  }
+
+  void OnWidgetThemeChanged(views::Widget* widget) override {
+    RebuildCompactShellColorProvider();
+    ThemeCopyingWidget::OnWidgetThemeChanged(widget);
+  }
+
+  int compact_shell_provider_rebuild_count_for_testing() const {
+    return compact_shell_provider_rebuild_count_;
+  }
+
+ private:
+  void RebuildCompactShellColorProvider() {
+    ++compact_shell_provider_rebuild_count_;
+    compact_shell_color_provider_ =
+        compact_shell_presentation_.has_value()
+            ? yee::CreateBrowserSurfaceOmniboxPopupColorProvider(
+                  ThemeCopyingWidget::GetColorProviderKey(),
+                  compact_shell_presentation_)
+            : nullptr;
+  }
+
+  std::optional<yee::BrowserSurfacePresentation> compact_shell_presentation_;
+  std::unique_ptr<ui::ColorProvider> compact_shell_color_provider_;
+  int compact_shell_provider_rebuild_count_ = 0;
+};
