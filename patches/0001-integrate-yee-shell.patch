+void MultiContentsViewDelegateImpl::ToggleSplitLayout() {
+  const std::optional<split_tabs::SplitTabId> split_tab_id =
+      tab_strip_model_->GetActiveTab()->GetSplit();
+  CHECK(split_tab_id.has_value());
+
+  const split_tabs::SplitTabLayout current_layout =
+      tab_strip_model_->GetSplitData(*split_tab_id)
+          ->visual_data()
+          ->split_layout();
+  const split_tabs::SplitTabLayout new_layout =
+      current_layout == split_tabs::SplitTabLayout::kSideBySide
+          ? split_tabs::SplitTabLayout::kStacked
+          : split_tabs::SplitTabLayout::kSideBySide;
+  tab_strip_model_->UpdateSplitLayout(
+      *split_tab_id, new_layout,
+      split_tabs::SplitTabOrientationChangeSource::kToolbarButton);
+  tab_strip_model_->UpdateSplitRatio(*split_tab_id, 0.5);
+}
+
+void MultiContentsViewDelegateImpl::ExitSplit() {
+  const std::optional<split_tabs::SplitTabId> split_tab_id =
+      tab_strip_model_->GetActiveTab()->GetSplit();
+  CHECK(split_tab_id.has_value());
+  tab_strip_model_->RemoveSplit(*split_tab_id);
+}
