+void MultiContentsViewMiniToolbar::MaybeAddYeeSidebarButton() {
+  // MultiContentsView is shared by normal, popup, app, and DevTools windows,
+  // while Chromium only owns vertical-tab state for supported normal windows.
+  // Treat the controller as the capability token so unsupported windows keep
+  // the common Pane Header without exposing an unusable Sidebar command.
+  auto* const vertical_tabs_controller =
+      tabs::VerticalTabStripStateController::From(browser_view_->browser());
+  if (!vertical_tabs_controller) {
+    return;
+  }
+
+  yee_sidebar_button_ = AddChildView(yee::CreateShellToolbarButton(
+      base::BindRepeating(&MultiContentsViewMiniToolbar::ToggleYeeSidebar,
+                          base::Unretained(this))));
+  yee_sidebar_button_->SetVectorIcon(kDockToLeftIcon);
+  // The active Pane Header replaces ToolbarView as the visible host for this
+  // native action. Keep the same semantic identifier across that rehost; the
+  // inactive pane keeps its copy hidden, so only one anchor is shown.
+  yee_sidebar_button_->SetProperty(views::kElementIdentifierKey,
+                                   kVerticalTabStripCollapseButtonElementId);
+  yee_sidebar_subscription_ =
+      vertical_tabs_controller->RegisterOnCollapseChanged(base::BindRepeating(
+          &MultiContentsViewMiniToolbar::UpdateYeeSidebarButton,
+          base::Unretained(this)));
+  yee_sidebar_mode_subscription_ =
+      vertical_tabs_controller->RegisterOnModeChanged(base::BindRepeating(
+          [](MultiContentsViewMiniToolbar* toolbar,
+             tabs::VerticalTabStripStateController* controller) {
+            toolbar->UpdateYeeSidebarButton(controller->GetCollapseState());
+          },
+          base::Unretained(this)));
+  UpdateYeeSidebarButton(vertical_tabs_controller->GetCollapseState());
+}
+
+void MultiContentsViewMiniToolbar::ToggleYeeSidebar() {
+  const auto* const controller =
+      tabs::VerticalTabStripStateController::From(browser_view_->browser());
+  chrome::ExecuteCommand(browser_view_->browser(),
+                         controller && !controller->ShouldDisplayVerticalTabs()
+                             ? IDC_TOGGLE_VERTICAL_TABS
+                             : IDC_TOGGLE_VERTICAL_TABS_COLLAPSE);
+}
+
+void MultiContentsViewMiniToolbar::UpdateYeeSidebarButton(
+    tabs::VerticalTabStripCollapseState state) {
+  CHECK(yee_sidebar_button_);
+  const auto* const controller =
+      tabs::VerticalTabStripStateController::From(browser_view_->browser());
+  const bool is_collapsed =
+      state != tabs::VerticalTabStripCollapseState::kExpanded;
+  const std::u16string label = l10n_util::GetStringUTF16(
+      controller && !controller->ShouldDisplayVerticalTabs()
+          ? IDS_SWITCH_TO_VERTICAL_TAB
+          : (is_collapsed ? IDS_EXPAND_VERTICAL_TABS
+                          : IDS_COLLAPSE_VERTICAL_TABS));
+  yee_sidebar_button_->SetTooltipText(label);
+  yee_sidebar_button_->GetViewAccessibility().SetName(label);
+}
