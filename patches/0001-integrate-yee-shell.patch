+IN_PROC_BROWSER_TEST_P(MultiContentsViewUiTest,
+                       YeeSidebarFooterPersistsAcrossSplitAndCollapse) {
+  ASSERT_TRUE(yee::IsShellEnabled());
+  views::View* original_footer = nullptr;
+  auto footer_matches = [this, &original_footer](bool visible) {
+    auto* region = BrowserView::GetBrowserViewForBrowser(browser())
+                       ->vertical_tab_strip_region_view_for_testing();
+    views::View* footer = region->sidebar_footer_for_testing();
+    if (!footer || footer->GetID() != yee::kSidebarFooterViewId ||
+        footer->parent() != region || footer->GetVisible() != visible) {
+      return false;
+    }
+    int footer_count = 0;
+    for (views::View* child : region->children()) {
+      footer_count += child->GetID() == yee::kSidebarFooterViewId;
+    }
+    const std::optional<size_t> footer_index = region->GetIndexOf(footer);
+    const std::optional<size_t> tab_strip_index =
+        region->GetIndexOf(region->GetTabStripView());
+    if (footer_count != 1 || !footer_index || !tab_strip_index ||
+        *footer_index <= *tab_strip_index) {
+      return false;
+    }
+    if (!original_footer) {
+      original_footer = footer;
+    }
+    return footer == original_footer;
+  };
+
+  RunTestSequence(
+      Check([&]() { return footer_matches(true); }),
+      CreateTabsAndEnterSplitView(), WaitForActiveTabChange(0),
+      Check([&]() { return footer_matches(true); }), Do([&]() {
+        tabs::VerticalTabStripStateController::From(browser())->RequestCollapse(
+            true);
+      }),
+      WaitForEvent(kTabStripRegionElementId,
+                   VerticalTabStripRegionView::kAnimationCompletedEvent),
+      Check([&]() { return footer_matches(false); }), Do([&]() {
+        tabs::VerticalTabStripStateController::From(browser())->RequestCollapse(
+            false);
+      }),
+      WaitForEvent(kTabStripRegionElementId,
+                   VerticalTabStripRegionView::kAnimationCompletedEvent),
+      Check([&]() { return footer_matches(true); }));
+}
