+
+void MultiContentsView::PrepareExternalInfoBarFlow(
+    base::WeakPtr<content::WebContents> manager_contents,
+    int semantic_stack_height,
+    int rigid_control_min_width,
+    size_t visible_bar_count,
+    uint64_t source_generation) {
+  if (manager_contents.get() == external_infobar_flow_.manager_contents.get() &&
+      source_generation < external_infobar_flow_.source_generation) {
+    return;
+  }
+
+  const int resolved_height = std::max(0, semantic_stack_height);
+  const int resolved_width = std::max(0, rigid_control_min_width);
+  const bool changed =
+      manager_contents.get() != external_infobar_flow_.manager_contents.get() ||
+      resolved_height != external_infobar_flow_.semantic_stack_height ||
+      resolved_width != external_infobar_flow_.rigid_control_min_width ||
+      visible_bar_count != external_infobar_flow_.visible_bar_count ||
+      source_generation != external_infobar_flow_.source_generation ||
+      pane_map_generation_ != external_infobar_flow_.pane_map_generation;
+  external_infobar_flow_.manager_contents = std::move(manager_contents);
+  external_infobar_flow_.semantic_stack_height = resolved_height;
+  external_infobar_flow_.rigid_control_min_width = resolved_width;
+  external_infobar_flow_.visible_bar_count = visible_bar_count;
+  external_infobar_flow_.source_generation = source_generation;
+  external_infobar_flow_.pane_map_generation = pane_map_generation_;
+  if (changed) {
+    ++external_infobar_flow_.generation;
+  }
+  ApplyPreparedExternalInfoBarFlow();
+}
+
+void MultiContentsView::ApplyPreparedExternalInfoBarFlow() {
+  const yee::ExternalInfoBarFlowPlan plan =
+      yee::ResolveExternalInfoBarFlowPlan(yee::ExternalInfoBarFlowPlanInput{
+          reinterpret_cast<uintptr_t>(
+              external_infobar_flow_.manager_contents.get()),
+          {reinterpret_cast<uintptr_t>(
+               contents_container_views_[0]->contents_view()->web_contents()),
+           reinterpret_cast<uintptr_t>(
+               contents_container_views_[1]->contents_view()->web_contents())},
+          {contents_container_views_[0]->GetVisible(),
+           contents_container_views_[1]->GetVisible()},
+          external_infobar_flow_.semantic_stack_height,
+          external_infobar_flow_.generation,
+          external_infobar_flow_.generation});
+  for (int index = 0; index < 2; ++index) {
+    contents_container_views_[index]->SetExternalInfoBarHeight(
+        plan.pane_reservations[index]);
+  }
+}
+
+void MultiContentsView::OnContentsPaneMapChanged() {
+  ++pane_map_generation_;
+  external_infobar_flow_.pane_map_generation = pane_map_generation_;
+  ++external_infobar_flow_.generation;
+  ApplyPreparedExternalInfoBarFlow();
+}
