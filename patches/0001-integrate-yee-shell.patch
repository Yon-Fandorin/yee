diff --git a/chrome/browser/ui/views/frame/layout/browser_view_tabbed_layout_native_geometry.cc b/chrome/browser/ui/views/frame/layout/browser_view_tabbed_layout_native_geometry.cc
new file mode 100644
index 0000000000..2beb6bd37c
--- /dev/null
+++ b/chrome/browser/ui/views/frame/layout/browser_view_tabbed_layout_native_geometry.cc
@@ -0,0 +1,477 @@
