+namespace browser_view_layout {
+
+// Plain current-frame inputs used by BrowserView's native horizontal planner.
+// These values are deliberately independent of Views so planning cannot read
+// partially applied bounds from the preceding frame.
+enum class NativeTabStripType { kNone, kVertical, kHorizontal };
+
+enum class NativeVerticalTabStripState {
+  kExpanded,
+  kCollapsing,
+  kCollapsed,
+  kExpanding,
+};
+
+enum class NativeSidePanelRowMode {
+  kNoPanel,
+  kTopAbovePanel,
+  kSharedRow,
+};
+
+enum class NativeSidePanelRowPolicy {
+  kAutomatic,
+  kTopAbovePanel,
+  kSharedRow,
+};
+
+struct NativeSeparatorState {
+  bool top_container_separator = false;
+  bool multi_contents_separator = false;
+  bool shadow_box = false;
+  bool adjust_for_missing_separator = false;
+  bool side_panel_top_padding = false;
+
+  bool operator==(const NativeSeparatorState&) const = default;
+};
+
+struct NativeHorizontalPlanInput {
+  BrowserLayoutParams browser_params;
+
+  // Allocation available after any shell-owned rail has been resolved. Side
+  // Panel and content widths are planned against this rectangle, not the raw
+  // browser width.
+  gfx::Rect content_column_bounds;
+
+  NativeTabStripType tab_strip_type = NativeTabStripType::kNone;
+  NativeVerticalTabStripState vertical_tab_strip_state =
+      NativeVerticalTabStripState::kExpanded;
+  // False when a shell has already removed the native vertical-tab rail from
+  // `content_column_bounds`.
+  bool vertical_tab_strip_inside_content_column = true;
+  BrowserViewLayoutDelegate::WindowState window_state =
+      BrowserViewLayoutDelegate::WindowState::kNormal;
+
+  bool split = false;
+  bool infobar_visible = false;
+  bool toolbar_visible = false;
+  bool bookmark_bar_visible = false;
+
+  int toolbar_minimum_width = 0;
+  int vertical_tab_strip_minimum_width = 0;
+  int vertical_tab_strip_preferred_width = 0;
+  int minimum_grab_handle_padding = 0;
+
+  bool side_panel_visible = false;
+  bool side_panel_content_type = false;
+  // shell은 Header를 모든 패널 위나 옆에 배치할 수 있다.
+  // Automatic은 native의 패널 종류·가용 폭에 따른 결정을 유지한다.
+  NativeSidePanelRowPolicy side_panel_row_policy =
+      NativeSidePanelRowPolicy::kAutomatic;
+  bool side_panel_restrict_max_width = false;
+  int side_panel_minimum_width = 0;
+  int side_panel_preferred_width = 0;
+  int side_panel_padding = 0;
+
+  int minimum_content_width = 0;
+  int separator_thickness = 0;
+};
+
+struct NativeHorizontalPlan {
+  BrowserLayoutParams revised_browser_params;
+  BrowserLayoutParams content_column_params;
+  NativeSidePanelRowMode row_mode = NativeSidePanelRowMode::kNoPanel;
+  NativeVerticalTabStripState vertical_tab_strip_state =
+      NativeVerticalTabStripState::kExpanded;
+  int vertical_tab_strip_width = 0;
+  int side_panel_width = 0;
+  int min_content_width = 0;
+  int side_panel_padding = 0;
+  bool split = false;
+  bool force_top_container_to_top_value = false;
+  NativeSeparatorState separator;
+
+  bool has_side_panel() const { return side_panel_width > 0; }
+  bool force_top_container_to_top() const {
+    return force_top_container_to_top_value;
+  }
+  bool top_container_shares_panel_row() const {
+    return row_mode == NativeSidePanelRowMode::kSharedRow;
+  }
+};
+
+NativeHorizontalPlan PlanNativeHorizontalLayout(
+    const NativeHorizontalPlanInput& input);
+
+struct NativeTopContainerChildLayout {
+  bool parented = false;
+  bool visible = false;
+  gfx::Rect bounds;
+
+  bool operator==(const NativeTopContainerChildLayout&) const = default;
+};
+
+struct NativeTopContainerLayoutInput {
+  BrowserLayoutParams params;
+  bool needs_exclusion = true;
+  NativeTabStripType tab_strip_type = NativeTabStripType::kNone;
+
+  bool horizontal_tab_strip_parented = false;
+  gfx::Size horizontal_tab_strip_minimum_size;
+  gfx::Size horizontal_tab_strip_preferred_size;
+  int horizontal_tab_strip_leading_margin = 0;
+  int tabstrip_toolbar_overlap = 0;
+
+  bool toolbar_parented = false;
+  bool toolbar_visible = false;
+  gfx::Size toolbar_minimum_size;
+  gfx::Size toolbar_preferred_size;
+  bool toolbar_uses_config = false;
+  gfx::Insets toolbar_insets;
+  int toolbar_height = 0;
+  int toolbar_reserved_height = 0;
+  int trailing_accessory_width = 0;
+
+  bool bookmark_bar_parented = false;
+  bool bookmark_bar_visible = false;
+  int bookmark_bar_preferred_height = 0;
+
+  bool separator_parented = false;
+  bool separator_visible = false;
+  int separator_preferred_height = 0;
+};
+
+struct NativeTopContainerLayout {
+  gfx::Rect bounds;
+  NativeTopContainerChildLayout horizontal_tab_strip;
+  NativeTopContainerChildLayout toolbar;
+  NativeTopContainerChildLayout bookmark_bar;
+  NativeTopContainerChildLayout separator;
+
+  bool operator==(const NativeTopContainerLayout&) const = default;
+};
+
+NativeTopContainerLayout CalculateNativeTopContainerLayout(
+    const NativeTopContainerLayoutInput& input);
+
+// 패널 노출과 내용 전환을 현재 프레임에서 한 번 캡처한다.
+// 시작 좌표는 이전 View 배치가 아니라 명시적인 애니메이션 상태다.
+struct NativeSidePanelAnimationInput {
+  double reveal = 0.0;
+  std::optional<gfx::Rect> content_starting_bounds;
+  gfx::Insets content_insets;
+  double content_progress = 0.0;
+};
+
+struct NativeSidePanelGeometryInput {
+  gfx::Rect available_bounds;
+  gfx::Rect unclipped_contents_region;
+
+  // Physical bounds within which the panel is allowed to paint. Logical
+  // alignment has already been resolved by the caller exactly once.
+  gfx::Rect panel_clip_bounds;
+
+  int target_width = 0;
+  int panel_padding = 0;
+  bool leading = false;
+  bool shadow_box = false;
+  bool side_panel_top_padding = false;
+  bool adjust_for_missing_separator = false;
+  int separator_thickness = 0;
+  bool animation_content_visible = false;
+  NativeSidePanelAnimationInput animation;
+};
+
+struct NativeSidePanelGeometry {
+  bool visible = false;
+  bool leading = false;
+  bool animating = false;
+  double reveal = 0.0;
+  int target_width = 0;
+  int visible_width = 0;
+
+  gfx::Rect current_bounds;
+  gfx::Rect final_bounds;
+  std::optional<gfx::Rect> animation_content_bounds;
+  std::optional<gfx::Rect> local_clip_bounds;
+
+  gfx::Insets shadow_insets;
+  gfx::Rect shadow_bounds;
+  gfx::Rect remaining_bounds;
+  gfx::Rect unclipped_contents_region;
+};
+
+NativeSidePanelGeometry ResolveNativeSidePanelGeometry(
+    const NativeSidePanelGeometryInput& input);
+
+struct NativeBodyAllocationInput {
+  gfx::Rect notice_flow_allocation;
+  gfx::Rect allowed_bounds;
+  gfx::Rect panel_visible_region;
+  int minimum_content_width = 0;
+};
+
+struct NativeBodyAllocation {
+  gfx::Rect notice_flow_allocation;
+  gfx::Rect body_allocation;
+  gfx::Rect body_occlusion_rect;
+  int underlap_deficit = 0;
+  bool has_contiguous_notice_flow = true;
+};
+
+NativeBodyAllocation ResolveNativeBodyAllocation(
+    const NativeBodyAllocationInput& input);
+
+gfx::Insets ResolveNativeSplitViewInsets(
+    bool split,
+    BrowserViewLayoutDelegate::WindowState window_state,
+    bool infobar_visible,
+    const NativeHorizontalPlan& horizontal_plan,
+    bool side_panel_leading,
+    double side_panel_reveal,
+    int default_inset);
