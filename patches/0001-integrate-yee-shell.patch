+class ContentsContainerView::YeePresentationOutlet {
+ public:
+  explicit YeePresentationOutlet(ContentsWebView* contents_view)
+      : contents_view_(contents_view) {
+    attached_subscription_ = contents_view_->AddWebContentsAttachedCallback(
+        base::BindRepeating(&YeePresentationOutlet::OnWebContentsAttached,
