+void TabDragHandlerImpl::InvalidateTabStripDragLayout() {
+  auto* strip = views::AsViewClass<TabStripView>(root_node_->view());
+  if (!strip) {
+    return;
+  }
+  if (auto* pinned = strip->GetPinnedTabsContainer()) {
+    pinned->InvalidateLayout();
+  }
+  if (auto* unpinned = strip->GetUnpinnedTabsContainer()) {
+    // A group owns a nested animating layout. Invalidating only the outer Tab
+    // list updates the group's host bounds but leaves its first incoming gap as
+    // the group's target layout. Retarget every visible group when the landing
+    // slot changes so the gap can follow the pointer within that group.
+    for (views::View* child : unpinned->children()) {
+      if (auto* group = views::AsViewClass<TabGroupView>(child)) {
+        group->InvalidateLayout();
+      }
+    }
+    unpinned->InvalidateLayout();
+  }
+}
