+
+void TabDragHandlerImpl::UpdateIncomingDropSlots(
+    const gfx::Point& point_in_screen) {
+  ClearIncomingDropSlots();
+  if (favorite_drop_ == FavoriteDrop::kNone ||
+      favorite_drop_ == FavoriteDrop::kRejected) {
+    return;
+  }
+  auto* strip = views::AsViewClass<TabStripView>(root_node_->view());
+  if (!strip) {
+    return;
+  }
+
+  if (favorite_drop_ == FavoriteDrop::kPin) {
+    if (auto* pinned = strip->GetPinnedTabsContainer()) {
+      // Use the model count for both preview geometry and the incoming slot.
+      // A removed TabView may remain visible while its exit animation runs;
+      // counting host children would make the painted tile and landing slot
+      // disagree during that interval.
+      const int count = tab_strip_model_->IndexOfFirstNonPinnedTab();
+      gfx::Size tile_size = drag_tile_size_;
+      if (tile_size.IsEmpty()) {
+        tile_size = yee::FavoritesTileSize(*pinned);
+      }
+      incoming_favorites_slot_ = yee::FavoritesInsertIndexForTile(
+          *pinned,
+          yee::FavoritesDraggedTileForDockInScreen(*pinned, point_in_screen,
+                                                   drag_grab_offset_, tile_size,
+                                                   count + 1),
+          count, /*reserve_incoming_slot=*/true);
+    }
+    return;
+  }
+
+  auto* unpinned = strip->GetUnpinnedTabsContainer();
+  if (!unpinned) {
+    return;
+  }
+  const views::ProposedLayout& target_layout =
+      unpinned->GetTargetLayoutForDrag();
+  const gfx::Rect dragged_row_in_unpinned = views::View::ConvertRectToTarget(
+      strip, unpinned,
+      yee::TabDragPreviewBoundsInTabStrip(*strip, point_in_screen,
+                                          /*tab_leading_inset=*/0,
+                                          drag_grab_offset_, drag_tile_size_));
+  const int dragged_row_top = dragged_row_in_unpinned.y();
+  const int dragged_row_center = dragged_row_in_unpinned.CenterPoint().y();
+  const int row_margin = yee::kSidebarMetrics.tab_row_margin;
+  int compact_child_y = 0;
+  int visible_index = 0;
+  for (const views::ChildLayout& child_layout : target_layout.child_layouts) {
+    if (!child_layout.visible) {
+      continue;
+    }
+    views::View* const child = child_layout.child_view;
+    if (auto* group = views::AsViewClass<TabGroupView>(child)) {
+      const views::ProposedLayout& group_layout =
+          group->GetTargetLayoutForDrag();
+      const views::ChildLayout* const header_layout =
+          group_layout.GetLayoutFor(group->group_header());
+      const std::vector<views::View*> group_children =
+          group->collection_node()
+              ? group->collection_node()->GetDirectChildren()
+              : std::vector<views::View*>();
+
+      // Reconstruct the group's compact bounds. Its target layout may already
+      // include the previous incoming gap; using that animated geometry as the
+      // next hit target makes the old slot sticky.
+      int compact_group_child_y =
+          header_layout ? header_layout->bounds.bottom() + row_margin : 0;
+      int compact_group_bottom =
+          header_layout ? header_layout->bounds.bottom() : 0;
+      std::vector<const views::ChildLayout*> visible_group_layouts;
+      for (views::View* grouped : group_children) {
+        const views::ChildLayout* const grouped_layout =
+            group_layout.GetLayoutFor(grouped);
+        if (!grouped_layout || !grouped_layout->visible) {
+          continue;
+        }
+        visible_group_layouts.push_back(grouped_layout);
+        if (!header_layout && compact_group_bottom == 0) {
+          compact_group_child_y = grouped_layout->bounds.y();
+        }
+        compact_group_bottom =
+            compact_group_child_y + grouped_layout->bounds.height();
+        compact_group_child_y = compact_group_bottom + row_margin;
+      }
+      const int compact_group_height =
+          std::max(compact_group_bottom,
+                   header_layout ? header_layout->bounds.bottom() : 0);
+      const int group_tabs_top =
+          compact_child_y +
+          (header_layout ? header_layout->bounds.bottom() + row_margin : 0);
+      if (!group->IsCollapsed() && dragged_row_center >= group_tabs_top &&
+          dragged_row_center < compact_child_y + compact_group_height) {
+        incoming_group_id_ = group->GetTabGroup().id();
+        int group_index = 0;
+        const int dragged_row_center_in_group =
+            dragged_row_center - compact_child_y;
+        // Hit-test the pointer-aligned row center against compact group
+        // geometry, not the animated target layout's child y positions. This
+        // gives every tab an upper-half "before" target and a lower-half
+        // "after" target, including the otherwise unreachable gap after the
+        // final tab. The target layout already contains the previous incoming
+        // gap, so feeding it back into the next hit test would also make that
+        // first gap sticky.
+        int compact_group_tab_y =
+            header_layout ? header_layout->bounds.bottom() + row_margin : 0;
+        for (const views::ChildLayout* grouped_layout : visible_group_layouts) {
+          if (!header_layout && group_index == 0) {
+            compact_group_tab_y = grouped_layout->bounds.y();
+          }
