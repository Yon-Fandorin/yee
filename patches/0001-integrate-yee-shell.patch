+
+void BrowserView::BindYeeHeaderPresentationSource(
+    ContentsContainerView* contents_container,
+    bool animate_from_current) {
+  if (!UsesYeeBrowserSurfaceGeometry()) {
+    return;
+  }
+  const std::optional<SkColor> current_surface =
+      yee_browser_surface_transition_from_.has_value()
+          ? yee_browser_surface_transition_from_
+          : GetYeeHeaderPresentationColor();
+  yee::BrowserSurfacePresentationBinding* const binding =
+      contents_container
+          ? contents_container->GetYeeBrowserSurfacePresentationBinding()
+          : nullptr;
+  if (yee_header_presentation_binding_ == binding) {
+    if (animate_from_current && yee_header_presentation_binding_) {
+      yee_header_presentation_binding_->ActivateFrom(current_surface);
+    }
+    return;
+  }
+
+  yee_header_presentation_subscription_ = {};
+  yee_header_presentation_binding_ = binding;
+  if (!yee_header_presentation_binding_) {
+    return;
+  }
+
+  yee_header_presentation_subscription_ =
+      yee_header_presentation_binding_->AddPresentationChangedCallback(
+          base::BindRepeating(&BrowserView::OnYeeHeaderPresentationChanged,
+                              weak_ptr_factory_.GetWeakPtr(),
+                              yee_header_presentation_binding_));
+  if (animate_from_current) {
+    yee_header_presentation_binding_->ActivateFrom(current_surface);
+  }
+}
+
+std::optional<SkColor> BrowserView::GetYeeHeaderPresentationColor() const {
+  const std::optional<yee::BrowserSurfacePresentation> presentation =
+      GetYeeHeaderPresentation();
+  return presentation.has_value()
+             ? std::optional<SkColor>(presentation->surface)
+             : std::nullopt;
+}
+
+std::optional<yee::BrowserSurfacePresentation>
+BrowserView::GetYeeHeaderPresentation() const {
+  if (auto hub = yee::projects::GetProjectHubSurfacePresentation(this))
+    return hub;
+  if (!yee_header_presentation_binding_ ||
+      !yee_header_presentation_binding_->GetPresentation().has_value()) {
+    return std::nullopt;
+  }
+  return *yee_header_presentation_binding_->GetPresentation();
+}
+
+void BrowserView::OnYeeHeaderPresentationChanged(
+    const yee::BrowserSurfacePresentationBinding* expected_binding) {
+  if (!yee_header_presentation_binding_ ||
+      yee_header_presentation_binding_ != expected_binding) {
+    return;
+  }
+  const auto& presentation =
+      yee_header_presentation_binding_->GetPresentation();
+  if (presentation.has_value() &&
+      presentation->source_id !=
+          yee_header_presentation_binding_->source_id()) {
+    return;
+  }
+  UpdateYeeHeaderPresentation();
+}
