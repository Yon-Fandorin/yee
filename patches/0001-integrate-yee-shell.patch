+int BrowserView::GetYeeLeadingWindowControlsSafeEdge() const {
+  const BrowserLayoutParams params = GetFrameView()->GetBrowserLayoutParams();
+  return params.visual_client_area.x() +
+         base::ClampCeil(params.leading_exclusion.ContentWithPadding().width());
+}
