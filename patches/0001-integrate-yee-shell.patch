+            header_layout ? header_layout->bounds.bottom() + row_margin : 0;
+        for (const views::ChildLayout* grouped_layout : visible_group_layouts) {
+          if (!header_layout && group_index == 0) {
+            compact_group_tab_y = grouped_layout->bounds.y();
