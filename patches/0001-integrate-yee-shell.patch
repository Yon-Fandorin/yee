+MultiContentsView::ResolveYeeHeaderLayout(
+    const yee::CurrentPaneGeometryInput& input,
+    std::optional<gfx::Point> prospective_origin) const {
+#if BUILDFLAG(IS_WIN)
+  if (uses_yee_browser_surface_geometry_ && IsInSplitView() &&
+      yee_header_layout_context_ && browser_view_->toolbar() &&
+      browser_view_->toolbar()->location_bar_view()) {
+    gfx::Rect canvas = input.available_space;
