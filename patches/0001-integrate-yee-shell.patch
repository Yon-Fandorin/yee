+
+void BrowserView::UpdateYeeHeaderPresentation() {
+  if (!initialized_ || !UsesYeeBrowserSurfaceGeometry()) {
+    return;
+  }
+  if (yee_browser_surface_structure_update_depth_ > 0) {
+    yee_header_update_pending_ = true;
+    return;
+  }
+
+  // This is the color-controller callback and can run once per animation
+  // frame. Keep it limited to Header paint state; native LocationBar
+  // reparenting and split outline state are updated only on structural events.
+  const std::optional<yee::BrowserSurfacePresentation> presentation =
+      GetYeeHeaderPresentation();
+  if (top_container_) {
+    yee::UpdateHorizontalTabHeaderBackground(*top_container_, presentation);
+  }
+  if (toolbar_ && toolbar_->location_bar_view()) {
+    toolbar_->SetCompactShellSurfacePresentation(presentation);
+  }
+  if (!ShouldDrawVerticalTabStrip() && horizontal_tab_strip_region_view_ &&
+      horizontal_tab_strip_region_view_->GetTabStripView()) {
+    yee::RefreshHorizontalTabColors(
+        *horizontal_tab_strip_region_view_->GetTabStripView());
+    horizontal_tab_strip_region_view_->SchedulePaint();
+  }
+  if (top_container_ && top_container_->parent() != this) {
+    yee::UpdateImmersiveHeaderPresentation(*top_container_->parent(), presentation);
+    top_container_->SchedulePaint();
+  }
+  SchedulePaint();
+  if (views::View* const surface_fill =
+          GetViewByID(yee::kBrowserSurfaceFillViewId)) {
+    yee::UpdateBrowserSurfaceFillView(*surface_fill, presentation);
+  }
+  if (views::View* const resize_gutter =
+          GetViewByID(yee::kSidePanelResizeGutterViewId)) {
+    yee::UpdateSidePanelResizeGutterPresentation(*resize_gutter, presentation);
+  }
+  if (views::View* const surface_outline =
+          GetViewByID(yee::kCombinedSurfaceOutlineViewId)) {
+    surface_outline->SchedulePaint();
+  }
+}
+
+void BrowserView::UpdateYeeSplitPresentation() {
+  if (!initialized_ || !UsesYeeBrowserSurfaceGeometry()) {
+    return;
+  }
+  if (yee_browser_surface_structure_update_depth_ > 0) {
+    yee_header_update_pending_ = true;
+    return;
+  }
+
+  // Chromium continues to own the one native LocationBar. Yee only selects
+  // whether its presentation host is the shared Browser Toolbar or the active
+  // Pane Header when split structure changes.
+  if (toolbar_ && toolbar_->location_bar_view() &&
+      yee_split_location_bar_hosting_enabled_) {
+    toolbar_->SetCompactShellLocationBarHost(
+        multi_contents_view_ && multi_contents_view_->IsInSplitView()
+            ? multi_contents_view_->GetActiveContentsContainerView()
+            : nullptr,
+        GetYeeHeaderPresentation());
+  }
+#if BUILDFLAG(IS_MAC)
+  if (IsFullscreen()) {
+    views::Widget* const anchor = GetWidgetForAnchoring();
+    multi_contents_view_->SetProperty(views::kWidgetForAnchoringKey,
+                                      anchor == GetWidget() ? nullptr : anchor);
+    GetFrameView()->UpdateFullscreenTopUI();
+  }
+#endif
+  if (views::View* const surface_outline =
+          GetViewByID(yee::kCombinedSurfaceOutlineViewId)) {
+    const bool split_presentation =
+        multi_contents_view_ && multi_contents_view_->IsInSplitView();
+    yee::UpdateCombinedSurfaceOutlineView(*surface_outline, split_presentation);
+    surface_outline->SchedulePaint();
+  }
+}
+
+void BrowserView::EnsureYeeBrowserSurfaceZOrder() {
+  if (!UsesYeeBrowserSurfaceGeometry()) {
+    return;
+  }
+  views::View* const surface_outline =
+      GetViewByID(yee::kCombinedSurfaceOutlineViewId);
+  if (!surface_outline) {
+    return;
+  }
+
+  // Side Panel 애니메이션 중 동적 content가 BrowserView 끝에 추가된다.
+  // 재부모화마다 Surface fill, Header, native page, InfoBar, panel/shadow,
+  // 이벤트를 받지 않는 Surface outline, resize gutter, find UI,
+  // 전체 창 scrim 순서를 복원한다.
+  ReorderChildView(surface_outline, children().size());
+  views::View* const resize_gutter =
+      GetViewByID(yee::kSidePanelResizeGutterViewId);
+  if (resize_gutter && resize_gutter->parent() == this) {
+    ReorderChildView(resize_gutter, children().size());
+  }
+  // 선택 탭의 native 아래 곡선이 Surface의 상단 윤곽 위로 한 번 이어진다.
+  if (horizontal_tab_strip_region_view_ &&
+      horizontal_tab_strip_region_view_->parent() == this) {
+    ReorderChildView(horizontal_tab_strip_region_view_, children().size());
+  }
+  // 임시 Sidebar가 주소줄의 외곽선·구분선까지 덮도록 두 paint 순서를 맞춘다.
+  if (vertical_tab_strip_background_blur_backdrop_ &&
+      vertical_tab_strip_background_blur_backdrop_->parent() == this) {
+    ReorderChildView(vertical_tab_strip_background_blur_backdrop_,
+                     children().size());
+  }
+  if (vertical_tab_strip_region_view_ &&
+      vertical_tab_strip_region_view_->parent() == this) {
+    ReorderChildView(vertical_tab_strip_region_view_, children().size());
+  }
+  if (find_bar_host_view_) {
+    ReorderChildView(find_bar_host_view_, children().size());
+  }
+  if (window_scrim_view_) {
+    ReorderChildView(window_scrim_view_, children().size());
+  }
+
+  // Layer-backed and non-layer-backed siblings do not share a paint plane.
+  // Reassert the composited half of the view-order contract after Side Panel
+  // animation content is dynamically attached.
+  ui::Layer* const surface_layer = main_background_region_->layer();
+  ui::Layer* const header_layer = top_container_->layer();
+  CHECK(surface_layer);
+  CHECK(header_layer);
+  if (top_container_->parent() == this && surface_layer->parent()) {
+    CHECK_EQ(surface_layer->parent(), header_layer->parent());
+    header_layer->parent()->StackAbove(header_layer, surface_layer);
+  }
+
+#if DCHECK_IS_ON()
+  views::View* const side_panel_surface =
+      GetViewByID(yee::kSidePanelSurfaceViewId);
+  DCHECK(side_panel_surface);
+  const auto is_before = [this](const views::View* first,
+                                const views::View* second) {
+    const std::optional<size_t> first_index = GetIndexOf(first);
+    const std::optional<size_t> second_index = GetIndexOf(second);
+    DCHECK(first_index);
+    DCHECK(second_index);
+    return *first_index < *second_index;
+  };
+  if (top_container_->parent() == this) {
+    DCHECK(is_before(main_background_region_, top_container_));
+    DCHECK(is_before(top_container_, multi_contents_view_));
+  }
+  DCHECK(is_before(multi_contents_view_, infobar_container_));
+  DCHECK(is_before(infobar_container_, main_shadow_overlay_));
+  DCHECK(is_before(main_shadow_overlay_, side_panel_surface));
+  DCHECK(is_before(side_panel_surface, side_panel_));
+  BrowserViewLayout* const browser_layout = GetBrowserViewLayout();
+  views::View* const side_panel_animation_content =
+      browser_layout ? browser_layout->side_panel_animation_content() : nullptr;
+  if (side_panel_animation_content) {
+    DCHECK(is_before(side_panel_animation_content, surface_outline));
+  }
+  DCHECK(is_before(side_panel_, surface_outline));
+  if (resize_gutter && resize_gutter->parent() == this) {
+    DCHECK(is_before(surface_outline, resize_gutter));
+  }
+  if (find_bar_host_view_) {
+    DCHECK(is_before(surface_outline, find_bar_host_view_));
+  }
+  if (window_scrim_view_) {
+    DCHECK(is_before(surface_outline, window_scrim_view_));
+  }
+#endif
+}
