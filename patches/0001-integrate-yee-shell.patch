+void LocationBarView::UpdateCompactShellRestingText() {
+  if (!compact_shell_resting_text_view_) {
+    return;
+  }
+
+  std::u16string title;
+  std::u16string origin;
+  // 전체 주소 표시를 선택하면 native URL을 장식 레이어로 덮지 않는다.
+  const bool show_full_url =
+      profile_ &&
+      profile_->GetPrefs()->GetBoolean(omnibox::kPreventUrlElisionsInOmnibox);
+  bool visible =
+      compact_shell_mode_ && !show_full_url && !HasFocus() &&
+      !GetOmniboxController()->edit_model()->user_input_in_progress() &&
+      compact_shell_presentation_.has_value() &&
+      compact_shell_presentation_->palette_mode ==
+          yee::BrowserSurfacePresentation::PaletteMode::kCustomSurface &&
+      !yee::ShouldUseNativeBrowserSurfaceColors(*GetNativeTheme());
+
+  if (visible && browser_) {
+    content::WebContents* const contents =
+        browser_->tab_strip_model()->GetActiveWebContents();
+    if (contents) {
+      const GURL& url = contents->GetVisibleURL();
+      title = contents->GetTitle();
+      if (url.SchemeIsHTTPOrHTTPS()) {
+        origin = url_formatter::FormatUrlForSecurityDisplay(
+            url, url_formatter::SchemeDisplay::OMIT_HTTP_AND_HTTPS);
+        if (base::StartsWith(origin, u"www.", base::CompareCase::SENSITIVE)) {
+          origin.erase(0, 4);
+        }
+      }
+    }
+  }
+
+  visible = visible && !title.empty() && !origin.empty();
+  if (compact_shell_presentation_.has_value()) {
+    yee::UpdateOmniboxRestingTextView(*compact_shell_resting_text_view_, title,
+                                      origin, *compact_shell_presentation_,
+                                      visible, background_color_);
+  } else {
+    yee::UpdateOmniboxRestingTextView(*compact_shell_resting_text_view_, title,
+                                      origin, background_color_, false);
+  }
+}
