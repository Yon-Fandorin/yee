+        tab->GetTabInterface());
+  const TabCollectionNode* node = nullptr;
+  if (auto* group = views::AsViewClass<TabGroupView>(view))
+    node = group->collection_node();
+  else if (auto* split = views::AsViewClass<SplitTabView>(view))
+    node = split->collection_node();
+  // 재배치 중에는 모델 collection이 먼저 정리될 수 있다. native가 수명을
+  // 관리하는 View/Node mirror만 읽고 전환 중인 모델의 child vector를 순회하지
+  // 않는다.
+  return !node || node->children().empty() ||
+         std::ranges::any_of(node->children(), [](const auto& child) {
+           return ShouldShowTabInProjectNavigation(child->view());
+         });
+}
