+          {contents_container_views_[0]->GetVisible(),
+           contents_container_views_[1]->GetVisible()},
+          /*semantic_stack_height=*/1,
+          external_infobar_flow_.generation,
+          external_infobar_flow_.generation});
+  if (plan.matched_pane_index < 0) {
+    return std::nullopt;
+  }
