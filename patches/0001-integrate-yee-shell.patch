+                   u"Workspace and account menu" &&
+               menu->children()[0]->GetID() ==
+                   yee::kSidebarFooterRootContextViewId &&
+               menu->children()[1]->GetID() ==
+                   yee::kSidebarFooterRootBrowserToolsViewId &&
+               menu->children()[2]->GetID() ==
+                   yee::kSidebarFooterRootMemoryViewId;
