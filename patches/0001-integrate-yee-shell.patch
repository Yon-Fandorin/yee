+      return false;
+    }
+    auto* const origin =
+        views::AsViewClass<views::Label>(resting->children()[0]);
+    auto* const title =
+        views::AsViewClass<views::Label>(resting->children()[2]);
+    return origin && title &&
+           origin->GetBackgroundColor() == presentation.surface &&
