+void TabGroupHeaderView::UpdateVerticalHoverBackground(bool hovered) {
+  const bool use_yee_presentation = UsesYeeGroupPresentation();
+  if (color_mark_) {
+    color_mark_->SetVisible(use_yee_presentation);
+  }
+  if (!GetColorProvider()) {
+    return;
+  }
+  if (!use_yee_presentation) {
+    // 임시 그룹의 중립·눌림 색과 native 테마의 chip을 그대로 복원한다.
+    UpdateColors();
+    if (auto* ring = views::FocusRing::Get(this)) {
+      ring->SetColorId(std::nullopt);
+    }
+    return;
+  }
+  if (color_mark_) {
+    color_mark_->SetDisclosureState(
+        yee::UsesExpandedSidebarPresentation() &&
+            !delegate_->IsGroupFocused() && (hovered || HasFocus()),
+        !tab_group_visual_data_.is_collapsed(), GetForegroundColor());
+  }
+  yee::UpdateTabGroupPreviewColors(*this, hovered);
+  if (orientation_ != TabStripOrientation::kVertical) {
+    const SkColor group_color = GetColorProvider()->GetColor(
+        GetTabGroupTabStripColorId(tab_group_visual_data_.color(),
+                                   GetWidget()->ShouldPaintAsActive()));
+    const auto colors =
+        yee::ResolveHorizontalTabGroupColors(*this, group_color, hovered);
+    CHECK(colors);
+    UpdateForegroundColor(colors->foreground);
+    const gfx::Insets capsule_insets =
+        GetInteriorMargin() -
+        gfx::Insets::VH(0, yee::kSidebarMetrics.group_header_horizontal_inset);
+    SetBackground(yee::CreateHorizontalTabGroupBackground(group_color, hovered,
+                                                          capsule_insets));
+    if (auto* ring = views::FocusRing::Get(this)) {
+      ring->SetColorId(yee::ResolveBrowserSurfaceFocusColorId(
+          *GetColorProvider(), colors->background,
+          ui::kColorSysStateFocusRing));
+    }
+    return;
+  }
+  const views::Widget* const widget = GetWidget();
+  const yee::SidebarItemColors colors = yee::ResolveSidebarItemColors(
+      *GetColorProvider(),
+      hovered ? yee::SidebarItemVisualState::kHovered
+              : yee::SidebarItemVisualState::kResting,
+      hovered ? 1.0 : 0.0, !widget || widget->ShouldPaintAsActive(),
+      /*persistent_surface=*/false);
+  UpdateForegroundColor(colors.foreground);
+  if (hovered) {
+    SetBackground(views::CreateRoundedRectBackground(
+        colors.fill, yee::kSidebarMetrics.group_header_corner_radius));
+  } else {
+    SetBackground(nullptr);
+  }
+}
