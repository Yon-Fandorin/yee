+bool MultiContentsViewMiniToolbar::OnKeyPressed(const ui::KeyEvent& event) {
+  if (uses_yee_browser_surface_geometry_ && !is_active_ &&
+      (event.key_code() == ui::VKEY_RETURN ||
+       event.key_code() == ui::VKEY_SPACE)) {
