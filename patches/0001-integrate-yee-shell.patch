+SkColor ResolveInkDropColor(views::View* view, ChromeColorIds color_id) {
+  const auto* provider = view->GetColorProvider();
+  if (color_id == kColorOmniboxIconHover ||
+      color_id == kColorOmniboxActionIconHover ||
+      color_id == kColorOmniboxIconPressed) {
+    for (auto* ancestor = view; ancestor; ancestor = ancestor->parent()) {
+      if (ancestor->GetProperty(kLocationBarSurfaceInkDrop)) {
+        SkColor surface = views::GetCascadingBackgroundColor(view);
+        if (const auto* background = view->background()) {
+          surface = color_utils::GetResultingPaintColor(
+              background->color().ResolveToSkColor(provider), surface);
+        }
+        return SkColorSetA(color_utils::GetColorWithMaxContrast(surface),
+                           color_id == kColorOmniboxIconPressed ? 0x1A : 0x0F);
+      }
+    }
+  }
+  return provider->GetColor(color_id);
+}
+
+}  // namespace
+
+void SetLocationBarSurfaceInkDrop(views::View& location_bar, bool use_surface) {
+  location_bar.SetProperty(kLocationBarSurfaceInkDrop, use_surface);
+}
+
+OmniboxWarningChipColors ResolveOmniboxWarningChipColors(
+    OmniboxWarningChipColors native_colors,
+    SkColor hover,
+    SkColor press) {
+  const auto contrast = [hover, press](SkColor plate, SkColor ink) {
+    const auto paint = color_utils::GetResultingPaintColor;
+    return std::min({
+        color_utils::GetContrastRatio(ink, plate),
+        color_utils::GetContrastRatio(paint(hover, ink), paint(hover, plate)),
+        color_utils::GetContrastRatio(paint(press, ink), paint(press, plate)),
+        color_utils::GetContrastRatio(paint(press, paint(hover, ink)),
+                                      paint(press, paint(hover, plate))),
+    });
+  };
+  constexpr float minimum = color_utils::kMinimumReadableContrastRatio;
+  const SkColor background = native_colors.background;
+  if (contrast(background, native_colors.foreground) >= minimum) {
+    return native_colors;
+  }
+
+  const bool use_dark_ink =
+      contrast(background, SK_ColorBLACK) >= contrast(background, SK_ColorWHITE);
+  const SkColor ink = use_dark_ink ? SK_ColorBLACK : SK_ColorWHITE;
+  const SkColor target = use_dark_ink ? SK_ColorWHITE : SK_ColorBLACK;
+  // Find the smallest change to the warning color that keeps every state legible.
+  const auto alphas = std::views::iota(0, 255);
+  const auto limit = std::ranges::partition_point(alphas, [&](int alpha) {
+    return contrast(color_utils::AlphaBlend(target, background,
+                                            static_cast<SkAlpha>(alpha)),
+                    ink) < minimum;
+  });
+  return {color_utils::AlphaBlend(target, background,
+                                  static_cast<SkAlpha>(limit - alphas.begin())),
+          ink};
+}
 
