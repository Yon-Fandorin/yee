+    detached_subscription_ = contents_view_->AddWebContentsDetachedCallback(
+        base::BindRepeating(&YeePresentationOutlet::OnWebContentsDetached,
+                            base::Unretained(this)));
+    binding_.BindWebContents(contents_view_->web_contents());
+  }
+
+  YeePresentationOutlet(const YeePresentationOutlet&) = delete;
+  YeePresentationOutlet& operator=(const YeePresentationOutlet&) = delete;
+  ~YeePresentationOutlet() = default;
+
+  yee::BrowserSurfacePresentationBinding* binding() { return &binding_; }
+
+  void SetThemeFallbackColor(SkColor color) {
+    binding_.SetThemeFallbackColor(color);
+  }
+
+  void SetPageViewportClipHost(views::View* host) {
+    CHECK(host);
+    CHECK_EQ(host->GetID(), yee::kPageViewportClipHostViewId);
+    page_viewport_clip_host_ = host;
+  }
+
+  views::View* page_viewport_clip_host() const {
+    return page_viewport_clip_host_;
+  }
+
+ private:
+  void OnWebContentsAttached(views::WebView*) {
+    binding_.BindWebContents(contents_view_->web_contents());
+  }
+
+  void OnWebContentsDetached(views::WebView*) {
+    binding_.BindWebContents(nullptr);
+  }
+
+  const raw_ptr<ContentsWebView> contents_view_;
+  raw_ptr<views::View> page_viewport_clip_host_ = nullptr;
+  yee::BrowserSurfacePresentationBinding binding_;
+  base::CallbackListSubscription attached_subscription_;
+  base::CallbackListSubscription detached_subscription_;
+};
