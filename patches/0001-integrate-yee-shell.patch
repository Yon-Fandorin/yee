+
+void TabGroupHeaderView::UpdateVerticalHoverBackground(bool hovered) {
+  if (orientation_ != TabStripOrientation::kVertical) {
+    return;
+  }
+  const views::Widget* const widget = GetWidget();
+  const yee::SidebarItemColors colors = yee::ResolveSidebarItemColors(
+      *GetColorProvider(),
+      hovered ? yee::SidebarItemVisualState::kHovered
+              : yee::SidebarItemVisualState::kResting,
+      hovered ? 1.0 : 0.0, !widget || widget->ShouldPaintAsActive(),
+      /*persistent_surface=*/false);
+  UpdateForegroundColor(colors.foreground);
+  if (hovered) {
+    SetBackground(views::CreateRoundedRectBackground(
+        colors.fill, yee::kSidebarMetrics.group_header_corner_radius));
+  } else {
+    SetBackground(nullptr);
+  }
+}
+
+void TabGroupHeaderView::SetMarkSignals(const yee::GroupMarkSignals& signals) {
+  if (!color_mark_) {
+    return;
+  }
+  color_mark_->SetNeedsInput(signals.needs_input);
+  color_mark_->SetAudioActive(signals.audio);
+  color_mark_->SetUnread(signals.unread);
+}
