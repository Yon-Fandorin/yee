+InfoBarFlowMetrics InfoBarContainerView::GetFlowMetricsForLayout() const {
+  InfoBarFlowMetrics metrics;
+  for (infobars::InfoBar* infobar : infobars()) {
+    auto* const infobar_view = static_cast<InfoBarView*>(infobar);
+    if (infobar_view->computed_height() <= 0) {
+      continue;
+    }
+    if (metrics.visible_bar_count > 0) {
+      metrics.semantic_stack_height += kSeparatorHeightDip;
+    }
+    metrics.semantic_stack_height += infobar_view->computed_height();
+    metrics.rigid_control_min_width =
+        std::max(metrics.rigid_control_min_width,
+                 infobar_view->GetRigidControlMinimumWidthForLayout());
+    ++metrics.visible_bar_count;
+  }
+  if (metrics.semantic_stack_height !=
+          last_flow_metrics_.semantic_stack_height ||
+      metrics.rigid_control_min_width !=
+          last_flow_metrics_.rigid_control_min_width ||
+      metrics.visible_bar_count != last_flow_metrics_.visible_bar_count) {
+    ++flow_metrics_generation_;
+  }
+  metrics.animation_generation = flow_metrics_generation_;
+  last_flow_metrics_ = metrics;
+  return metrics;
+}
+
+void InfoBarContainerView::ChangeInfoBarManager(
+    infobars::InfoBarManager* infobar_manager) {
+  auto* const content_manager =
