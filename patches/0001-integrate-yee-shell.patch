+#include "chrome/browser/ui/views/frame/layout/browser_view_tabbed_layout_native_geometry.h"
+
+#include <algorithm>
+
+#include "base/check.h"
+#include "base/numerics/safe_conversions.h"
+#include "ui/gfx/animation/tween.h"
+#include "ui/gfx/geometry/outsets.h"
+
+namespace browser_view_layout {
+namespace {
+
+constexpr float kMaxContentsHeightSidePanelFraction = 2.f / 3.f;
+
+void IncreasePaddingToMinimum(BrowserLayoutParams& params, int minimum) {
+  if (params.trailing_exclusion.content.width() > 0.0) {
+    params.trailing_exclusion.horizontal_padding =
+        std::max(params.trailing_exclusion.horizontal_padding,
+                 static_cast<float>(minimum));
+  } else {
+    params.leading_exclusion.horizontal_padding =
+        std::max(params.leading_exclusion.horizontal_padding,
+                 static_cast<float>(minimum));
+  }
+}
+
+NativeSeparatorState ResolveSeparatorState(
+    const NativeHorizontalPlanInput& input,
+    NativeSidePanelRowMode row_mode,
+    bool has_side_panel) {
+  NativeSeparatorState result;
+  const bool force_to_top = row_mode == NativeSidePanelRowMode::kTopAbovePanel;
+  const bool would_have_separator = input.infobar_visible || !input.split;
+
+  switch (input.window_state) {
+    case BrowserViewLayoutDelegate::WindowState::kNormal:
+    case BrowserViewLayoutDelegate::WindowState::kMaximized: {
+      result.shadow_box = has_side_panel && (input.infobar_visible ||
+                                             !input.split || !force_to_top);
+      const bool suppress_separator = result.shadow_box && force_to_top;
+      result.multi_contents_separator =
+          !suppress_separator && !input.infobar_visible;
+      result.top_container_separator =
+          !suppress_separator && input.infobar_visible;
+      result.side_panel_top_padding = !force_to_top;
+      result.adjust_for_missing_separator =
+          suppress_separator && would_have_separator;
+      break;
+    }
+    case BrowserViewLayoutDelegate::WindowState::kFullscreen:
+      result.shadow_box =
+          has_side_panel && (input.infobar_visible || !input.split);
+      result.top_container_separator =
+          input.toolbar_visible || input.bookmark_bar_visible;
+      result.side_panel_top_padding = true;
+      break;
+    case BrowserViewLayoutDelegate::WindowState::kFullscreenWithToolbar:
+      result.shadow_box =
+          has_side_panel && (input.infobar_visible || !input.split);
+      result.top_container_separator =
+          !result.shadow_box && would_have_separator;
+      result.adjust_for_missing_separator =
+          result.shadow_box && would_have_separator;
+      break;
+  }
+  return result;
+}
+
+gfx::Rect CalculateContentAnimationBounds(
+    const gfx::Rect& side_panel_final_bounds,
+    const NativeSidePanelAnimationInput& animation) {
+  CHECK(animation.content_starting_bounds);
+  const gfx::Rect& starting = *animation.content_starting_bounds;
+  gfx::Rect final_bounds = side_panel_final_bounds;
+  final_bounds.Inset(animation.content_insets);
+
+  gfx::Rect result;
+  result.set_y(gfx::Tween::IntValueBetween(animation.content_top, starting.y(),
+                                           final_bounds.y()));
+  result.set_height(gfx::Tween::IntValueBetween(animation.content_bottom,
+                                                starting.bottom(),
+                                                final_bounds.bottom()) -
+                    result.y());
+  result.set_x(gfx::Tween::IntValueBetween(animation.content_left, starting.x(),
+                                           final_bounds.x()));
+  result.set_width(gfx::Tween::IntValueBetween(
+      animation.content_width, starting.width(), final_bounds.width()));
+  return result;
+}
+
+std::optional<gfx::Rect> CalculatePanelLocalClip(
+    const gfx::Rect& panel_bounds,
+    const gfx::Rect& allowed_bounds) {
+  const int top_overlap = std::max(0, allowed_bounds.y() - panel_bounds.y());
+  const int left_overlap = std::max(0, allowed_bounds.x() - panel_bounds.x());
+  const int bottom_overlap =
+      std::max(0, panel_bounds.bottom() - allowed_bounds.bottom());
+  const int right_overlap =
+      std::max(0, panel_bounds.right() - allowed_bounds.right());
+  if (top_overlap == 0 && left_overlap == 0 && bottom_overlap == 0 &&
+      right_overlap == 0) {
+    return std::nullopt;
+  }
+
+  gfx::Rect result(gfx::Point(), panel_bounds.size());
+  result.Inset(gfx::Insets::TLBR(top_overlap, left_overlap, bottom_overlap,
+                                 right_overlap));
+  if (result.IsEmpty()) {
+    // SidePanel's recursive native-surface clip treats an empty rectangle as
+    // no useful clip. Preserve the existing one-pixel offscreen sentinel.
+    if (left_overlap) {
+      result.Outset(gfx::Outsets::TLBR(0, 0, 0, 1));
+    } else if (right_overlap) {
+      result.Outset(gfx::Outsets::TLBR(0, 1, 0, 0));
+    } else if (top_overlap) {
+      result.Outset(gfx::Outsets::TLBR(0, 0, 1, 0));
+    } else {
+      result.Outset(gfx::Outsets::TLBR(1, 0, 0, 0));
+    }
+  }
+  return result;
+}
+
+gfx::Rect GetBoundsWithExclusion(const BrowserLayoutParams& params,
+                                 const gfx::Size& minimum_size,
+                                 const gfx::Size& preferred_size,
+                                 int leading_margin = 0,
+                                 int trailing_margin = 0) {
+  const gfx::SizeF leading =
+      leading_margin ? params.leading_exclusion.ContentWithPaddingAndInsets(
+                           leading_margin, 0.f)
+                     : params.leading_exclusion.ContentWithPadding();
+  const gfx::SizeF trailing =
+      trailing_margin ? params.trailing_exclusion.ContentWithPaddingAndInsets(
+                            trailing_margin, 0.f)
+                      : params.trailing_exclusion.ContentWithPadding();
+  int height = base::ClampCeil(std::max(leading.height(), trailing.height()));
+  height = height ? std::max(height, minimum_size.height())
+                  : preferred_size.height();
+  return gfx::Rect(
+      params.visual_client_area.x() + base::ClampCeil(leading.width()),
+      params.visual_client_area.y(),
+      std::max(0, params.visual_client_area.width() -
+                      base::ClampCeil(leading.width() + trailing.width())),
+      height);
+}
+
+}  // namespace
+
+NativeHorizontalPlan PlanNativeHorizontalLayout(
+    const NativeHorizontalPlanInput& input) {
+  NativeHorizontalPlan result;
+  result.revised_browser_params = input.browser_params;
+  result.vertical_tab_strip_state = input.vertical_tab_strip_state;
+  result.split = input.split;
+  result.min_content_width = std::max(0, input.minimum_content_width);
+
+  gfx::Rect content_column = input.content_column_bounds;
+  content_column.Intersect(input.browser_params.visual_client_area);
+
+  int minimum_vertical_width = 0;
+  int preferred_vertical_width = 0;
+  if (input.tab_strip_type == NativeTabStripType::kVertical) {
+    minimum_vertical_width =
+        std::max(0, input.vertical_tab_strip_minimum_width);
+    preferred_vertical_width = std::max(
+        minimum_vertical_width, input.vertical_tab_strip_preferred_width);
+    if (input.vertical_tab_strip_state ==
+        NativeVerticalTabStripState::kCollapsed) {
+      minimum_vertical_width = preferred_vertical_width;
+    } else {
+      const int remainder =
+          input.browser_params.visual_client_area.width() -
+          input.toolbar_minimum_width -
+          base::ClampCeil(
+              input.browser_params.trailing_exclusion.ContentWithPadding()
+                  .width());
+      preferred_vertical_width =
+          std::max(minimum_vertical_width,
+                   std::min(remainder, preferred_vertical_width));
+    }
+    IncreasePaddingToMinimum(result.revised_browser_params,
+                             input.minimum_grab_handle_padding);
+  }
+
+  CHECK(result.revised_browser_params.visual_client_area.Contains(
+      content_column));
+  result.content_column_params =
+      result.revised_browser_params.WithClientArea(content_column);
+
+  const bool has_side_panel =
+      input.side_panel_visible && input.side_panel_minimum_width > 0;
+  bool force_top = input.tab_strip_type != NativeTabStripType::kHorizontal;
+  if (has_side_panel && input.force_side_panel_shared_row) {
+    force_top = false;
+  } else if (has_side_panel &&
+             input.tab_strip_type == NativeTabStripType::kVertical &&
+             !input.vertical_tab_strip_inside_content_column &&
+             !input.side_panel_content_type) {
+    // A shell-owned vertical tab rail outside the content column does not
+    // compete with the Toolbar for horizontal space. Toolbar-height panels can
+    // therefore share the full-height surface row just like horizontal tabs.
+    force_top = false;
+  }
+  if (has_side_panel && input.side_panel_content_type &&
+      !input.force_side_panel_shared_row) {
+    force_top = true;
+  }
+
+  int minimum_panel_width = 0;
+  int preferred_panel_width = 0;
+  if (has_side_panel) {
+    minimum_panel_width = std::max(0, input.side_panel_minimum_width);
+    preferred_panel_width =
+        std::max(minimum_panel_width, input.side_panel_preferred_width);
+    if (input.side_panel_content_type && input.side_panel_restrict_max_width) {
+      preferred_panel_width =
+          std::min(preferred_panel_width,
+                   base::ClampFloor(content_column.width() *
+                                    kMaxContentsHeightSidePanelFraction));
+      preferred_panel_width =
+          std::max(minimum_panel_width, preferred_panel_width);
+    }
+    result.side_panel_padding = std::max(0, input.side_panel_padding);
+
+    if (!force_top) {
+      const int remainder =
+          content_column.width() -
+          (input.toolbar_minimum_width + result.side_panel_padding);
+      force_top = !input.force_side_panel_shared_row &&
+                  remainder < minimum_panel_width;
+      if (!force_top) {
+        preferred_panel_width = std::min(preferred_panel_width, remainder);
+      }
+    }
+  }
+
+  result.row_mode = !has_side_panel
+                        ? NativeSidePanelRowMode::kNoPanel
+                        : (force_top ? NativeSidePanelRowMode::kTopAbovePanel
+                                     : NativeSidePanelRowMode::kSharedRow);
+  result.force_top_container_to_top_value = force_top;
+  if (result.row_mode == NativeSidePanelRowMode::kSharedRow) {
+    result.min_content_width =
+        std::max(result.min_content_width, input.toolbar_minimum_width);
+  }
+
+  result.vertical_tab_strip_width = minimum_vertical_width;
+  result.side_panel_width = minimum_panel_width;
+  int remaining = content_column.width() - result.min_content_width -
+                  result.side_panel_padding - minimum_panel_width;
+  if (input.vertical_tab_strip_inside_content_column) {
+    remaining -= minimum_vertical_width;
+  }
+
+  // Preserve native allocation priority: stabilize vertical tabs first, then
+  // give any remaining flex to the Side Panel.
+  if (input.vertical_tab_strip_inside_content_column && remaining > 0) {
+    const int vertical_flex =
+        std::min(remaining, preferred_vertical_width - minimum_vertical_width);
+    result.vertical_tab_strip_width += vertical_flex;
+    remaining -= vertical_flex;
+  } else if (!input.vertical_tab_strip_inside_content_column) {
+    result.vertical_tab_strip_width = preferred_vertical_width;
+  }
+  if (remaining > 0) {
+    result.side_panel_width +=
+        std::min(remaining, preferred_panel_width - minimum_panel_width);
+  }
+
+  result.separator =
+      ResolveSeparatorState(input, result.row_mode, result.has_side_panel());
+  return result;
+}
+
+NativeTopContainerLayout CalculateNativeTopContainerLayout(
+    const NativeTopContainerLayoutInput& input) {
+  NativeTopContainerLayout result;
+  BrowserLayoutParams params = input.params;
+  const int original_top = params.visual_client_area.y();
+  bool needs_exclusion = input.needs_exclusion;
+
+  result.horizontal_tab_strip.parented = input.horizontal_tab_strip_parented;
+  result.horizontal_tab_strip.visible =
+      input.horizontal_tab_strip_parented &&
+      input.tab_strip_type == NativeTabStripType::kHorizontal;
+  if (result.horizontal_tab_strip.visible) {
+    result.horizontal_tab_strip.bounds =
+        GetBoundsWithExclusion(params, input.horizontal_tab_strip_minimum_size,
+                               input.horizontal_tab_strip_preferred_size,
+                               input.horizontal_tab_strip_leading_margin);
+    params.SetTop(result.horizontal_tab_strip.bounds.bottom() -
+                  input.tabstrip_toolbar_overlap);
+    needs_exclusion = false;
+  }
+
+  result.toolbar.parented = input.toolbar_parented;
+  result.toolbar.visible = input.toolbar_parented && input.toolbar_visible;
+  if (result.toolbar.visible) {
+    if (input.toolbar_uses_config) {
+      const gfx::SizeF leading = params.leading_exclusion.ContentWithPadding();
+      const gfx::SizeF trailing =
+          params.trailing_exclusion.ContentWithPadding();
+      result.toolbar.bounds = gfx::Rect(
+          params.visual_client_area.x() + base::ClampCeil(leading.width()) +
+              input.toolbar_insets.left(),
+          params.visual_client_area.y() + input.toolbar_insets.top(),
+          std::max(0, params.visual_client_area.width() -
+                          base::ClampCeil(leading.width() + trailing.width()) -
+                          input.toolbar_insets.width() -
+                          input.trailing_accessory_width),
+          input.toolbar_height);
+      params.SetTop(original_top + input.toolbar_reserved_height);
+    } else {
+      result.toolbar.bounds =
+          needs_exclusion
+              ? GetBoundsWithExclusion(params, input.toolbar_minimum_size,
+                                       input.toolbar_preferred_size)
+              : gfx::Rect(params.visual_client_area.x(),
+                          params.visual_client_area.y(),
+                          params.visual_client_area.width(),
+                          input.toolbar_preferred_size.height());
+      params.SetTop(result.toolbar.bounds.bottom());
+    }
+    needs_exclusion = false;
+  }
+
+  result.bookmark_bar.parented = input.bookmark_bar_parented;
+  result.bookmark_bar.visible =
+      input.bookmark_bar_parented && input.bookmark_bar_visible;
+  if (input.bookmark_bar_parented) {
+    result.bookmark_bar.bounds = gfx::Rect(
+        params.visual_client_area.x(), params.visual_client_area.y(),
+        params.visual_client_area.width(),
+        result.bookmark_bar.visible ? input.bookmark_bar_preferred_height : 0);
+    params.SetTop(result.bookmark_bar.bounds.bottom());
+  }
+
+  result.separator.parented = input.separator_parented;
+  result.separator.visible =
+      input.separator_parented && input.separator_visible;
+  if (result.separator.visible) {
+    result.separator.bounds = gfx::Rect(
+        params.visual_client_area.x(), params.visual_client_area.y(),
+        params.visual_client_area.width(), input.separator_preferred_height);
+    params.SetTop(result.separator.bounds.bottom());
+  }
+
+  result.bounds = gfx::Rect(params.visual_client_area.x(), original_top,
+                            params.visual_client_area.width(),
+                            params.visual_client_area.y() - original_top);
+  return result;
+}
+
+NativeSidePanelGeometry ResolveNativeSidePanelGeometry(
+    const NativeSidePanelGeometryInput& input) {
+  NativeSidePanelGeometry result;
+  result.remaining_bounds = input.available_bounds;
+  result.unclipped_contents_region = input.unclipped_contents_region;
+  result.target_width = std::max(0, input.target_width);
+  result.visible = result.target_width > 0;
+  result.leading = input.leading;
+  result.reveal = std::clamp(input.animation.reveal, 0.0, 1.0);
+  if (!result.visible) {
+    result.shadow_bounds = result.remaining_bounds;
+    return result;
+  }
+
+  result.visible_width = base::ClampFloor(result.target_width * result.reveal);
+  result.animating = result.reveal < 1.0;
+
+  const int top = input.available_bounds.y() +
+                  (input.side_panel_top_padding ? input.panel_padding : 0);
+  result.current_bounds = gfx::Rect(
+      input.leading ? input.available_bounds.x() -
+                          (result.target_width - result.visible_width)
+                    : input.available_bounds.right() - result.visible_width,
+      top, result.target_width, input.available_bounds.bottom() - top);
+  result.final_bounds = gfx::Rect(
+      input.leading ? input.available_bounds.x()
+                    : input.available_bounds.right() - result.target_width,
+      top, result.target_width, input.available_bounds.bottom() - top);
+  if (input.animation_content_visible) {
+    result.animation_content_bounds =
+        CalculateContentAnimationBounds(result.final_bounds, input.animation);
+  }
+
+  result.local_clip_bounds =
+      CalculatePanelLocalClip(result.current_bounds, input.panel_clip_bounds);
+  result.remaining_bounds.Inset(
+      gfx::Insets::TLBR(0, input.leading ? result.visible_width : 0, 0,
+                        input.leading ? 0 : result.visible_width));
+  if (result.reveal == 1.0) {
+    result.unclipped_contents_region.Inset(
+        gfx::Insets::TLBR(0, input.leading ? result.visible_width : 0, 0,
+                          input.leading ? 0 : result.visible_width));
+  }
+
+  if (input.shadow_box) {
+    const int scaled_padding =
+        base::ClampRound(result.reveal * input.panel_padding);
+    const int scaled_top = input.side_panel_top_padding
+                               ? scaled_padding
+                               : input.separator_thickness;
+    result.shadow_insets =
+        gfx::Insets::TLBR(scaled_top, input.leading ? 0 : scaled_padding,
+                          scaled_padding, input.leading ? scaled_padding : 0);
+    result.remaining_bounds.Inset(result.shadow_insets);
+    if (!result.animating) {
+      result.unclipped_contents_region.Inset(result.shadow_insets);
+    }
+  }
+  result.shadow_bounds = result.remaining_bounds;
+  return result;
+}
+
+NativeBodyAllocation ResolveNativeBodyAllocation(
+    const NativeBodyAllocationInput& input) {
+  NativeBodyAllocation result;
+  result.notice_flow_allocation = input.notice_flow_allocation;
+  result.underlap_deficit = std::max(
+      0, input.minimum_content_width - input.notice_flow_allocation.width());
+
+  int content_left = input.notice_flow_allocation.x();
+  int content_right = input.notice_flow_allocation.right();
+  if (result.underlap_deficit > 0) {
+    // This intentionally characterizes Chromium's current minimum-width rule.
+    // It clamps the already allocated row to its allowed containing rectangle;
+    // it does not synthesize a wider row by subtracting the deficit.
+    content_left = std::max(content_left, input.allowed_bounds.x());
+    content_right = std::min(content_right, input.allowed_bounds.right());
+  }
+  result.body_allocation =
+      gfx::Rect(content_left, input.notice_flow_allocation.y(),
+                std::max(0, content_right - content_left),
+                input.notice_flow_allocation.height());
+  result.body_occlusion_rect = result.body_allocation;
+  result.body_occlusion_rect.Intersect(input.panel_visible_region);
+  result.has_contiguous_notice_flow =
+      input.notice_flow_allocation.IsEmpty() ||
+      input.allowed_bounds.Contains(input.notice_flow_allocation);
+  return result;
+}
+
+gfx::Insets ResolveNativeSplitViewInsets(
+    bool split,
+    BrowserViewLayoutDelegate::WindowState window_state,
+    bool infobar_visible,
+    const NativeHorizontalPlan& horizontal_plan,
+    bool side_panel_leading,
+    double side_panel_reveal,
+    int default_inset) {
+  if (!split) {
+    return gfx::Insets();
+  }
+  const bool include_top =
+      window_state == BrowserViewLayoutDelegate::WindowState::kFullscreen ||
+      infobar_visible;
+  const bool include_leading =
+      horizontal_plan.separator.shadow_box ||
+      !(horizontal_plan.has_side_panel() && side_panel_leading);
+  const bool include_trailing =
+      horizontal_plan.separator.shadow_box ||
+      !(horizontal_plan.has_side_panel() && !side_panel_leading);
+  const int panel_side_inset = base::ClampRound(
+      (1.0 - std::clamp(side_panel_reveal, 0.0, 1.0)) * default_inset);
+  return gfx::Insets::TLBR(include_top ? default_inset : 0,
+                           include_leading ? default_inset : panel_side_inset,
+                           default_inset,
+                           include_trailing ? default_inset : panel_side_inset);
+}
+
+}  // namespace browser_view_layout
