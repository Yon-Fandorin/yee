+
+void ServiceWorkerContainerHostForClient::WrapSubresourceLoaderFactory(
+    mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+    mojo::PendingRemote<network::mojom::URLLoaderFactory> downstream) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!service_worker_client_ || !context() ||
+      !context()->wrapper()->browser_context())
+    return;
+  const auto& client = service_worker_client();
+  auto* frame = client.IsContainerForWindowClient()
+                    ? RenderFrameHostImpl::FromID(client.GetRenderFrameHostId())
+                    : nullptr;
+  if (client.IsContainerForWindowClient() && !frame)
+    return;
+  const auto& origin = client.key().origin();
+  const auto top = client.top_frame_origin().value_or(origin);
+  const auto isolation = net::IsolationInfo::Create(
+      net::IsolationInfo::RequestType::kOther, top, origin,
+      net::SiteForCookies(), client.key().nonce());
+  url_loader_factory::CreateAndConnectToPendingReceiver(
+      std::move(receiver),
+      client.IsContainerForWindowClient()
+          ? ContentBrowserClient::URLLoaderFactoryType::kDocumentSubResource
+          : ContentBrowserClient::URLLoaderFactoryType::kWorkerSubResource,
+      url_loader_factory::TerminalParams::ForNonNetwork(
+          std::move(downstream), client.GetProcessId().GetUnsafeValue()),
+      url_loader_factory::ContentClientParams(
+          context()->wrapper()->browser_context(), frame,
+          client.GetProcessId().GetUnsafeValue(), origin, isolation,
+          ukm::SourceIdObj::FromInt64(ukm_source_id_)));
+}
