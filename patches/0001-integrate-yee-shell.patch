+yee::PageViewportGeometry ContentsContainerView::CalculatePageViewportGeometry(
+    const gfx::Size& container_size,
+    gfx::Rect* devtools_bounds) const {
+  gfx::Rect page_environment(container_size);
+  page_environment.Inset(GetInsets());
+  const bool use_split_header =
+      uses_yee_browser_surface_geometry_ && is_in_split_;
+  if (use_split_header) {
+    page_environment.Inset(gfx::Insets::TLBR(
+        yee::kSidebarMetrics.split_pane_header_height,
+        yee::kSidebarMetrics.split_pane_content_stroke_inset,
+        yee::kSidebarMetrics.split_pane_content_stroke_inset,
+        yee::kSidebarMetrics.split_pane_content_stroke_inset));
+  }
+  if (uses_yee_browser_surface_geometry_ && external_infobar_height_ > 0) {
+    page_environment.Inset(
+        gfx::Insets::TLBR(external_infobar_height_, 0, 0, 0));
+  }
+
+  gfx::Rect logical_devtools_bounds;
+  gfx::Rect logical_content_and_footer;
+  ApplyDevToolsContentsResizingStrategy(strategy_, page_environment,
+                                        &logical_devtools_bounds,
+                                        &logical_content_and_footer);
+  const auto to_physical = [&container_size](gfx::Rect rect) {
+    if (base::i18n::IsRTL()) {
+      rect.set_x(container_size.width() - rect.right());
+    }
+    return rect;
+  };
+  if (devtools_bounds) {
+    *devtools_bounds = to_physical(logical_devtools_bounds);
+  }
+
+  yee::PageViewportGeometryInput input;
+  input.page_environment_in_container = to_physical(page_environment);
+  input.content_and_footer_in_container =
+      to_physical(logical_content_and_footer);
+  input.footer_height =
+      new_tab_footer_view_ && new_tab_footer_view_->GetVisible()
+          ? kNewTabFooterHeight + kNewTabFooterSeparatorHeight
+          : 0;
+  input.target_outsets = target_content_bounds_;
+  input.viewport_radii = contents_view_->GetBackgroundRadii();
+  input.is_rtl = base::i18n::IsRTL();
+  input.generation = page_viewport_generation_;
+  return yee::ResolvePageViewportGeometry(input);
+}
+
+void ContentsContainerView::UpdateAppliedPageViewportGeometry() {
+  CHECK(page_viewport_geometry_);
+  yee::PageViewportGeometry candidate =
+      CalculatePageViewportGeometry(size(), nullptr);
+  const DevToolsDockedPlacement old_placement =
+      current_devtools_docked_placement_;
+  UpdateDevToolsDockedPlacement(candidate);
+  if (current_devtools_docked_placement_ != old_placement &&
+      !rounded_corner_radii_.IsEmpty()) {
+    UpdateBorderRoundedCorners();
+    candidate = CalculatePageViewportGeometry(size(), nullptr);
+  }
+  candidate.current_viewport_in_screen =
+      candidate.current_viewport_in_container;
+  if (GetWidget()) {
+    views::View::ConvertRectToScreen(this,
+                                     &candidate.current_viewport_in_screen);
+  }
+  candidate.generation = page_viewport_geometry_->generation;
+  if (candidate == *page_viewport_geometry_) {
+    return;
+  }
+  candidate.generation = ++page_viewport_generation_;
+  *page_viewport_geometry_ = std::move(candidate);
+}
