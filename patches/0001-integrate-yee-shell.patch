+void MultiContentsViewMiniToolbar::ExecuteGlobalCommand(int command_id) {
+  chrome::ExecuteCommand(browser_view_->browser(), command_id);
+}
+
+void MultiContentsViewMiniToolbar::UpdateYeeSidebarButton(
+    tabs::VerticalTabStripCollapseState state) {
+  CHECK(yee_sidebar_button_);
+  const bool is_collapsed =
+      state != tabs::VerticalTabStripCollapseState::kExpanded;
+  const std::u16string label = l10n_util::GetStringUTF16(
+      is_collapsed ? IDS_EXPAND_VERTICAL_TABS : IDS_COLLAPSE_VERTICAL_TABS);
+  yee_sidebar_button_->SetTooltipText(label);
+  yee_sidebar_button_->GetViewAccessibility().SetName(label);
+}
+
+void MultiContentsViewMiniToolbar::UpdateYeeHeaderPresentation() {
+  if (yee_presentation_updates_suspended_) {
+    yee_presentation_update_pending_ = true;
+    return;
+  }
+  if (!uses_yee_browser_surface_geometry_ || !GetColorProvider()) {
+    return;
+  }
+
+  std::optional<yee::BrowserSurfacePresentation> presentation =
+      yee_presentation_binding_ ? yee_presentation_binding_->GetPresentation()
+                                : std::nullopt;
+  if (!presentation.has_value()) {
+    presentation = yee::ResolveBrowserSurfacePresentation(
+        GetColorProvider()->GetColor(kColorToolbar), 0, 0, 0);
+  }
+  const bool native_colors = GetNativeTheme()->preferred_contrast() ==
+                             ui::NativeTheme::PreferredContrast::kMore;
+  if (native_colors) {
+    presentation = yee::UseNativeBrowserSurfaceColors(*presentation);
+    presentation->surface = GetColorProvider()->GetColor(kColorToolbar);
+    presentation->primary = GetColorProvider()->GetColor(kColorOmniboxText);
+    presentation->secondary =
+        GetColorProvider()->GetColor(kColorOmniboxTextDimmed);
+    presentation->disabled =
+        GetColorProvider()->GetColor(kColorToolbarButtonIconDisabled);
+    presentation->header_separator =
+        GetColorProvider()->GetColor(kColorToolbarContentAreaSeparator);
+    presentation->resting_divider = presentation->header_separator;
+  }
+  yee_presentation_ = presentation;
+  const SkColor surface = presentation->surface;
+  // The Pane Header is the card's full top surface, not another Omnibox pill.
+  // Its layer supplies only the two outer top clips; the native LocationBar
+  // keeps its own inset focus treatment while editing.
+  SetBackground(views::CreateSolidBackground(surface));
+
+  if (yee_resting_text_) {
+    yee::UpdateOmniboxRestingTextView(
+        *yee_resting_text_, web_contents_ ? web_contents_->GetTitle() : u"",
+        domain_label_->GetText(), *presentation, !is_active_);
+  }
+
+  const gfx::VectorIcon& close_icon = features::IsRoundedIconsEnabled()
+                                          ? kCloseWeight500CustomIcon
+                                          : kCloseTabChromeRefreshOldIcon;
+  close_button_->SetImageModel(
+      views::Button::STATE_NORMAL,
+      native_colors
+          ? ui::ImageModel::FromVectorIcon(
+                close_icon, kColorMultiContentsViewMiniToolbarForeground,
+                features::IsRoundedIconsEnabled() ? 14 : 16)
+          : ui::ImageModel::FromVectorIcon(
+                close_icon, presentation->primary,
+                features::IsRoundedIconsEnabled() ? 14 : 16));
+
+  const auto update_navigation_button =
+      [&presentation, native_colors](ToolbarButton* button, bool enabled) {
+        if (!button) {
+          return;
+        }
+        button->SetEnabled(enabled);
+        button->SetForegroundColorOverrides(
+            native_colors ? std::nullopt
+                          : std::optional<SkColor>(presentation->primary),
+            native_colors ? std::nullopt
+                          : std::optional<SkColor>(presentation->disabled));
+      };
+  update_navigation_button(yee_sidebar_button_, true);
+  update_navigation_button(
+      yee_back_button_,
+      web_contents_ && web_contents_->GetController().CanGoBack());
+  update_navigation_button(
+      yee_forward_button_,
+      web_contents_ && web_contents_->GetController().CanGoForward());
+  update_navigation_button(yee_reload_button_, web_contents_ != nullptr);
+
+  std::u16string accessible_name =
+      l10n_util::GetStringUTF16(IDS_ACCNAME_LOCATION);
+  if (!domain_label_->GetText().empty()) {
+    accessible_name.append(u": ");
+    accessible_name.append(domain_label_->GetText());
+  }
+  SetAccessibleName(accessible_name);
+  SchedulePaint();
 }
 
