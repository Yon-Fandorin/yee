+      yee::ResolveExternalInfoBarFlowPlan(yee::ExternalInfoBarFlowPlanInput{
+          reinterpret_cast<uintptr_t>(web_contents),
+          {reinterpret_cast<uintptr_t>(
+               contents_container_views_[0]->contents_view()->web_contents()),
+           reinterpret_cast<uintptr_t>(
+               contents_container_views_[1]->contents_view()->web_contents())},
+          {contents_container_views_[0]->GetVisible(),
+           contents_container_views_[1]->GetVisible()},
+          /*semantic_stack_height=*/1,
+          external_infobar_flow_.generation,
+          external_infobar_flow_.generation});
+  if (plan.matched_pane_index < 0) {
+    return std::nullopt;
+  }
