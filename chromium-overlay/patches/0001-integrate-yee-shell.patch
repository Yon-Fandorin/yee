+void MultiContentsViewMiniToolbar::Layout(PassKey) {
+  if (yee::IsShellEnabled()) {
+    UpdateYeeInteriorMargin();
+  }
+  LayoutSuperclass<views::View>(this);
+  if (yee::IsShellEnabled()) {
+    // Caption exclusions own horizontal collision avoidance only. Vertically,
+    // center every control inside the visible Pane Header. Its 42-DIP height is
+    // the same as the single Browser Surface Header below the outer gutter, so
+    // both presentations share one visual axis. Position children directly to
+    // avoid odd-height Flex rounding differences between icons and Omnibox.
+    const int local_center_y = height() / 2;
+    for (views::View* child : children()) {
+      if (!child->GetVisible()) {
+        continue;
+      }
+      gfx::Rect bounds = child->bounds();
+      bounds.set_y(local_center_y - bounds.height() / 2);
+      child->SetBoundsRect(bounds);
+    }
+  }
+}
+
+void MultiContentsViewMiniToolbar::UpdateYeeInteriorMargin() {
+  CHECK(yee::IsShellEnabled());
+  const int horizontal_padding = std::max(
+      yee::kSidebarMetrics.browser_surface_header_control_edge_inset,
+      yee::kSidebarMetrics.split_pane_address_bar_inset +
+          (is_active_
+               ? yee::kSidebarMetrics.split_pane_address_bar_active_padding
+               : yee::kSidebarMetrics.split_pane_address_bar_horizontal_padding));
+  int leading_padding = horizontal_padding;
+
+  // A split Pane Header replaces the shared Toolbar, so it must independently
+  // respect platform-owned leading caption controls. Derive the safe edge from
+  // the real frame exclusion instead of copying macOS traffic-light geometry.
+  if (browser_view_ && parent()) {
+    gfx::Point header_origin;
+    views::View::ConvertPointToTarget(this, browser_view_, &header_origin);
+    const int safe_leading_edge =
+        browser_view_->GetYeeLeadingWindowControlsSafeEdge() +
+        yee::kSidebarMetrics.sidebar_header_controls_leading_inset();
+    leading_padding =
+        std::max(leading_padding, safe_leading_edge - header_origin.x());
+  }
+
+  static_cast<views::FlexLayout*>(GetLayoutManager())
+      ->SetInteriorMargin(base::i18n::IsRTL()
+                              ? gfx::Insets::TLBR(0, horizontal_padding, 0,
+                                                  leading_padding)
+                              : gfx::Insets::TLBR(0, leading_padding, 0,
+                                                  horizontal_padding));
+}
