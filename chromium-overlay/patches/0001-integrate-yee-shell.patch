+void TabGroupView::UpdateMarkSignals(const tabs::TabGroupData& tab_group_data) {
+  yee::GroupMarkSignals signals;
+  signals.unread = tab_group_data.needs_attention;
+
+  const TabGroup& group = GetTabGroup();
+  tabs::TabInterface* const first_tab = group.GetFirstTab();
+  if (!first_tab) {
+    group_header_->SetMarkSignals(signals);
+    return;
+  }
+
+  const std::vector<tabs::TabInterface*> tabs =
+      first_tab->GetBrowserWindowInterface()
+          ->GetTabStripModel()
+          ->GetTabsAtIndices(group.ListTabs().ToIntVector());
+  for (tabs::TabInterface* const tab : tabs) {
+    if (TabUIHelper* const helper = TabUIHelper::From(tab)) {
+      const GURL visible = helper->GetVisibleURL();
+      yee::ApplyFileDemoSignals(
+          visible.is_empty() ? helper->GetLastCommittedURL() : visible,
+          signals);
+      signals.unread = signals.unread || helper->needs_attention();
+    }
+    const tabs::TabAlertController* const controller =
+        tabs::TabAlertController::From(tab);
+    if (!controller) {
+      continue;
+    }
+    for (const tabs::TabAlert alert : controller->GetAllActiveAlerts()) {
+      if (yee::ClassifyTabAlert(alert) == yee::TabAlertKind::kBrowserMedia) {
+        signals.audio = true;
+      }
+    }
+  }
+  group_header_->SetMarkSignals(signals);
+}
