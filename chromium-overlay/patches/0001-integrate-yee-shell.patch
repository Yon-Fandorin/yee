+
+void LocationBarView::UpdateCompactShellRestingText() {
+  if (!compact_shell_resting_text_view_) {
+    return;
+  }
+
+  std::u16string title;
+  std::u16string origin;
+  bool visible = compact_shell_mode_ && !HasFocus() &&
+                 !GetOmniboxController()
+                      ->edit_model()
+                      ->user_input_in_progress() &&
+                 GetNativeTheme()->preferred_contrast() !=
+                     ui::NativeTheme::PreferredContrast::kMore;
+
+  if (visible && browser_) {
+    content::WebContents* const contents =
+        browser_->tab_strip_model()->GetActiveWebContents();
+    if (contents) {
+      const GURL& url = contents->GetVisibleURL();
+      title = contents->GetTitle();
+      if (url.SchemeIsHTTPOrHTTPS()) {
+        origin = url_formatter::FormatUrlForSecurityDisplay(
+            url, url_formatter::SchemeDisplay::OMIT_HTTP_AND_HTTPS);
+        if (base::StartsWith(origin, u"www.",
+                             base::CompareCase::SENSITIVE)) {
+          origin.erase(0, 4);
+        }
+      }
+    }
+  }
+
+  visible = visible && !title.empty() && !origin.empty();
+  yee::UpdateOmniboxRestingTextView(
+      *compact_shell_resting_text_view_, title, origin, background_color_,
+      visible);
+}
