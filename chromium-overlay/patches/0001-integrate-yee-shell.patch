+  toolbar_background->SetVisible(false);
+
+  auto* const vertical_tabs_controller =
+      tabs::VerticalTabStripStateController::From(browser_);
+  CHECK(vertical_tabs_controller);
+  auto sidebar_button = yee::CreateShellToolbarButton(base::BindRepeating(
+      &ToolbarView::ToggleCompactShellSidebar, base::Unretained(this)));
+  sidebar_button->SetVectorIcon(kDockToLeftIcon);
+
+  auto add_button = yee::CreateShellAddButton(
+      base::BindRepeating(&ExecuteYeeCreateAction, browser_));
+  add_button->SetVectorIcon(kAddIcon);
+  ToolbarButton* const compact_shell_add_button =
+      AddChildViewAt(std::move(add_button), 0);
+
+  const auto show_agent_activity = [](Browser* browser,
+                                      const ui::Event& event) {
+    ShowYeeAgentActivity(browser, event.flags());
+  };
+  auto agent_button = yee::CreateAgentToolbarButton(
+      base::BindRepeating(show_agent_activity, browser_));
+  ToolbarButton* const compact_shell_agent_button =
+      AddChildViewAt(std::move(agent_button), 1);
+  compact_shell_sidebar_button_ = AddChildViewAt(std::move(sidebar_button), 2);
+  auto shell_column_spacer = std::make_unique<views::View>();
+  shell_column_spacer->SetCanProcessEventsWithinSubtree(false);
+  shell_column_spacer->SetProperty(views::kMarginsKey, gfx::Insets());
+  compact_shell_column_spacer_ =
+      AddChildViewAt(std::move(shell_column_spacer), 3);
+  compact_shell_sidebar_subscription_ =
+      vertical_tabs_controller->RegisterOnCollapseChanged(
+          base::BindRepeating(&ToolbarView::UpdateCompactShellSidebarButton,
+                              base::Unretained(this)));
+  UpdateCompactShellSidebarButton(vertical_tabs_controller->GetCollapseState());
+
+  CHECK(location_bar_view_);
+  const size_t location_bar_index = GetIndexOf(location_bar_view_).value();
+  compact_shell_leading_divider_ =
+      AddChildViewAt(std::make_unique<ToolbarDivider>(), location_bar_index);
+  compact_shell_leading_divider_->SetVisible(false);
+
+  if (forward_) {
+    forward_->SetVisible(true);
+  }
+  if (home_) {
+    home_->SetVisible(false);
+  }
+  if (split_tabs_) {
+    split_tabs_->SetVisible(false);
+  }
+  if (glic_actor_button_container_) {
+    glic_actor_button_container_->SetVisible(false);
+  }
+  if (glic_button_) {
+    glic_button_->SetVisible(false);
+  }
+  if (glic_button_divider_) {
+    glic_button_divider_->SetVisible(false);
+  }
+  if (pinned_toolbar_actions_container_) {
+    pinned_toolbar_actions_container_->SetVisible(false);
+  }
+  if (battery_saver_button_) {
+    battery_saver_button_->SetVisible(false);
+  }
+  if (performance_intervention_button_) {
+    performance_intervention_button_->SetVisible(false);
+  }
+  if (avatar_) {
+    avatar_->SetVisible(false);
+  }
+  if (overflow_button_) {
+    overflow_button_->SetVisible(false);
+  }
+  if (app_menu_button_) {
+    app_menu_button_->SetVisible(false);
+  }
+  if (toolbar_divider_) {
+    toolbar_divider_->SetVisible(false);
+  }
+  location_bar_view_->ConfigureForCompactShell();
+
+  yee::ApplyShellControlStyle(*compact_shell_add_button);
+  yee::ApplyShellControlStyle(*compact_shell_agent_button);
+  yee::ApplyShellControlStyle(*compact_shell_sidebar_button_);
+  if (back_) {
+    yee::ApplyShellControlStyle(*back_);
+    static_cast<BackForwardButton*>(back_)->SetClickAnimationEnabled(false);
+  }
+  if (forward_) {
+    yee::ApplyShellControlStyle(*forward_);
+    static_cast<BackForwardButton*>(forward_)->SetClickAnimationEnabled(false);
+  }
+  if (reload_) {
+    yee::ApplyShellControlStyle(*reload_);
+  }
+  if (extensions_container_) {
+    yee::ApplyShellControlStyle(*extensions_container_->GetExtensionsButton());
+  }
+  compact_shell_leading_divider_->SetProperty(views::kMarginsKey,
+                                              gfx::Insets::VH(0, 7));
+  UpdateCompactShellLocationBarMargins();
+  if (extensions_container_) {
+    extensions_container_->SetProperty(views::kMarginsKey,
+                                       gfx::Insets::VH(0, 2));
+  }
+
+  InvalidateLayout();
+  SchedulePaint();
+}
+
+void ToolbarView::ToggleCompactShellSidebar(const ui::Event& event) {
+  chrome::ExecuteCommandWithDisposition(
+      browser_, IDC_TOGGLE_VERTICAL_TABS_COLLAPSE,
+      ui::DispositionFromEventFlags(event.flags()));
+}
+
+void ToolbarView::UpdateCompactShellSidebarButton(
+    tabs::VerticalTabStripCollapseState state) {
+  CHECK(compact_shell_sidebar_button_);
+  const bool is_collapsed =
+      state != tabs::VerticalTabStripCollapseState::kExpanded;
+  const std::u16string sidebar_label = l10n_util::GetStringUTF16(
+      is_collapsed ? IDS_EXPAND_VERTICAL_TABS : IDS_COLLAPSE_VERTICAL_TABS);
+  compact_shell_sidebar_button_->SetTooltipText(sidebar_label);
+  compact_shell_sidebar_button_->GetViewAccessibility().SetName(sidebar_label);
+  InvalidateLayout();
+}
+
+void ToolbarView::UpdateCompactShellLocationBarMargins() {
+  if (!compact_shell_mode_ || !location_bar_view_) {
+    return;
+  }
+
+  const int leading_margin = kYeeCompactLocationBarDefaultMargin;
+  const int trailing_margin = kYeeCompactLocationBarDefaultMargin;
+  location_bar_view_->SetProperty(
+      views::kMarginsKey,
+      base::i18n::IsRTL()
+          ? gfx::Insets::TLBR(0, trailing_margin, 0, leading_margin)
+          : gfx::Insets::TLBR(0, leading_margin, 0, trailing_margin));
+}
+
+void ToolbarView::UpdateCompactShellColumnSpacer() {
+  if (!compact_shell_mode_ || !compact_shell_column_spacer_) {
+    return;
+  }
+
+  int spacer_width = 0;
+  auto* const controller =
+      tabs::VerticalTabStripStateController::From(browser_);
+  if (controller && controller->GetCollapseState() ==
+                        tabs::VerticalTabStripCollapseState::kExpanded) {
+    // Keep the Sidebar Header and pinned Tab Sidebar on one column boundary.
+    // The toolbar itself starts after any platform-owned leading controls, so
+    // measure its real origin instead of duplicating an OS-specific inset.
+    gfx::Point toolbar_origin;
+    views::View::ConvertPointToTarget(this, browser_view_, &toolbar_origin);
+    const int browser_toolbar_start =
+        controller->GetUncollapsedWidth() + kYeeCompactContentGutter;
+    const int shell_controls_span =
+        kYeeCompactToolbarInteriorInset +
+        kYeeCompactShellControlCount * kYeeCompactControlSpan;
+    spacer_width = std::max(
+        0, browser_toolbar_start - toolbar_origin.x() - shell_controls_span);
+  }
+
+  const gfx::Size spacer_size(spacer_width, 1);
+  if (compact_shell_column_spacer_->GetPreferredSize() != spacer_size) {
+    compact_shell_column_spacer_->SetPreferredSize(spacer_size);
+  }
+}
