+
+void MultiContentsResizeArea::UpdateYeeResizeHandleAnchor(
+    const gfx::Point& anchor,
+    bool emphasized,
+    bool animate) {
+  const gfx::Rect handle_bounds = resize_handle_->bounds();
+  if (handle_bounds.IsEmpty()) {
+    return;
+  }
+
+  gfx::Vector2dF offset;
+  if (axis() == Axis::kHorizontal) {
+    const int half_extent = handle_bounds.height() / 2;
+    const int position = std::clamp(
+        anchor.y(), half_extent, std::max(half_extent, height() - half_extent));
+    offset.set_y(position - handle_bounds.CenterPoint().y());
+  } else {
+    const int half_extent = handle_bounds.width() / 2;
+    const int position = std::clamp(
+        anchor.x(), half_extent, std::max(half_extent, width() - half_extent));
+    offset.set_x(position - handle_bounds.CenterPoint().x());
+  }
+  yee::UpdateSplitResizeHandleAnchor(*resize_handle_, offset, emphasized,
+                                     animate);
+}
+
+void MultiContentsResizeArea::ResetYeeResizeHandleAnchor(bool animate) {
+  const bool emphasized = resize_handle_->HasFocus() || IsMouseHovered();
+  yee::UpdateSplitResizeHandleAnchor(*resize_handle_, gfx::Vector2dF(),
+                                     emphasized, animate);
+}
