+
+void TabDragHandlerImpl::UpdateIncomingDropSlots(
+    const gfx::Point& point_in_screen) {
+  ClearIncomingDropSlots();
+  if (favorite_drop_ == FavoriteDrop::kNone) {
+    return;
+  }
+  auto* strip = views::AsViewClass<TabStripView>(root_node_->view());
+  if (!strip) {
+    return;
+  }
+
+  if (favorite_drop_ == FavoriteDrop::kPin) {
+    if (auto* pinned = strip->GetPinnedTabsContainer()) {
+      int count = 0;
+      for (views::View* child : pinned->children()) {
+        if (child->GetVisible()) {
+          ++count;
+        }
+      }
+      gfx::Size tile_size = drag_tile_size_;
+      if (tile_size.IsEmpty()) {
+        tile_size = yee::FavoritesTileSize(*pinned);
+      }
+      incoming_favorites_slot_ = yee::FavoritesInsertIndexForTile(
+          *pinned,
+          yee::FavoritesDraggedTileInScreen(point_in_screen, drag_grab_offset_,
+                                            tile_size),
+          count);
+    }
+    return;
+  }
+
+  auto* unpinned = strip->GetUnpinnedTabsContainer();
+  if (!unpinned) {
+    return;
+  }
+  const gfx::Point local =
+      views::View::ConvertPointFromScreen(unpinned, point_in_screen);
+  int visible_index = 0;
+  for (views::View* child : unpinned->children()) {
+    if (!child->GetVisible()) {
+      continue;
+    }
+    if (auto* group = views::AsViewClass<TabGroupView>(child)) {
+      if (group->GetBoundsInScreen().Contains(point_in_screen) &&
+          !group->IsCollapsed()) {
+        incoming_group_id_ = group->GetTabGroup().id();
+        int group_index = 0;
+        const gfx::Point in_group =
+            views::View::ConvertPointFromScreen(group, point_in_screen);
+        const std::vector<views::View*> group_children =
+            group->collection_node()
+                ? group->collection_node()->GetDirectChildren()
+                : std::vector<views::View*>();
+        for (views::View* grouped : group_children) {
+          if (!grouped->GetVisible()) {
+            continue;
+          }
+          if (in_group.y() < grouped->bounds().CenterPoint().y()) {
+            incoming_group_gap_before_ = group_index;
+            return;
+          }
+          ++group_index;
+        }
+        incoming_group_gap_before_ = group_index;
+        return;
+      }
+    }
+    if (local.y() < child->bounds().CenterPoint().y()) {
+      incoming_unpinned_gap_before_ = visible_index;
+      return;
+    }
+    ++visible_index;
+  }
+  incoming_unpinned_gap_before_ = visible_index;
+}
+
+void TabDragHandlerImpl::SetDraggedTabViewsHidden(bool hidden) {
+  if (!drag_controller_ || IsDraggingGroups()) {
+    return;
+  }
+  for (TabSlotView* slot_view :
+       drag_controller_->GetSessionData().attached_views()) {
+    if (!slot_view) {
+      continue;
+    }
+    views::View* const dragged_view = ViewFromTabSlot(slot_view);
+    if (!dragged_view) {
+      continue;
+    }
+    if (!dragged_view->layer()) {
+      if (!hidden) {
+        continue;
+      }
+      dragged_view->SetPaintToLayer();
+      dragged_view->layer()->SetFillsBoundsOpaquely(false);
+    }
+    dragged_view->layer()->SetOpacity(hidden ? 0.f : 1.f);
+  }
+}
