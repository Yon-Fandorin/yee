+      yee_back_button_,
+      web_contents_ && web_contents_->GetController().CanGoBack());
+  update_navigation_button(
+      yee_forward_button_,
+      web_contents_ && web_contents_->GetController().CanGoForward());
+  update_navigation_button(yee_reload_button_, web_contents_ != nullptr);
+
+  std::u16string accessible_name =
+      l10n_util::GetStringUTF16(IDS_ACCNAME_LOCATION);
+  if (!domain_label_->GetText().empty()) {
+    accessible_name.append(u": ");
+    accessible_name.append(domain_label_->GetText());
+  }
+  SetAccessibleName(accessible_name);
+  SchedulePaint();
