+// The hover-expanded tab strip is translated into the content area. Extend its
+// hit region back to the window edge so the pointer has a continuous path from
+// the edge trigger into the visible flyout throughout the animation.
+class FloatingTabStripTargeter : public views::ViewTargeterDelegate {
+ public:
+  FloatingTabStripTargeter() = default;
+  ~FloatingTabStripTargeter() override = default;
+
+  bool DoesIntersectRect(const views::View* target,
+                         const gfx::Rect& rect) const override {
+    gfx::Rect hit_bounds = target->GetLocalBounds();
+    const int horizontal_translation =
+        static_cast<int>(target->GetTransform().rc(0, 3));
+    if (horizontal_translation > 0) {
+      hit_bounds.Outset(
+          gfx::Outsets::TLBR(0, horizontal_translation, 0, 0));
+    } else if (horizontal_translation < 0) {
+      hit_bounds.Outset(
+          gfx::Outsets::TLBR(0, 0, 0, -horizontal_translation));
+    }
+    return hit_bounds.Intersects(rect);
+  }
+};
