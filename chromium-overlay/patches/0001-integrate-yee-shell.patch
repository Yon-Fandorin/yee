+views::FlexSpecification CreateLocationBarFlexSpecification(
+    bool constrain_cross_axis_to_preferred) {
+  const auto minimum_rule = views::MinimumFlexSizeRule::kScaleToMinimum;
+  const auto maximum_rule = views::MaximumFlexSizeRule::kUnbounded;
