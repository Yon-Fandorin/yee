+
+void ToolbarView::UpdateCompactShellColumnSpacer() {
+  if (!compact_shell_mode_ || !compact_shell_column_spacer_) {
+    return;
+  }
+
+  int spacer_width = 0;
+  auto* const controller =
+      tabs::VerticalTabStripStateController::From(browser_);
+  if (controller && controller->GetCollapseState() ==
+                        tabs::VerticalTabStripCollapseState::kExpanded) {
+    // Keep the Sidebar Header and pinned Tab Sidebar on one column boundary.
+    // The toolbar itself starts after any platform-owned leading controls, so
+    // measure its real origin instead of duplicating an OS-specific inset.
+    gfx::Point toolbar_origin;
+    views::View::ConvertPointToTarget(this, browser_view_, &toolbar_origin);
+    // Match the first control's visible edge to the Extensions control at the
+    // opposite side of the Browser Surface Header. Flex consumes the button's
+    // own one-DIP margin after the spacer, so remove it from the target here.
+    const int browser_toolbar_start =
+        controller->GetUncollapsedWidth() + yee::kSidebarMetrics.content_gutter +
+        yee::kSidebarMetrics.browser_surface_header_control_edge_inset -
+        yee::kSidebarMetrics.shell_control_horizontal_margin;
+    const int shell_controls_span =
+        yee::kSidebarMetrics.toolbar_interior_inset;
+    spacer_width = std::max(
+        0, browser_toolbar_start - toolbar_origin.x() - shell_controls_span);
+  }
+
+  const gfx::Size spacer_size(spacer_width, 1);
+  if (compact_shell_column_spacer_->GetPreferredSize() != spacer_size) {
+    compact_shell_column_spacer_->SetPreferredSize(spacer_size);
+  }
+}
