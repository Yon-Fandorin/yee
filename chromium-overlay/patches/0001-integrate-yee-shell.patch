+void TabDragHandlerImpl::InvalidateTabStripDragLayout() {
+  auto* strip = views::AsViewClass<TabStripView>(root_node_->view());
+  if (!strip) {
+    return;
+  }
+  if (auto* pinned = strip->GetPinnedTabsContainer()) {
+    pinned->InvalidateLayout();
+  }
+  if (auto* unpinned = strip->GetUnpinnedTabsContainer()) {
+    unpinned->InvalidateLayout();
+  }
+}
