+void TabDragHandlerImpl::ClearIncomingDropSlots() {
+  incoming_favorites_slot_.reset();
+  incoming_unpinned_gap_before_.reset();
+  incoming_group_id_.reset();
+  incoming_group_gap_before_.reset();
