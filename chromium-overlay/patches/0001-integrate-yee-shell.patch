+void TabDragHandlerImpl::UpdateFavoriteDropFromPoint(
+    const gfx::Point& point_in_screen) {
+  if (!yee::UsesExpandedSidebarPresentation() || !drag_controller_) {
+    return;
+  }
+  const FavoriteDrop previous_drop = favorite_drop_;
+  const auto previous_favorites_slot = incoming_favorites_slot_;
+  const auto previous_unpinned_gap = incoming_unpinned_gap_before_;
+  const auto previous_group = incoming_group_id_;
+  const auto previous_group_gap = incoming_group_gap_before_;
+  const views::View* const strip = root_node_->view();
+  if (!strip) {
+    favorite_drop_ = FavoriteDrop::kNone;
+    return;
+  }
+  const bool over_favorites =
+      yee::PointHitsFavoritesDropTarget(*strip, point_in_screen);
+  if (IsDraggingPinnedTabs()) {
+    favorite_drop_ =
+        over_favorites ? FavoriteDrop::kNone : FavoriteDrop::kUnpin;
+  } else if (!over_favorites) {
+    favorite_drop_ = FavoriteDrop::kNone;
+  } else {
+    int adding = 0;
+    for (const TabDragData& tab_drag_data :
+         drag_controller_->GetSessionData().tab_drag_data_) {
+      if (tab_drag_data.contents && !tab_drag_data.pinned) {
+        ++adding;
+      }
+    }
+    favorite_drop_ = yee::CanFavoriteDrop(
+                         tab_strip_model_->IndexOfFirstNonPinnedTab(), adding)
+                         ? FavoriteDrop::kPin
+                         : FavoriteDrop::kNone;
+  }
+  UpdateIncomingDropSlots(point_in_screen);
+  if (previous_drop != favorite_drop_ ||
+      previous_favorites_slot != incoming_favorites_slot_ ||
+      previous_unpinned_gap != incoming_unpinned_gap_before_ ||
+      previous_group != incoming_group_id_ ||
+      previous_group_gap != incoming_group_gap_before_) {
+    InvalidateTabStripDragLayout();
+  }
+}
+
+void TabDragHandlerImpl::UpdateYeeDragPreview(
+    const gfx::Point& point_in_screen) {
+  if (!yee::UsesExpandedSidebarPresentation() || !drag_controller_ ||
+      IsDraggingGroups()) {
+    HideYeeDragPreview();
+    return;
+  }
+
+  auto* const strip = views::AsViewClass<TabStripView>(root_node_->view());
+  if (!strip) {
+    HideYeeDragPreview();
+    return;
+  }
+  const DragSessionData& session = drag_controller_->GetSessionData();
+  if (session.tab_drag_data_.empty() ||
+      session.source_view_index_ >= session.tab_drag_data_.size()) {
+    HideYeeDragPreview();
+    return;
+  }
+
+  int dragged_favorites = 0;
+  for (const TabDragData& data : session.tab_drag_data_) {
+    if (data.contents && data.pinned) {
+      ++dragged_favorites;
+    }
+  }
+  const bool favorites_source_will_be_empty =
+      IsDraggingPinnedTabs() && dragged_favorites > 0 &&
+      dragged_favorites >= tab_strip_model_->IndexOfFirstNonPinnedTab();
+  // Keep the zero-state invitation and its layout slot stable for the entire
+  // drag. This leaves a clear path back to Favorites and avoids moving the Tab
+  // list as the pointer crosses the section boundary.
+  strip->SetFavoritesDropZoneVisibleForDrag(/*visible=*/true,
+                                            favorites_source_will_be_empty);
+
+  const TabDragData* const source = session.source_view_drag_data();
+  if (!source || !source->contents) {
+    HideYeeDragPreview();
+    return;
+  }
+
+  ui::ImageModel favicon;
+  std::u16string title;
+  views::View* source_view =
+      source->attached_view ? ViewFromTabSlot(source->attached_view) : nullptr;
+  if (auto* tab_view = views::AsViewClass<TabView>(source_view)) {
+    favicon = tab_view->data().favicon;
+    title = tab_view->data().title;
+  } else if (tabs::TabInterface* tab =
+                 tabs::TabInterface::MaybeGetFromContents(source->contents)) {
+    tabs::TabData data = tabs::TabData::FromTabInterface(tab);
+    favicon = data.favicon;
+    title = data.title;
+  }
+
+  const bool over_favorites =
+      yee::PointHitsFavoritesDropTarget(*strip, point_in_screen);
+  yee::ShowFavoritesDragPreview(*strip, point_in_screen, over_favorites,
+                                favicon, title, drag_grab_offset_,
+                                drag_tile_size_);
+  SetDraggedTabViewsHidden(true);
+}
+
+void TabDragHandlerImpl::HideYeeDragPreview() {
+  if (auto* const strip =
+          views::AsViewClass<TabStripView>(root_node_->view())) {
+    if (!preserve_favorites_drop_zone_during_commit_) {
+      strip->SetFavoritesDropZoneVisibleForDrag(false,
+                                                /*source_will_be_empty=*/false);
+    }
+    yee::HideFavoritesDragPreview(*strip);
+  }
+}
+
+void TabDragHandlerImpl::InvalidateTabStripDragLayout() {
+  auto* strip = views::AsViewClass<TabStripView>(root_node_->view());
+  if (!strip) {
+    return;
+  }
+  if (auto* pinned = strip->GetPinnedTabsContainer()) {
+    pinned->InvalidateLayout();
+  }
+  if (auto* unpinned = strip->GetUnpinnedTabsContainer()) {
+    unpinned->InvalidateLayout();
+  }
+}
