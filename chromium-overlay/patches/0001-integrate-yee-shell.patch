+void ToolbarView::ConfigureForCompactShell() {
+  CHECK(initialized_);
+  CHECK_EQ(display_mode_, DisplayMode::kNormal);
+  if (compact_shell_mode_) {
+    return;
+  }
+  compact_shell_mode_ = true;
+
+  auto* const toolbar_background = background()->AsA<CustomCornersBackground>();
+  CHECK(toolbar_background);
+  toolbar_background->SetVisible(false);
+
+  auto* const vertical_tabs_controller =
+      tabs::VerticalTabStripStateController::From(browser_);
+  CHECK(vertical_tabs_controller);
+  auto sidebar_button = yee::CreateShellToolbarButton(base::BindRepeating(
+      &ToolbarView::ToggleCompactShellSidebar, base::Unretained(this)));
+  sidebar_button->SetVectorIcon(kDockToLeftIcon);
+
+  auto add_button = yee::CreateShellAddButton(
+      base::BindRepeating(&ExecuteYeeCreateAction, browser_));
+  add_button->SetVectorIcon(kAddIcon);
+  ToolbarButton* const compact_shell_add_button =
+      AddChildViewAt(std::move(add_button), 0);
+
+  const auto show_agent_activity = [](Browser* browser,
+                                      const ui::Event& event) {
+    ShowYeeAgentActivity(browser, event.flags());
