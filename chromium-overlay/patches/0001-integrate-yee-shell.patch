+
+void ToolbarView::SetCompactShellSurfaceColor(std::optional<SkColor> color) {
+  if (!compact_shell_mode_ || !location_bar_view_) {
+    return;
+  }
+
+  location_bar_view_->SetCompactShellSurfaceColor(color);
+
+  std::optional<SkColor> foreground;
+  std::optional<SkColor> disabled_foreground;
+  if (GetNativeTheme()->preferred_contrast() !=
+      ui::NativeTheme::PreferredContrast::kMore) {
+    const SkColor surface =
+        yee::ResolveBrowserSurfaceHeaderColor(*GetColorProvider(), color);
+    const yee::BrowserSurfaceHeaderColors colors =
+        yee::ResolveBrowserSurfaceHeaderColors(surface);
+    foreground = colors.primary;
+    disabled_foreground = colors.disabled;
+  }
+
+  const auto update_button = [&](ToolbarButton* button) {
+    if (button) {
+      button->SetForegroundColorOverrides(foreground, disabled_foreground);
+    }
+  };
+  update_button(compact_shell_sidebar_button_);
+  update_button(back_);
+  update_button(forward_);
+  update_button(reload_);
+  if (extensions_container_) {
+    update_button(extensions_container_->GetExtensionsButton());
+  }
+}
+
+void ToolbarView::SetCompactShellLocationBarHost(
+    ContentsContainerView* split_host) {
+  if (!compact_shell_mode_ || !location_bar_view_ ||
+      compact_shell_location_bar_host_ == split_host) {
+    return;
+  }
+
+  const bool in_split = split_host != nullptr;
+  location_bar_view_->SetProperty(
+      views::kFlexBehaviorKey,
+      CreateLocationBarFlexSpecification(
+          /*constrain_cross_axis_to_preferred=*/true));
+
+  std::unique_ptr<views::View> owned_location_bar;
+  if (compact_shell_location_bar_host_) {
+    owned_location_bar =
+        compact_shell_location_bar_host_->DetachYeeSplitLocationBar();
+  } else {
+    CHECK_EQ(location_bar_view_->parent(), this);
+    owned_location_bar = RemoveChildViewT(location_bar_view_);
+  }
+
+  compact_shell_location_bar_host_ = split_host;
+  if (split_host) {
+    split_host->AttachYeeSplitLocationBar(std::move(owned_location_bar));
+  } else {
+    CHECK(compact_shell_leading_divider_);
+    const size_t location_bar_index =
+        GetIndexOf(compact_shell_leading_divider_).value() + 1;
+    AddChildViewAt(std::move(owned_location_bar), location_bar_index);
+  }
+
+  location_bar_view_->SetCompactShellSplitMode(in_split);
+  compact_shell_sidebar_button_->SetVisible(!in_split);
+  back_->SetVisible(!in_split);
+  forward_->SetVisible(!in_split);
+  reload_->SetVisible(!in_split);
+  if (extensions_container_) {
+    if (in_split) {
+      // The split pane headers own their navigation controls, so suppress the
+      // top-level extension dock while the Omnibox is hosted in a pane.
+      extensions_container_->SetVisible(false);
+    } else {
+      // Chromium owns extension availability. In particular, an empty
+      // extension model must keep the dock hidden when leaving split view.
+      extensions_container_->UpdateContainerVisibility();
+    }
+  }
+  location_bar_view_->SetVisible(true);
+  InvalidateLayout();
+}
