+  // Native glass is a Yee product default on supported macOS versions. Keep
+  // it in compiled startup policy so Finder, Dock, tests, and run.sh all get
+  // the same shell without launcher-specific appearance flags.
+  feature_flags.EnableIfNotSet(features::kGlassFrame);
