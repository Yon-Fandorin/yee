+  auto agent_button = yee::CreateAgentToolbarButton(
+      base::BindRepeating(show_agent_activity, browser_));
+  ToolbarButton* const compact_shell_agent_button =
+      AddChildViewAt(std::move(agent_button), 1);
+  compact_shell_sidebar_button_ = AddChildViewAt(std::move(sidebar_button), 2);
+  auto shell_column_spacer = std::make_unique<views::View>();
+  shell_column_spacer->SetCanProcessEventsWithinSubtree(false);
+  shell_column_spacer->SetProperty(views::kMarginsKey, gfx::Insets());
+  compact_shell_column_spacer_ =
+      AddChildViewAt(std::move(shell_column_spacer), 3);
+  compact_shell_sidebar_subscription_ =
+      vertical_tabs_controller->RegisterOnCollapseChanged(
+          base::BindRepeating(&ToolbarView::UpdateCompactShellSidebarButton,
+                              base::Unretained(this)));
+  UpdateCompactShellSidebarButton(vertical_tabs_controller->GetCollapseState());
+
+  CHECK(location_bar_view_);
+  const size_t location_bar_index = GetIndexOf(location_bar_view_).value();
+  compact_shell_leading_divider_ =
+      AddChildViewAt(std::make_unique<ToolbarDivider>(), location_bar_index);
+  compact_shell_leading_divider_->SetVisible(false);
+
+  if (forward_) {
+    forward_->SetVisible(true);
+  }
+  if (home_) {
+    home_->SetVisible(false);
+  }
+  if (split_tabs_) {
+    split_tabs_->SetVisible(false);
+  }
+  if (glic_actor_button_container_) {
+    glic_actor_button_container_->SetVisible(false);
+  }
+  if (glic_button_) {
