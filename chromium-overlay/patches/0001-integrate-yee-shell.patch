+// static.
+void TabCollectionAnimatingLayoutManager::PrepareYeeCrossRegionArrival(
+    const tabs::TabInterface* tab) {
+  CHECK(tab);
+  GetPendingYeeArrivals().insert_or_assign(tab, nullptr);
+}
+
+// static.
+void TabCollectionAnimatingLayoutManager::AnimateYeeCrossRegionArrival(
+    const tabs::TabInterface* tab) {
+  CHECK(tab);
+  auto& arrivals = GetPendingYeeArrivals();
+  auto it = arrivals.find(tab);
+  if (it == arrivals.end()) {
+    return;
+  }
+  views::View* const arrived_view = it->second;
+  arrivals.erase(it);
+  if (!arrived_view || !arrived_view->GetProperty(kYeeCrossRegionArrival)) {
+    return;
+  }
+
+  arrived_view->SetPaintToLayer();
+  arrived_view->layer()->SetFillsBoundsOpaquely(false);
+  ui::Layer* const layer = arrived_view->layer();
+  layer->GetAnimator()->StopAnimating();
+  layer->SetOpacity(0.0f);
+  gfx::Transform initial_transform;
+  initial_transform.Translate(-yee::kSidebarMetrics.cross_region_arrival_offset,
+                              0);
+  layer->SetTransform(initial_transform);
+
+  const base::TimeDelta duration =
+      base::Milliseconds(yee::kSidebarMetrics.cross_region_arrival_duration_ms);
+  if (!gfx::Animation::ShouldRenderRichAnimation() ||
+      gfx::Animation::PrefersReducedMotion()) {
+    layer->SetTransform(gfx::Transform());
+    layer->SetOpacity(1.0f);
+    if (arrived_view->parent()) {
+      arrived_view->parent()->InvalidateLayout();
+    }
+    return;
+  }
+
+  ui::ScopedLayerAnimationSettings settings(layer->GetAnimator());
+  settings.SetTransitionDuration(duration);
+  settings.SetTweenType(gfx::Tween::ACCEL_20_DECEL_100);
+  settings.SetPreemptionStrategy(
+      ui::LayerAnimator::IMMEDIATELY_ANIMATE_TO_NEW_TARGET);
+  layer->SetTransform(gfx::Transform());
+  layer->SetOpacity(1.0f);
+
+  auto tracker = std::make_unique<views::ViewTracker>(arrived_view);
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](std::unique_ptr<views::ViewTracker> tracker) {
+            if (views::View* view = tracker->view()) {
+              // Keep the arrival marker until the destination container has
+              // also finished moving its neighbors. Invalidating here lets a
+              // shorter Tab-container animation clean up after the layer
+              // motion, while the longer Favorites animation retains the
+              // marker and cannot start a second move for the arriving tile.
+              if (view->parent()) {
+                view->parent()->InvalidateLayout();
+              }
+            }
+          },
+          std::move(tracker)),
+      duration);
+}
