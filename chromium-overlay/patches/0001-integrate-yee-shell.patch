+void ToolbarView::UpdateCompactShellLocationBarMargins() {
+  if (!compact_shell_mode_ || !location_bar_view_) {
+    return;
+  }
+
+  const int leading_margin = yee::kSidebarMetrics.location_bar_margin;
+  const int trailing_margin = yee::kSidebarMetrics.location_bar_margin;
+  location_bar_view_->SetProperty(
+      views::kMarginsKey,
+      base::i18n::IsRTL()
+          ? gfx::Insets::TLBR(0, trailing_margin, 0, leading_margin)
+          : gfx::Insets::TLBR(0, leading_margin, 0, trailing_margin));
