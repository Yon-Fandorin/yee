 namespace {
 
+constexpr char kDisableYeeShellScaffoldSwitch[] =
+    "disable-yee-shell-scaffold";
+
+bool IsYeeShellScaffoldEnabled() {
+  return !base::CommandLine::ForCurrentProcess()->HasSwitch(
+      kDisableYeeShellScaffoldSwitch);
+}
+
+bool IsSystemHighContrastEnabled() {
+  HIGHCONTRAST high_contrast = {sizeof(high_contrast)};
+  return ::SystemParametersInfo(SPI_GETHIGHCONTRAST, sizeof(high_contrast),
+                                &high_contrast, 0) &&
+         (high_contrast.dwFlags & HCF_HIGHCONTRASTON) != 0;
+}
+
+void SuppressYeeDwmBorder(HWND hwnd) {
+  if (!hwnd || IsSystemHighContrastEnabled()) {
+    return;
+  }
+
+  // Windows 11 otherwise paints an activation-colored one-pixel border even
+  // when Chromium owns the client frame. DWMWA_COLOR_NONE removes only that
+  // border; DWM still supplies the window shadow and rounded corners.
+  constexpr COLORREF kNoBorderColor = 0xFFFFFFFE;  // DWMWA_COLOR_NONE
+  ::DwmSetWindowAttribute(hwnd, DWMWA_BORDER_COLOR, &kNoBorderColor,
+                          sizeof(kNoBorderColor));
+}
+
 int GetTopAreaHeight(const BrowserFrameView* frame) {
   if (auto* const opaque = views::AsViewClass<OpaqueBrowserFrameView>(frame)) {
     return opaque->GetTopAreaHeight();
