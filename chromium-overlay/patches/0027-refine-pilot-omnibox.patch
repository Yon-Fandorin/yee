+void ToolbarView::UpdateCompactShellLocationBarMargins() {
+  if (!compact_shell_mode_ || !location_bar_view_) {
+    return;
+  }
+
+  int leading_margin = kYeeCompactLocationBarDefaultMargin;
+  auto* const controller = tabs::VerticalTabStripStateController::From(browser_);
+  if (controller && controller->GetCollapseState() ==
+                        tabs::VerticalTabStripCollapseState::kExpanded) {
+    // Align the Omnibox surface with the actual content start. The controller
+    // notifies the existing collapse callback when the user resizes the pinned
+    // sidebar, so this stays aligned with restored custom widths too.
+    const int target_from_toolbar = controller->GetUncollapsedWidth() +
+                                    kYeeCompactContentGutter -
+                                    kYeeCompactToolbarLeadingInset;
+    const int fixed_leading_span =
+        kYeeCompactToolbarInteriorInset +
+        kYeeCompactLeadingControlCount * kYeeCompactControlSpan +
+        kYeeCompactDividerSpan;
+    leading_margin =
+        std::max(kYeeCompactLocationBarDefaultMargin,
+                 target_from_toolbar - fixed_leading_span);
+  }
+
+  const int trailing_margin = kYeeCompactLocationBarDefaultMargin;
+  location_bar_view_->SetProperty(
+      views::kMarginsKey,
+      base::i18n::IsRTL()
+          ? gfx::Insets::TLBR(0, trailing_margin, 0, leading_margin)
+          : gfx::Insets::TLBR(0, leading_margin, 0, trailing_margin));
 }
 
