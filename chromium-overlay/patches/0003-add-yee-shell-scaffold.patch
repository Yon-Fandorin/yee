+// The status surface owns its own small compositor layer. Status changes must
+// never invalidate the full-window shell or the WebContents layer.
+class YeeAgentStatusView : public views::View {
+ public:
+  enum class Status {
+    kReady,
+    kWorking,
+    kNeedsInput,
+  };
+
+  YeeAgentStatusView() {
+    SetCanProcessEventsWithinSubtree(false);
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+    layer()->SetName("YeeAgentStatusView");
+
+    const base::CommandLine* const command_line =
+        base::CommandLine::ForCurrentProcess();
+    const std::string requested_status =
+        command_line->GetSwitchValueASCII(kYeeAgentStatusSwitch);
+    if (requested_status == "working") {
+      status_ = Status::kWorking;
+    } else if (requested_status == "needs-input") {
+      status_ = Status::kNeedsInput;
+    }
+
+    if (requested_status.empty() &&
+        command_line->HasSwitch(kYeeAgentStatusDemoSwitch)) {
+      demo_timer_.Start(FROM_HERE, base::Seconds(2.5), this,
+                        &YeeAgentStatusView::AdvanceDemo);
+    }
+  }
+
+  YeeAgentStatusView(const YeeAgentStatusView&) = delete;
+  YeeAgentStatusView& operator=(const YeeAgentStatusView&) = delete;
+  ~YeeAgentStatusView() override = default;
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    const gfx::Rect bounds = GetLocalBounds();
+    if (bounds.IsEmpty()) {
+      return;
+    }
+
+    std::u16string_view title;
+    std::u16string_view detail;
+    SkColor status_color;
+    switch (status_) {
+      case Status::kReady:
+        title = u"Ready";
+        detail = u"No active task";
+        status_color = SkColorSetRGB(91, 139, 127);
+        break;
+      case Status::kWorking:
+        title = u"Working";
+        detail = u"Reading this tab";
+        status_color = SkColorSetRGB(65, 156, 132);
+        break;
+      case Status::kNeedsInput:
+        title = u"Needs input";
+        detail = u"Waiting for you";
+        status_color = SkColorSetRGB(190, 132, 78);
+        break;
+    }
+
+    cc::PaintFlags halo_flags;
+    halo_flags.setAntiAlias(true);
+    halo_flags.setColor(SkColorSetA(status_color, 34));
+    halo_flags.setStyle(cc::PaintFlags::kFill_Style);
+    const gfx::PointF indicator_center(17.0f, 17.0f);
+    canvas->DrawCircle(indicator_center, 7.0f, halo_flags);
+
+    cc::PaintFlags indicator_flags;
+    indicator_flags.setAntiAlias(true);
+    indicator_flags.setColor(status_color);
+    indicator_flags.setStyle(cc::PaintFlags::kFill_Style);
+    canvas->DrawCircle(indicator_center, 3.5f, indicator_flags);
+
+    const gfx::FontList title_font = gfx::FontList().Derive(
+        -1, gfx::Font::NORMAL, gfx::Font::Weight::MEDIUM);
+    const gfx::FontList detail_font = gfx::FontList().Derive(
+        -3, gfx::Font::NORMAL, gfx::Font::Weight::NORMAL);
+    canvas->DrawStringRect(
+        title, title_font, SkColorSetRGB(45, 61, 57),
+        gfx::Rect(30, 6, std::max(0, bounds.width() - 40), 20));
+    canvas->DrawStringRect(
+        detail, detail_font, SkColorSetRGB(101, 116, 111),
+        gfx::Rect(14, 27, std::max(0, bounds.width() - 24), 14));
+  }
+
+ private:
+  void AdvanceDemo() {
+    switch (status_) {
+      case Status::kReady:
+        status_ = Status::kWorking;
+        break;
+      case Status::kWorking:
+        status_ = Status::kNeedsInput;
+        break;
+      case Status::kNeedsInput:
+        status_ = Status::kReady;
+        break;
+    }
+    SchedulePaint();
+  }
+
+  Status status_ = Status::kReady;
+  base::RepeatingTimer demo_timer_;
+};
