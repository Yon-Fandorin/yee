+// A UI-only command runway. Its bounds stay entirely inside the titlebar and
+// never overlap or participate in the WebContents layout.
+class YeeCommandRunwayView : public views::View {
+ public:
+  YeeCommandRunwayView() {
+    SetCanProcessEventsWithinSubtree(false);
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+    layer()->SetName("YeeCommandRunwayView");
+  }
+
+  YeeCommandRunwayView(const YeeCommandRunwayView&) = delete;
+  YeeCommandRunwayView& operator=(const YeeCommandRunwayView&) = delete;
+  ~YeeCommandRunwayView() override = default;
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    constexpr int kControlSize = 28;
+    constexpr int kControlGap = 2;
+    constexpr int kRunwayPadding = 8;
+    constexpr int kAddressHeight = 32;
+    constexpr int kExtensionAreaWidth = 86;
+
+    const gfx::Rect bounds = GetLocalBounds();
+    if (bounds.width() < 300 || bounds.height() < kAddressHeight) {
+      return;
+    }
+
+    const SkColor icon_color = SkColorSetRGB(65, 84, 78);
+    const SkColor muted_icon_color = SkColorSetARGB(112, 65, 84, 78);
+
+    cc::PaintFlags icon_flags;
+    icon_flags.setAntiAlias(true);
+    icon_flags.setColor(icon_color);
+    icon_flags.setStrokeWidth(1.45f);
+    icon_flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+    icon_flags.setStyle(cc::PaintFlags::kStroke_Style);
+
+    cc::PaintFlags muted_icon_flags = icon_flags;
+    muted_icon_flags.setColor(muted_icon_color);
+
+    cc::PaintFlags active_button_flags;
+    active_button_flags.setAntiAlias(true);
+    active_button_flags.setColor(SkColorSetARGB(30, 76, 143, 126));
+    active_button_flags.setStyle(cc::PaintFlags::kFill_Style);
+
+    const int control_y = (bounds.height() - kControlSize) / 2;
+    int control_x = kRunwayPadding;
+    auto control_center = [&](int x) {
+      return gfx::PointF(x + kControlSize / 2.0f,
+                         control_y + kControlSize / 2.0f);
+    };
+
+    // Tab sidebar toggle: the only softly tinted control, giving the runway a
+    // recognizable leading anchor without turning every icon into a button.
+    canvas->DrawRoundRect(
+        gfx::RectF(control_x, control_y, kControlSize, kControlSize), 9.0f,
+        active_button_flags);
+    gfx::RectF tab_icon(control_x + 7.5f, control_y + 7.0f, 13.0f, 14.0f);
+    canvas->DrawRoundRect(tab_icon, 3.5f, icon_flags);
+    canvas->DrawLine(gfx::PointF(tab_icon.x() + 4.5f, tab_icon.y() + 1.0f),
+                     gfx::PointF(tab_icon.x() + 4.5f,
+                                 tab_icon.bottom() - 1.0f),
+                     icon_flags);
+    control_x += kControlSize + 5;
+
+    auto draw_chevron = [&](int x, bool points_left,
+                            const cc::PaintFlags& flags) {
+      const gfx::PointF center = control_center(x);
+      const float direction = points_left ? -1.0f : 1.0f;
+      canvas->DrawLine(
+          gfx::PointF(center.x() + 3.0f * direction, center.y() - 5.0f),
+          gfx::PointF(center.x() - 2.0f * direction, center.y()), flags);
+      canvas->DrawLine(
+          gfx::PointF(center.x() - 2.0f * direction, center.y()),
+          gfx::PointF(center.x() + 3.0f * direction, center.y() + 5.0f),
+          flags);
+    };
+    draw_chevron(control_x, true, muted_icon_flags);
+    control_x += kControlSize + kControlGap;
+    draw_chevron(control_x, false, muted_icon_flags);
+    control_x += kControlSize + kControlGap;
+
+    const gfx::PointF reload_center = control_center(control_x);
+    canvas->DrawCircle(reload_center, 5.5f, icon_flags);
+    canvas->DrawLine(
+        gfx::PointF(reload_center.x() + 4.0f, reload_center.y() - 5.2f),
+        gfx::PointF(reload_center.x() + 7.0f, reload_center.y() - 5.0f),
+        icon_flags);
+    canvas->DrawLine(
+        gfx::PointF(reload_center.x() + 7.0f, reload_center.y() - 5.0f),
+        gfx::PointF(reload_center.x() + 6.2f, reload_center.y() - 2.0f),
+        icon_flags);
+    control_x += kControlSize + 8;
+
+    cc::PaintFlags divider_flags;
+    divider_flags.setColor(SkColorSetARGB(42, 65, 84, 78));
+    divider_flags.setStrokeWidth(1.0f);
+    divider_flags.setStyle(cc::PaintFlags::kStroke_Style);
+    canvas->DrawLine(gfx::PointF(control_x, 15.0f),
+                     gfx::PointF(control_x, bounds.height() - 15.0f),
+                     divider_flags);
+
+    const int address_x = control_x + 10;
+    const int extension_x = std::max(address_x + 140,
+                                     bounds.width() - kExtensionAreaWidth);
+    const int address_width = std::max(0, extension_x - address_x - 8);
+    const int address_y = (bounds.height() - kAddressHeight) / 2;
+
+    cc::PaintFlags address_fill_flags;
+    address_fill_flags.setAntiAlias(true);
+    address_fill_flags.setColor(SkColorSetARGB(70, 255, 255, 255));
+    address_fill_flags.setStyle(cc::PaintFlags::kFill_Style);
+    cc::PaintFlags address_outline_flags;
+    address_outline_flags.setAntiAlias(true);
+    address_outline_flags.setColor(SkColorSetARGB(56, 255, 255, 255));
+    address_outline_flags.setStrokeWidth(1.0f);
+    address_outline_flags.setStyle(cc::PaintFlags::kStroke_Style);
+    gfx::RectF address_rect(address_x, address_y, address_width,
+                            kAddressHeight);
+    address_rect.Inset(0.5f);
+    canvas->DrawRoundRect(address_rect, 11.0f, address_fill_flags);
+    canvas->DrawRoundRect(address_rect, 11.0f, address_outline_flags);
+
+    cc::PaintFlags site_halo_flags;
+    site_halo_flags.setAntiAlias(true);
+    site_halo_flags.setColor(SkColorSetARGB(30, 67, 146, 125));
+    site_halo_flags.setStyle(cc::PaintFlags::kFill_Style);
+    cc::PaintFlags site_dot_flags = site_halo_flags;
+    site_dot_flags.setColor(SkColorSetRGB(72, 137, 120));
+    const gfx::PointF site_center(address_x + 15.0f,
+                                  bounds.height() / 2.0f);
+    canvas->DrawCircle(site_center, 6.0f, site_halo_flags);
+    canvas->DrawCircle(site_center, 2.5f, site_dot_flags);
+
+    const gfx::FontList address_font = gfx::FontList().Derive(
+        -2, gfx::Font::NORMAL, gfx::Font::Weight::MEDIUM);
+    canvas->DrawStringRect(
+        u"example.com", address_font, SkColorSetRGB(66, 82, 77),
+        gfx::Rect(address_x + 27, address_y + 7,
+                  std::max(0, address_width - 38), 18));
+
+    // Two quiet pinned-extension marks plus one overflow control reserve the
+    // shape of the final extension area without committing runtime behavior.
+    cc::PaintFlags extension_one_flags;
+    extension_one_flags.setAntiAlias(true);
+    extension_one_flags.setColor(SkColorSetRGB(104, 159, 143));
+    extension_one_flags.setStyle(cc::PaintFlags::kFill_Style);
+    cc::PaintFlags extension_two_flags = extension_one_flags;
+    extension_two_flags.setColor(SkColorSetRGB(128, 137, 151));
+    const float extension_center_y = bounds.height() / 2.0f;
+    canvas->DrawCircle(gfx::PointF(extension_x + 13.0f, extension_center_y),
+                       5.0f, extension_one_flags);
+    canvas->DrawCircle(gfx::PointF(extension_x + 35.0f, extension_center_y),
+                       5.0f, extension_two_flags);
+    for (int dot = 0; dot < 3; ++dot) {
+      canvas->DrawCircle(
+          gfx::PointF(extension_x + 57.0f + dot * 4.0f,
+                      extension_center_y),
+          1.15f, site_dot_flags);
+    }
+  }
+};
