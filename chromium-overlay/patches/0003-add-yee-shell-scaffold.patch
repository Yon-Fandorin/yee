+// A deliberately content-free shell used while Yee's top-level regions are
+// being designed. The existing Chromium views stay alive beneath this overlay
+// so the experiment remains reversible and does not fork browser behavior.
+class YeeShellScaffoldView : public views::View {
+ public:
+  YeeShellScaffoldView() {
+    SetCanProcessEventsWithinSubtree(false);
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+    layer()->SetName("YeeShellScaffoldView");
+  }
+
+  YeeShellScaffoldView(const YeeShellScaffoldView&) = delete;
+  YeeShellScaffoldView& operator=(const YeeShellScaffoldView&) = delete;
+  ~YeeShellScaffoldView() override = default;
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    constexpr int kWindowControlsWidth = 88;
+
+    const gfx::Rect bounds = GetLocalBounds();
+    if (bounds.IsEmpty()) {
+      return;
+    }
+
+    // These low-alpha surfaces allow the native GlassFrame material to remain
+    // visible without imposing a decorative gradient on the shell.
+    canvas->FillRect(gfx::Rect(0, 0, bounds.width(), kYeeTitlebarHeight),
+                     SkColorSetARGB(38, 225, 235, 232));
+    canvas->FillRect(
+        gfx::Rect(0, kYeeTitlebarHeight, kYeeSidebarWidth,
+                  std::max(0, bounds.height() - kYeeTitlebarHeight)),
+        SkColorSetARGB(31, 225, 235, 232));
+
+    cc::PaintFlags surface_flags;
+    surface_flags.setAntiAlias(true);
+    surface_flags.setColor(SkColorSetARGB(31, 255, 255, 255));
+    surface_flags.setStyle(cc::PaintFlags::kFill_Style);
+
+    cc::PaintFlags outline_flags;
+    outline_flags.setAntiAlias(true);
+    outline_flags.setColor(SkColorSetARGB(82, 255, 255, 255));
+    outline_flags.setStrokeWidth(1.0f);
+    outline_flags.setStyle(cc::PaintFlags::kStroke_Style);
+
+    auto draw_section = [&](const gfx::Rect& rect) {
+      if (rect.IsEmpty()) {
+        return;
+      }
+      gfx::RectF section(rect);
+      section.Inset(0.5f);
+      canvas->DrawRoundRect(section, kYeeContentCornerRadius, surface_flags);
+      canvas->DrawRoundRect(section, kYeeContentCornerRadius, outline_flags);
+    };
+
+    const int top_height = kYeeTitlebarHeight - 2 * kYeeShellGutter;
+    const int sidebar_inner_right = kYeeSidebarWidth - kYeeShellGutter;
+    const int runway_x = kYeeSidebarWidth + kYeeShellGutter;
+    const int trailing_x =
+        std::max(runway_x, bounds.width() - kYeeTrailingWidth);
+    draw_section(gfx::Rect(kWindowControlsWidth, kYeeShellGutter,
+                           sidebar_inner_right - kWindowControlsWidth,
+                           top_height));
+    draw_section(gfx::Rect(runway_x, kYeeShellGutter,
+                           std::max(0, trailing_x - runway_x - kYeeShellGutter),
+                           top_height));
+    draw_section(gfx::Rect(trailing_x, kYeeShellGutter,
+                           std::max(0, bounds.width() - trailing_x -
+                                           kYeeShellGutter),
+                           top_height));
+    draw_section(gfx::Rect(
+        kYeeShellGutter, kYeeTitlebarHeight + kYeeShellGutter,
+        kYeeSidebarWidth - 2 * kYeeShellGutter,
+        std::max(0, bounds.height() - kYeeTitlebarHeight -
+                        2 * kYeeShellGutter)));
+
+    cc::PaintFlags content_outline_flags;
+    content_outline_flags.setAntiAlias(true);
+    content_outline_flags.setColor(SkColorSetARGB(52, 74, 110, 101));
+    content_outline_flags.setStrokeWidth(1.0f);
+    content_outline_flags.setStyle(cc::PaintFlags::kStroke_Style);
+    gfx::RectF content_rect(
+        gfx::Rect(kYeeSidebarWidth + kYeeShellGutter,
+                  kYeeTitlebarHeight + kYeeShellGutter,
+                  std::max(0, bounds.width() - kYeeSidebarWidth -
+                                  2 * kYeeShellGutter),
+                  std::max(0, bounds.height() - kYeeTitlebarHeight -
+                                  2 * kYeeShellGutter)));
+    content_rect.Inset(0.5f);
+    canvas->DrawRoundRect(content_rect, kYeeContentCornerRadius,
+                          content_outline_flags);
+  }
+};
