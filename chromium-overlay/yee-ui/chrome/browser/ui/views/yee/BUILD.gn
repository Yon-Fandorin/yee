assert(is_win || is_mac || is_linux || is_chromeos)

source_set("yee_ui") {
  public = [
    "favorites.h",
    "group_mark_signals.h",
    "sidebar_sections.h",
    "vertical_group_color_mark.h",
    "vertical_tab_text_view.h",
    "yee_ui.h",
  ]
  sources = [
    "favorites.cc",
    "group_mark_signals.cc",
