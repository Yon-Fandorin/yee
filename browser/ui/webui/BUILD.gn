import("//tools/grit/grit_rule.gni")

grit_strings("strings") {
  source = "strings/webui_strings.grd"
  resource_ids = "strings/resource_ids.spec"
  output_prefix = "webui_strings_"
  outputs = [ "grit/webui_strings.h" ]
}

action("resources") {
  script = "resources/build_resources.py"
  deps = [
    "//chrome/browser/resources/downloads:build_ts",
    "//ui/webui/resources/mojo:build_ts",
    "//ui/webui/resources/mojo:copy_bindings_dts",
  ]
  downloads_module = "$root_gen_dir/chrome/browser/resources/downloads/tsc/downloads.mojom-webui.js"
  inputs = [
    downloads_module,
    "$root_gen_dir/chrome/browser/resources/downloads/tsc/downloads.mojom-webui.d.ts",
    "$root_gen_dir/ui/webui/resources/tsc/mojo/mojo/public/js/bindings.d.ts",
    "$root_gen_dir/ui/webui/resources/tsc/mojo/mojo/public/mojom/base/string16.mojom-webui.d.ts",
    "$root_gen_dir/ui/webui/resources/tsc/mojo/mojo_browser_proxy.d.ts",
    "$root_gen_dir/ui/webui/resources/tsc/mojo/url/mojom/url.mojom-webui.d.ts",
    "frontend/.prettierrc.json",
    "frontend/.prettierignore",
    "frontend/package.json",
    "frontend/package-lock.json",
    "frontend/vite.config.ts",
    "frontend/tsconfig.json",
    "frontend/src/app.html",
    "frontend/src/app.d.ts",
    "frontend/src/hooks.client.ts",
    "frontend/src/hooks.ts",
    "frontend/src/routes/downloads/+page.svelte",
    "frontend/src/routes/downloads/downloads.svelte.ts",
    "frontend/src/routes/downloads/components/DownloadRow.svelte",
    "frontend/src/routes/downloads/components/DownloadFileIcon.svelte",
    "frontend/src/styles.css",
    "frontend/src/lib/i18n.ts",
    "frontend/src/routes/(settings)/bridge.ts",
    "frontend/src/routes/(settings)/settings.svelte.ts",
    "frontend/src/lib/components/Icon.svelte",
    "frontend/src/lib/components/Hint.svelte",
    "frontend/src/lib/components/SettingLink.svelte",
    "frontend/src/lib/components/SettingsGroup.svelte",
    "frontend/src/lib/components/SettingsFeedback.svelte",
    "frontend/src/lib/components/SettingsNotice.svelte",
    "frontend/src/lib/components/SettingsPageHeader.svelte",
    "frontend/src/lib/components/SettingsRow.svelte",
    "frontend/src/routes/+layout.ts",
    "frontend/src/routes/+layout.svelte",
    "frontend/src/routes/(settings)/+layout.svelte",
    "frontend/src/routes/(settings)/+page.svelte",
    "frontend/src/routes/(settings)/settings-scroll.svelte.ts",
    "frontend/src/routes/(settings)/components/SettingsNavigation.svelte",
    "frontend/src/routes/(settings)/content-blocking/+page.svelte",
    "frontend/src/routes/(settings)/content-blocking/components/FilterLists.svelte",
    "frontend/src/routes/(settings)/content-blocking/components/FilterSubscriptions.svelte",
    "frontend/src/routes/(settings)/content-blocking/components/SiteExceptions.svelte",
    "frontend/src/routes/(settings)/content-blocking/components/BlockedDomains.svelte",
    "frontend/src/routes/(settings)/content-blocking/components/DomainList.svelte",
    "frontend/src/routes/(settings)/content-blocking/components/DomainListItem.svelte",
    "frontend/src/routes/(settings)/content-blocking/components/FilterSubscriptionItem.svelte",
    "frontend/src/routes/(settings)/content-blocking/components/DomainImport.svelte",
    "frontend/src/lib/components/ui/badge/badge.svelte",
    "frontend/src/lib/components/ui/badge/index.ts",
    "frontend/src/lib/components/ui/button/button.svelte",
    "frontend/src/lib/components/ui/button/index.ts",
    "frontend/src/lib/components/ui/card/card-action.svelte",
    "frontend/src/lib/components/ui/card/card-content.svelte",
    "frontend/src/lib/components/ui/card/card-description.svelte",
    "frontend/src/lib/components/ui/card/card-footer.svelte",
    "frontend/src/lib/components/ui/card/card-header.svelte",
    "frontend/src/lib/components/ui/card/card-title.svelte",
    "frontend/src/lib/components/ui/card/card.svelte",
    "frontend/src/lib/components/ui/card/index.ts",
    "frontend/src/lib/components/ui/checkbox/index.ts",
    "frontend/src/lib/components/ui/checkbox/checkbox.svelte",
    "frontend/src/lib/components/ui/switch/index.ts",
    "frontend/src/lib/components/ui/switch/switch.svelte",
    "frontend/src/lib/components/ui/input/index.ts",
    "frontend/src/lib/components/ui/input/input.svelte",
    "frontend/src/lib/components/ui/label/index.ts",
    "frontend/src/lib/components/ui/label/label.svelte",
    "frontend/src/lib/components/ui/separator/index.ts",
    "frontend/src/lib/components/ui/separator/separator.svelte",
    "frontend/src/lib/components/ui/tooltip/index.ts",
    "frontend/src/lib/components/ui/tooltip/tooltip.svelte",
    "frontend/src/lib/components/ui/tooltip/tooltip-trigger.svelte",
    "frontend/src/lib/components/ui/tooltip/tooltip-content.svelte",
    "frontend/src/lib/components/ui/tooltip/tooltip-provider.svelte",
    "frontend/src/lib/components/ui/tooltip/tooltip-portal.svelte",
    "frontend/src/lib/styles/theme.css",
    "frontend/src/lib/utils.ts",
    "strings/webui_strings.grd",
  ]
  outputs = [
    "$target_gen_dir/frontend_resources.h",
    "$target_gen_dir/webui_string_map.inc",
  ]
  args = [
    rebase_path(outputs[0], root_build_dir),
    rebase_path("frontend", root_build_dir),
    "--module",
    rebase_path(downloads_module, root_build_dir),
    "downloads.mojom-webui.js",
    "--types",
    rebase_path(
        "$root_gen_dir/chrome/browser/resources/downloads/tsc/downloads.mojom-webui.d.ts",
        root_build_dir),
    "src/routes/downloads/downloads.mojom-webui.d.ts",
    "--type-path",
    "//resources/mojo/*",
    rebase_path("$root_gen_dir/ui/webui/resources/tsc/mojo/*", root_build_dir),
  ]
}

source_set("webui") {
  sources = [
    "webui_resources.cc",
    "webui_resources.h",
  ]
  public_deps = [ "//content/public/browser" ]
  deps = [
    ":resources",
    ":strings",
    "//base",
    "//base/version_info",
    "//chrome/browser:browser_process",
    "//chrome/browser/profiles:profile",
    "//ui/base",
  ]
}
