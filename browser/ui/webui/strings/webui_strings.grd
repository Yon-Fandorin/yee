      <message name="IDS_YEE_WEBUI_INVALID_LIST_URL" desc="invalidListUrl: text in the browser settings UI." meaning="invalidListUrl">Enter an HTTPS filter file URL without a username, password or fragment. Built-in lists cannot be added again.</message>
      <message name="IDS_YEE_WEBUI_DUPLICATE_LIST" desc="duplicateList: text in the browser settings UI." meaning="duplicateList">This filter list is already subscribed.</message>
      <message name="IDS_YEE_WEBUI_SUBSCRIPTION_LIMIT" desc="subscriptionLimit: text in the browser settings UI." meaning="subscriptionLimit">You can subscribe to up to 10 filter lists.</message>
      <message name="IDS_YEE_WEBUI_SUBSCRIPTION_STORAGE_LIMIT" desc="subscriptionStorageLimit: text in the browser settings UI." meaning="subscriptionStorageLimit">Subscribed lists can total up to 16 MB. No changes were saved.</message>
      <message name="IDS_YEE_WEBUI_INVALID_LIST" desc="invalidList: text in the browser settings UI." meaning="invalidList">This file does not contain compatible ad blocking rules. HTML pages, empty lists and lists requiring additional included files are not supported.</message>
      <message name="IDS_YEE_WEBUI_SUBSCRIPTION_DOWNLOAD_FAILED" desc="subscriptionDownloadFailed: text in the browser settings UI." meaning="subscriptionDownloadFailed">Could not download the list. Check the HTTPS file URL and try again. Files must be no larger than 4 MB.</message>
      <message name="IDS_YEE_WEBUI_SUBSCRIPTION_BUSY" desc="subscriptionBusy: text in the browser settings UI." meaning="subscriptionBusy">Another filter list operation is in progress. Try again when it finishes.</message>
