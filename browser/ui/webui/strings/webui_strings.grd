      <message name="IDS_YEE_WEBUI_PREVIOUS_PAGE" desc="previousPage: text in the browser settings UI." meaning="previousPage">Previous</message>
      <message name="IDS_YEE_WEBUI_NEXT_PAGE" desc="nextPage: text in the browser settings UI." meaning="nextPage">Next</message>
      <message name="IDS_YEE_WEBUI_DOMAIN_ALREADY_ADDED" desc="domainAlreadyAdded: text in the browser settings UI." meaning="domainAlreadyAdded">This domain is already added. Change its subdomain setting in the list below.</message>
      <message name="IDS_YEE_WEBUI_SUBSCRIPTIONS_TITLE" desc="subscriptionsTitle: text in the browser settings UI." meaning="subscriptionsTitle">External filter lists</message>
      <message name="IDS_YEE_WEBUI_SUBSCRIPTIONS_DESCRIPTION" desc="subscriptionsDescription: text in the browser settings UI." meaning="subscriptionsDescription">Subscribe to rules maintained by others. Lists are shared by all profiles; changes apply after restarting the browser.</message>
