      <message name="IDS_YEE_WEBUI_SUBSCRIPTION_HINT" desc="subscriptionHint: text in the browser settings UI." meaning="subscriptionHint">Enter an HTTPS URL pointing to an ad blocking rules file. Up to 10 lists, 4 MB each and 16 MB in total. Enabled lists update automatically.</message>
      <message name="IDS_YEE_WEBUI_SUBSCRIPTIONS_EMPTY" desc="subscriptionsEmpty: text in the browser settings UI." meaning="subscriptionsEmpty">No external filter lists subscribed</message>
      <message name="IDS_YEE_WEBUI_SUBSCRIPTION_ENABLED_LABEL" desc="subscriptionEnabledLabel: text in the browser settings UI." meaning="subscriptionEnabledLabel">Enable <ph name="VALUE">$1<ex>1</ex></ph></message>
      <message name="IDS_YEE_WEBUI_SUBSCRIPTION_ENABLED" desc="subscriptionEnabled: text in the browser settings UI." meaning="subscriptionEnabled">Enabled</message>
