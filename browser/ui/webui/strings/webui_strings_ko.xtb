<?xml version='1.0' encoding='utf-8'?>
<translationbundle lang="ko">
  <translation id="6095444980290943125">설정</translation>
  <translation id="1479370378418427445">설정 홈</translation>
  <translation id="1949792669499588660">본문으로 이동</translation>
  <translation id="7490267615755894055">일반</translation>
  <translation id="6203637951769994121">광고 및 추적 차단</translation>
  <translation id="6262759855049923835">고급 설정</translation>
  <translation id="2463696930976652074">브라우저 환경과 개인정보 보호 설정을 관리하세요.</translation>
  <translation id="9151681068421308562">브라우징 보호</translation>
  <translation id="2057646437160978909">광고 및 추적 차단</translation>
  <translation id="1817694473886901691">필터 업데이트, 차단할 도메인과 사이트별 차단 예외를 관리하세요.</translation>
  <translation id="4298743177663173221">필터 업데이트, 도메인 차단과 사이트별 예외</translation>
  <translation id="8409855285911497572">브라우저 설정</translation>
  <translation id="6481477749947090980">아래 항목은 고급 설정에서 열립니다.</translation>
  <translation id="5937775024646845428">사이트 권한</translation>
  <translation id="8459034368379661738">카메라, 마이크, 위치 사용 권한</translation>
  <translation id="1847241944159024222">개인정보 및 보안</translation>
  <translation id="1412223401206735569">인터넷 사용 기록과 보안</translation>
  <translation id="6807776153502104854">모양</translation>
  <translation id="2990488457307705254">테마와 화면 표시</translation>
  <translation id="8110830742817670814">이 화면은 시스템의 라이트·다크 모드를 따릅니다.</translation>
  <translation id="6094984954313876672">다운로드</translation>
  <translation id="2524519825755556632">파일 저장 위치와 다운로드 설정</translation>
  <translation id="121765559298954495">차단 켜짐</translation>
  <translation id="225542894895702447">차단 꺼짐</translation>
  <translation id="2277672995456893084">차단 상태 확인 중…</translation>
  <translation id="3154191273280788359">차단 필터</translation>
  <translation id="7252099524292269974">광고와 추적 요청을 차단하는 필터 목록입니다.</translation>
  <translation id="6989042599344819995">업데이트 확인</translation>
  <translation id="4341625865984074699">확인 중…</translation>
  <translation id="3498253872918206980">광고 요청과 페이지 내 광고</translation>
  <translation id="5098699485799422004">활동 추적 요청</translation>
  <translation id="1404818538165197662">기본 제공</translation>
  <translation id="684722991992683244">업데이트본</translation>
  <translation id="7207008172890709667">마지막 확인: <ph name="VALUE" />
  </translation>
  <translation id="5954755492376497678">브라우저에 포함된 기본 필터를 사용 중입니다.</translation>
  <translation id="7268015603174929699">새 필터가 준비되었습니다. 브라우저를 다시 시작하면 적용됩니다.</translation>
  <translation id="7842024191578632536">시크릿·게스트 창에서는 필터를 업데이트할 수 없습니다.</translation>
  <translation id="2464228675858271292">현재 실행에서는 필터를 업데이트할 수 없습니다.</translation>
  <translation id="2538334083805830041">차단 예외 사이트</translation>
  <translation id="2634698060593638593">추가한 사이트에서만 차단이 꺼집니다. www.example.com 같은 하위 도메인은 따로 추가하세요.</translation>
  <translation id="3193137693843309920">사이트 주소</translation>
  <translation id="955749282183802914">example.com</translation>
  <translation id="4295360098184645276">사이트 추가</translation>
  <translation id="8978260381133177776">주소창의 방패 버튼으로 차단을 끈 사이트도 여기에 표시됩니다.</translation>
  <translation id="7927284973242920751">도메인 규칙과 사이트별 차단 예외 변경은 현재 시크릿·게스트 창에서만 적용됩니다.</translation>
  <translation id="2062050145344963835">추가한 사이트가 없습니다</translation>
  <translation id="2727780118202423468">차단을 끄려는 사이트의 주소를 위에 입력하세요.</translation>
  <translation id="6920484175279406134">차단 예외 사이트 목록</translation>
  <translation id="230111505674340710">차단 켜기</translation>
  <translation id="6870746035555586281">
    <ph name="VALUE" /> 차단 켜기</translation>
  <translation id="3329917590954651501">example.com 또는 https://example.com처럼 사이트 주소를 입력하세요.</translation>
  <translation id="2014097250360482795">이 창에서는 필터를 업데이트할 수 없습니다.</translation>
  <translation id="6734115820559300286">변경 사항을 저장하지 못했습니다. 다시 시도하세요.</translation>
  <translation id="5471307425926119077">이 사이트의 차단을 껐습니다. 열려 있는 해당 페이지를 새로고침하세요.</translation>
  <translation id="6556714683110373832">이 사이트의 차단을 켰습니다. 열려 있는 해당 페이지를 새로고침하세요.</translation>
  <translation id="564747077622186922">필터 업데이트를 확인하고 있습니다…</translation>
  <translation id="1736247180480848741">브라우저를 다시 시작하면 새 필터가 적용됩니다.</translation>
  <translation id="495069707169612748">필터가 최신 상태입니다.</translation>
  <translation id="3647293743830925085">일부 필터를 갱신하지 못했습니다. 해당 목록은 이전 저장본을 유지합니다. 나중에 다시 시도하세요.</translation>
  <translation id="6034379694665802459">설정을 불러오지 못했습니다. 다시 시도하세요.</translation>
  <translation id="615233787031865153">다시 시도</translation>
  <translation id="4186938248247582318">
    <ph name="VALUE" /> — 설정</translation>
  <translation id="5828551325648126605">차단할 도메인</translation>
  <translation id="6017566973278761741">등록한 도메인으로 가는 요청과 해당 사이트 접속을 차단합니다. 하위 도메인 포함 여부도 선택할 수 있습니다. 차단을 끈 사이트에서는 이 규칙도 적용되지 않습니다.</translation>
  <translation id="1110083349988545375">도메인</translation>
  <translation id="9143791905449128414">하위 도메인 포함</translation>
  <translation id="7288897791769447475">도메인 추가</translation>
  <translation id="8946198220756378117">삭제</translation>
  <translation id="3353610361705799859">
    <ph name="VALUE" /> 차단 규칙 삭제</translation>
  <translation id="16626503440551505">
    <ph name="VALUE" />의 하위 도메인 포함</translation>
  <translation id="5736323316908490365">차단 규칙을 저장했습니다. 해당 페이지를 새로고침하면 적용됩니다.</translation>
  <translation id="6029443799863194511">차단 규칙을 삭제했습니다. 해당 페이지를 새로고침하면 적용됩니다.</translation>
  <translation id="6938716389398651772">ads.example.com처럼 도메인만 입력하세요. URL, 경로, 와일드카드는 사용할 수 없습니다.</translation>
  <translation id="407242330273771352">추가한 차단 도메인이 없습니다</translation>
  <translation id="1019736972640981308">CSV에는 domain 열과 선택 사항인 include_subdomains 열(true/false)을 넣으세요. TXT는 한 줄에 도메인 하나를 적으며 하위 도메인도 포함합니다. UTF-8 파일 2MB, 최대 5,000개 항목을 지원합니다.</translation>
  <translation id="7588262746643142276">파일 가져오기</translation>
  <translation id="7779263561879858781">CSV 내보내기</translation>
  <translation id="7552293532108416453">양식 다운로드</translation>
  <translation id="1532092778158092221">가져올 도메인 확인</translation>
  <translation id="6320665315007639362">추가 <ph name="VALUE1" />개 · 중복 <ph name="VALUE2" />개 · 오류 <ph name="VALUE3" />개. 새로운 유효 도메인만 등록하며 기존 규칙은 유지합니다.</translation>
  <translation id="6212510006908840546">
    <ph name="VALUE" />개 도메인 등록</translation>
  <translation id="9181046023695927298">취소</translation>
  <translation id="4117899907777625646">도메인 <ph name="VALUE" />개를 등록했습니다. 해당 페이지를 새로고침하면 적용됩니다.</translation>
  <translation id="7823323302277840616">이미 등록했거나 파일 내 중복</translation>
  <translation id="4594545172814919009">등록 가능</translation>
  <translation id="5101113990717446454">열 개수가 헤더와 다릅니다</translation>
  <translation id="4912100699245478549">include_subdomains는 true/false로 입력하세요</translation>
  <translation id="7210642064172486772">파일을 읽을 수 없습니다. CSV 양식이나 한 줄에 도메인 하나를 적은 UTF-8 TXT 파일을 사용하세요.</translation>
  <translation id="7215546740655028975">2MB 이하 파일을 선택하세요.</translation>
  <translation id="2451402887264279411">파일과 저장 목록은 각각 최대 5,000개 도메인을 지원합니다. 변경 사항은 저장하지 않았습니다.</translation>
  <translation id="2506185502788063398">파일에 가져올 도메인이 없습니다.</translation>
  <translation id="2316453563705263063">줄</translation>
  <translation id="2275112559546794539">결과</translation>
  <translation id="6269311977024820176">이 도메인만</translation>
  <translation id="3073695815760715527">도메인과 하위 도메인</translation>
  <translation id="7593872156151936782">읽는 중…</translation>
  <translation id="4227916800411066722">이전</translation>
  <translation id="1588991892358526662">다음</translation>
  <translation id="7009126666638523577">이미 등록된 도메인입니다. 아래 목록에서 하위 도메인 포함 여부를 변경하세요.</translation>
  <translation id="6191348196806821176">외부 필터 목록</translation>
  <translation id="2344676466489693184">다른 사람이 관리하는 차단 규칙을 구독합니다. 모든 프로필에 공통 적용되며, 변경 사항은 브라우저 재시작 후 적용됩니다.</translation>
  <translation id="3835827226043410709">필터 목록 URL</translation>
  <translation id="4454068914075565936">구독 추가</translation>
  <translation id="6881405402971450879">저장 중…</translation>
  <translation id="2050559852086613576">광고 차단 규칙 파일의 HTTPS 주소를 입력하세요. 최대 10개 목록, 목록당 4MB·전체 16MB를 지원합니다. 켜진 목록은 자동으로 갱신합니다.</translation>
  <translation id="4289872016442719521">구독한 외부 필터 목록이 없습니다</translation>
  <translation id="6158937047226463953"><ph name="VALUE" /> 사용</translation>
  <translation id="6248065102450904">사용 중</translation>
  <translation id="1622304172963379091">사용 안 함</translation>
  <translation id="3292420797224094281"><ph name="VALUE" /> 구독 삭제</translation>
  <translation id="5970222387294324256">필터 목록을 구독했습니다. 브라우저를 다시 시작하면 적용됩니다.</translation>
  <translation id="2095113195552856421">필터 목록 설정을 저장했습니다. 브라우저를 다시 시작하면 적용됩니다.</translation>
  <translation id="5291110319043603117">필터 목록 구독을 삭제했습니다. 브라우저를 다시 시작하면 적용됩니다.</translation>
  <translation id="4227928964289803174">사용자 이름·비밀번호·주소의 # 부분이 없는 HTTPS 규칙 파일 주소를 입력하세요. 기본 목록은 다시 추가할 수 없습니다.</translation>
  <translation id="7949783336754663648">이미 구독한 필터 목록입니다.</translation>
  <translation id="2083674069919918662">외부 필터 목록은 최대 10개까지 구독할 수 있습니다.</translation>
  <translation id="7506405174604632747">구독 목록의 전체 용량은 16MB까지 지원합니다. 변경 사항은 저장하지 않았습니다.</translation>
  <translation id="9221101337650016008">호환되는 광고 차단 규칙 파일이 아닙니다. HTML 페이지, 빈 목록, 다른 파일을 추가로 불러오는 목록은 지원하지 않습니다.</translation>
  <translation id="7384771182189604152">목록을 다운로드하지 못했습니다. HTTPS 파일 주소를 확인한 뒤 다시 시도하세요. 파일은 4MB 이하여야 합니다.</translation>
  <translation id="8539640507715121249">다른 필터 목록 작업이 진행 중입니다. 완료된 뒤 다시 시도하세요.</translation>
  <translation id="7336760102762402047">갱신하지 못해 이전에 저장한 목록을 유지합니다.</translation>
  <translation id="1219045817642981039">도메인 검색</translation>
  <translation id="1932623891346786751">전체 <ph name="VALUE2" />개 중 <ph name="VALUE1" />개</translation>
  <translation id="6046270057259060491">이 페이지 선택</translation>
  <translation id="8763436734527702445"><ph name="VALUE" /> 선택</translation>
  <translation id="3413749411539717570">선택 삭제 (<ph name="VALUE" />개)</translation>
  <translation id="7435933574351659903">검색 결과가 없습니다</translation>
  <translation id="6167755326900196662">선택한 차단 규칙을 삭제했습니다. 해당 페이지를 새로고침하면 적용됩니다.</translation>
  <translation id="8412373198805559438">다운로드</translation>
  <translation id="1930462078046334432">폴더 열기</translation>
  <translation id="331348072396375172">기록 모두 삭제</translation>
  <translation id="8887489182680700499">다운로드 검색</translation>
  <translation id="6535625430195312265">검색 지우기</translation>
  <translation id="4292900495211647584">다운로드 기록을 삭제했습니다.</translation>
  <translation id="4253836249679886346">실행 취소</translation>
  <translation id="8438329371958519855">다운로드를 불러오지 못했습니다. 페이지를 새로고침해 다시 시도하세요.</translation>
  <translation id="657865610424069199">새로고침</translation>
  <translation id="6443840484833605083">불러오는 중…</translation>
  <translation id="1993313394264961643">검색 결과가 없습니다.</translation>
  <translation id="4095633175051560385">아직 다운로드한 파일이 없습니다</translation>
  <translation id="5236641651073686539">더 보기</translation>
  <translation id="1703407136286650644">보안 확인 필요</translation>
  <translation id="5072294581464695711">경고 확인</translation>
  <translation id="9134807370729781812">파일이 삭제되었거나 이동되었습니다</translation>
  <translation id="5902869542434381740">취소됨</translation>
  <translation id="4823240072872453232">일시정지됨</translation>
  <translation id="7172569146379326609">완료됨</translation>
  <translation id="4660024567538447469">시크릿 다운로드</translation>
  <translation id="6215083888548176260">다운로드 진행률</translation>
  <translation id="947667680429646446">폴더에서 보기</translation>
  <translation id="956856082253109709">일시정지</translation>
  <translation id="6235959103583551796">계속 다운로드</translation>
  <translation id="570795845515420227">다시 시도</translation>
  <translation id="5327565821732479276">취소</translation>
  <translation id="7297508532472695312">기록에서 삭제</translation>
  <translation id="3100716283901940">파일</translation>
  <translation id="7009104405973821897">이미지 파일</translation>
  <translation id="4180039635994218920">동영상 파일</translation>
  <translation id="3152961799785950516">오디오 파일</translation>
  <translation id="8029794284499669878">문서</translation>
  <translation id="6539480927701614303">스프레드시트</translation>
  <translation id="8824748311806085918">프레젠테이션</translation>
  <translation id="4444316541421495720">압축 파일</translation>
  <translation id="3089338946722786155">코드 파일</translation>
  <translation id="7131234990466418595">앱 파일</translation>
</translationbundle>
