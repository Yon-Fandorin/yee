import("//mojo/public/tools/bindings/mojom.gni")
import("//ui/webui/resources/tools/build_webui.gni")

mojom("mojo_bindings") {
  sources = [ "tab_layout.mojom" ]
  webui_module_path = "/yee"
}

build_webui("build") {
  grd_prefix = "yee_customization"
  grd_resource_path_prefix = "yee"
  generate_grdp = true
  ts_files = [
    "panel_styles.ts",
    "tab_layout.html.ts",
    "tab_layout.ts",
  ]
  css_files = [
    "appearance.css",
    "panel.css",
    "tab_layout.css",
  ]
  mojo_files_deps = [ ":mojo_bindings_ts__generator" ]
  mojo_files = [ "$root_gen_dir/chrome/browser/ui/views/yee/webui/customization/tab_layout.mojom-webui.ts" ]
  ts_composite = true
  ts_deps = [
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
  webui_context_type = "trusted"
}
