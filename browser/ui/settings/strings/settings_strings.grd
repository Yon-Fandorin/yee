    <messages fallback_to_english="true">
      <message name="IDS_YEE_SETTINGS_SETTINGS_TITLE" desc="settingsTitle: text in the browser settings UI." meaning="settingsTitle">Settings</message>
      <message name="IDS_YEE_SETTINGS_SETTINGS_HOME" desc="settingsHome: text in the browser settings UI." meaning="settingsHome">Settings home</message>
      <message name="IDS_YEE_SETTINGS_SKIP_TO_CONTENT" desc="skipToContent: text in the browser settings UI." meaning="skipToContent">Skip to content</message>
      <message name="IDS_YEE_SETTINGS_NAV_GENERAL" desc="navGeneral: text in the browser settings UI." meaning="navGeneral">General</message>
      <message name="IDS_YEE_SETTINGS_NAV_BLOCKING" desc="navBlocking: text in the browser settings UI." meaning="navBlocking">Ads &amp; trackers</message>
      <message name="IDS_YEE_SETTINGS_ADVANCED_SETTINGS" desc="advancedSettings: text in the browser settings UI." meaning="advancedSettings">Advanced settings</message>
      <message name="IDS_YEE_SETTINGS_OVERVIEW_DESCRIPTION" desc="overviewDescription: text in the browser settings UI." meaning="overviewDescription">Manage your browser and privacy preferences.</message>
      <message name="IDS_YEE_SETTINGS_BROWSING_PROTECTION" desc="browsingProtection: text in the browser settings UI." meaning="browsingProtection">Browsing protection</message>
      <message name="IDS_YEE_SETTINGS_BLOCKING_TITLE" desc="blockingTitle: text in the browser settings UI." meaning="blockingTitle">Ads &amp; trackers</message>
      <message name="IDS_YEE_SETTINGS_BLOCKING_DESCRIPTION" desc="blockingDescription: text in the browser settings UI." meaning="blockingDescription">Manage filter updates, blocked domains and site exceptions.</message>
      <message name="IDS_YEE_SETTINGS_BLOCKING_LINK_DESCRIPTION" desc="blockingLinkDescription: text in the browser settings UI." meaning="blockingLinkDescription">Filter updates, blocked domains and site exceptions</message>
      <message name="IDS_YEE_SETTINGS_BROWSER_SETTINGS" desc="browserSettings: text in the browser settings UI." meaning="browserSettings">Browser settings</message>
      <message name="IDS_YEE_SETTINGS_NATIVE_DESCRIPTION" desc="nativeDescription: text in the browser settings UI." meaning="nativeDescription">These options open in advanced settings.</message>
      <message name="IDS_YEE_SETTINGS_SITE_PERMISSIONS" desc="sitePermissions: text in the browser settings UI." meaning="sitePermissions">Site permissions</message>
      <message name="IDS_YEE_SETTINGS_SITE_PERMISSIONS_DESCRIPTION" desc="sitePermissionsDescription: text in the browser settings UI." meaning="sitePermissionsDescription">Camera, microphone and location access</message>
      <message name="IDS_YEE_SETTINGS_PRIVACY_SECURITY" desc="privacySecurity: text in the browser settings UI." meaning="privacySecurity">Privacy &amp; security</message>
      <message name="IDS_YEE_SETTINGS_PRIVACY_DESCRIPTION" desc="privacyDescription: text in the browser settings UI." meaning="privacyDescription">Browsing data and security</message>
      <message name="IDS_YEE_SETTINGS_APPEARANCE" desc="appearance: text in the browser settings UI." meaning="appearance">Appearance</message>
      <message name="IDS_YEE_SETTINGS_APPEARANCE_DESCRIPTION" desc="appearanceDescription: text in the browser settings UI." meaning="appearanceDescription">Theme and display preferences</message>
      <message name="IDS_YEE_SETTINGS_APPEARANCE_HINT" desc="appearanceHint: text in the browser settings UI." meaning="appearanceHint">This page uses your system’s light or dark mode.</message>
      <message name="IDS_YEE_SETTINGS_DOWNLOADS" desc="downloads: text in the browser settings UI." meaning="downloads">Downloads</message>
      <message name="IDS_YEE_SETTINGS_DOWNLOADS_DESCRIPTION" desc="downloadsDescription: text in the browser settings UI." meaning="downloadsDescription">Save location and download preferences</message>
      <message name="IDS_YEE_SETTINGS_PROTECTION_ENABLED" desc="protectionEnabled: text in the browser settings UI." meaning="protectionEnabled">Blocking is on</message>
      <message name="IDS_YEE_SETTINGS_PROTECTION_DISABLED" desc="protectionDisabled: text in the browser settings UI." meaning="protectionDisabled">Blocking is off</message>
      <message name="IDS_YEE_SETTINGS_PROTECTION_LOADING" desc="protectionLoading: text in the browser settings UI." meaning="protectionLoading">Loading blocking status…</message>
      <message name="IDS_YEE_SETTINGS_FILTERS_TITLE" desc="filtersTitle: text in the browser settings UI." meaning="filtersTitle">Filter lists</message>
      <message name="IDS_YEE_SETTINGS_FILTERS_DESCRIPTION" desc="filtersDescription: text in the browser settings UI." meaning="filtersDescription">These lists are used to block ads and tracking requests.</message>
      <message name="IDS_YEE_SETTINGS_CHECK_LISTS" desc="checkLists: text in the browser settings UI." meaning="checkLists">Check for updates</message>
      <message name="IDS_YEE_SETTINGS_CHECKING_LISTS" desc="checkingLists: text in the browser settings UI." meaning="checkingLists">Checking…</message>
      <message name="IDS_YEE_SETTINGS_EASY_LIST_DESCRIPTION" desc="easyListDescription: text in the browser settings UI." meaning="easyListDescription">Ad requests and page ads</message>
      <message name="IDS_YEE_SETTINGS_EASY_PRIVACY_DESCRIPTION" desc="easyPrivacyDescription: text in the browser settings UI." meaning="easyPrivacyDescription">Activity tracking requests</message>
      <message name="IDS_YEE_SETTINGS_BUNDLED_FILTER" desc="bundledFilter: text in the browser settings UI." meaning="bundledFilter">Built-in</message>
      <message name="IDS_YEE_SETTINGS_UPDATED_FILTER" desc="updatedFilter: text in the browser settings UI." meaning="updatedFilter">Downloaded</message>
      <message name="IDS_YEE_SETTINGS_LAST_CHECKED" desc="lastChecked: text in the browser settings UI." meaning="lastChecked">Last checked: <ph name="VALUE">$1<ex>Jan 1, 2026, 12:00 PM</ex></ph></message>
      <message name="IDS_YEE_SETTINGS_BUNDLED_NOTE" desc="bundledNote: text in the browser settings UI." meaning="bundledNote">Using the browser’s built-in filters.</message>
      <message name="IDS_YEE_SETTINGS_RESTART_NOTE" desc="restartNote: text in the browser settings UI." meaning="restartNote">New filters are ready. Restart the browser to apply them.</message>
      <message name="IDS_YEE_SETTINGS_PRIVATE_UPDATE_RESTRICTION" desc="privateUpdateRestriction: text in the browser settings UI." meaning="privateUpdateRestriction">Filter updates are not available in private or guest windows.</message>
      <message name="IDS_YEE_SETTINGS_UPDATE_RESTRICTION" desc="updateRestriction: text in the browser settings UI." meaning="updateRestriction">Filter updates are not available for this browser session.</message>
      <message name="IDS_YEE_SETTINGS_EXCEPTIONS_TITLE" desc="exceptionsTitle: text in the browser settings UI." meaning="exceptionsTitle">Sites with blocking turned off</message>
      <message name="IDS_YEE_SETTINGS_EXCEPTIONS_DESCRIPTION" desc="exceptionsDescription: text in the browser settings UI." meaning="exceptionsDescription">Blocking is off only for the added site. Add subdomains, such as www.example.com, separately.</message>
      <message name="IDS_YEE_SETTINGS_SITE_ADDRESS" desc="siteAddress: text in the browser settings UI." meaning="siteAddress">Site address</message>
      <message name="IDS_YEE_SETTINGS_SITE_PLACEHOLDER" desc="sitePlaceholder: text in the browser settings UI." meaning="sitePlaceholder">example.com</message>
      <message name="IDS_YEE_SETTINGS_ADD_EXCEPTION" desc="addException: text in the browser settings UI." meaning="addException">Add site</message>
      <message name="IDS_YEE_SETTINGS_SITE_HINT" desc="siteHint: text in the browser settings UI." meaning="siteHint">Sites you turn blocking off for with the address bar shield also appear here.</message>
      <message name="IDS_YEE_SETTINGS_PRIVATE_NOTE" desc="privateNote: text in the browser settings UI." meaning="privateNote">Changes here apply only to this private or guest session.</message>
      <message name="IDS_YEE_SETTINGS_NO_EXCEPTIONS" desc="noExceptions: text in the browser settings UI." meaning="noExceptions">No sites added</message>
      <message name="IDS_YEE_SETTINGS_NO_EXCEPTIONS_HINT" desc="noExceptionsHint: text in the browser settings UI." meaning="noExceptionsHint">Add a site above to turn off blocking for it.</message>
      <message name="IDS_YEE_SETTINGS_EXCEPTION_LIST_LABEL" desc="exceptionListLabel: text in the browser settings UI." meaning="exceptionListLabel">Sites with blocking turned off</message>
      <message name="IDS_YEE_SETTINGS_REMOVE_EXCEPTION" desc="removeException: text in the browser settings UI." meaning="removeException">Turn on blocking</message>
      <message name="IDS_YEE_SETTINGS_REMOVE_EXCEPTION_LABEL" desc="removeExceptionLabel: text in the browser settings UI." meaning="removeExceptionLabel">Turn on blocking for <ph name="VALUE">$1<ex>example.com</ex></ph></message>
      <message name="IDS_YEE_SETTINGS_INVALID_SITE" desc="invalidSite: text in the browser settings UI." meaning="invalidSite">Enter a site address, such as example.com or https://example.com.</message>
      <message name="IDS_YEE_SETTINGS_UPDATES_UNAVAILABLE" desc="updatesUnavailable: text in the browser settings UI." meaning="updatesUnavailable">Filter updates are not available in this window.</message>
      <message name="IDS_YEE_SETTINGS_CHANGE_FAILED" desc="changeFailed: text in the browser settings UI." meaning="changeFailed">Could not save your changes. Try again.</message>
      <message name="IDS_YEE_SETTINGS_EXCEPTION_ADDED" desc="exceptionAdded: text in the browser settings UI." meaning="exceptionAdded">Blocking is off for this site. Reload its open pages to apply the change.</message>
      <message name="IDS_YEE_SETTINGS_EXCEPTION_REMOVED" desc="exceptionRemoved: text in the browser settings UI." meaning="exceptionRemoved">Blocking is on for this site. Reload its open pages to apply the change.</message>
      <message name="IDS_YEE_SETTINGS_CHECKING_FEEDBACK" desc="checkingFeedback: text in the browser settings UI." meaning="checkingFeedback">Checking for filter updates…</message>
      <message name="IDS_YEE_SETTINGS_UPDATE_READY" desc="updateReady: text in the browser settings UI." meaning="updateReady">Restart the browser to apply the new filters.</message>
      <message name="IDS_YEE_SETTINGS_UP_TO_DATE" desc="upToDate: text in the browser settings UI." meaning="upToDate">Your filters are up to date.</message>
      <message name="IDS_YEE_SETTINGS_UPDATE_FAILED" desc="updateFailed: text in the browser settings UI." meaning="updateFailed">Could not update filters. Existing filters are still in use. Try again later.</message>
      <message name="IDS_YEE_SETTINGS_LOAD_FAILED" desc="loadFailed: text in the browser settings UI." meaning="loadFailed">Could not load settings. Try again.</message>
      <message name="IDS_YEE_SETTINGS_RETRY" desc="retry: text in the browser settings UI." meaning="retry">Try again</message>
      <message name="IDS_YEE_SETTINGS_PAGE_TITLE" desc="pageTitle: text in the browser settings UI." meaning="pageTitle"><ph name="VALUE">$1<ex>Yee</ex></ph> — Settings</message>
      <message name="IDS_YEE_SETTINGS_DOMAINS_TITLE" desc="domainsTitle: text in the browser settings UI." meaning="domainsTitle">Blocked domains</message>
      <message name="IDS_YEE_SETTINGS_DOMAINS_DESCRIPTION" desc="domainsDescription: text in the browser settings UI." meaning="domainsDescription">Block requests and visits to the domains you add. Choose whether to include their subdomains. These rules also follow site exceptions.</message>
      <message name="IDS_YEE_SETTINGS_DOMAIN_ADDRESS" desc="domainAddress: text in the browser settings UI." meaning="domainAddress">Domain</message>
      <message name="IDS_YEE_SETTINGS_INCLUDE_SUBDOMAINS" desc="includeSubdomains: text in the browser settings UI." meaning="includeSubdomains">Include subdomains</message>
      <message name="IDS_YEE_SETTINGS_ADD_DOMAIN" desc="addDomain: text in the browser settings UI." meaning="addDomain">Add domain</message>
      <message name="IDS_YEE_SETTINGS_REMOVE_DOMAIN" desc="removeDomain: text in the browser settings UI." meaning="removeDomain">Remove</message>
      <message name="IDS_YEE_SETTINGS_REMOVE_DOMAIN_LABEL" desc="removeDomainLabel: text in the browser settings UI." meaning="removeDomainLabel">Remove <ph name="VALUE">$1<ex>1</ex></ph> from blocked domains</message>
      <message name="IDS_YEE_SETTINGS_DOMAIN_SCOPE_LABEL" desc="domainScopeLabel: text in the browser settings UI." meaning="domainScopeLabel">Include subdomains of <ph name="VALUE">$1<ex>1</ex></ph></message>
      <message name="IDS_YEE_SETTINGS_DOMAIN_SAVED" desc="domainSaved: text in the browser settings UI." meaning="domainSaved">Domain rule saved. Reload affected pages to apply the change.</message>
      <message name="IDS_YEE_SETTINGS_DOMAIN_REMOVED" desc="domainRemoved: text in the browser settings UI." meaning="domainRemoved">Domain rule removed. Reload affected pages to apply the change.</message>
      <message name="IDS_YEE_SETTINGS_INVALID_DOMAIN" desc="invalidDomain: text in the browser settings UI." meaning="invalidDomain">Enter a domain such as ads.example.com, without a URL, path or wildcard.</message>
      <message name="IDS_YEE_SETTINGS_DOMAINS_EMPTY" desc="domainsEmpty: text in the browser settings UI." meaning="domainsEmpty">No blocked domains added</message>
      <message name="IDS_YEE_SETTINGS_DOMAIN_FILE_HINT" desc="domainFileHint: text in the browser settings UI." meaning="domainFileHint">CSV: domain and optional include_subdomains (true/false). TXT: one domain per line, including subdomains. UTF-8 files up to 2 MB; up to 5,000 entries.</message>
      <message name="IDS_YEE_SETTINGS_IMPORT_DOMAINS" desc="importDomains: text in the browser settings UI." meaning="importDomains">Import file</message>
      <message name="IDS_YEE_SETTINGS_EXPORT_DOMAINS" desc="exportDomains: text in the browser settings UI." meaning="exportDomains">Export CSV</message>
      <message name="IDS_YEE_SETTINGS_DOWNLOAD_DOMAIN_TEMPLATE" desc="downloadDomainTemplate: text in the browser settings UI." meaning="downloadDomainTemplate">Download template</message>
      <message name="IDS_YEE_SETTINGS_DOMAIN_PREVIEW_TITLE" desc="domainPreviewTitle: text in the browser settings UI." meaning="domainPreviewTitle">Review imported domains</message>
      <message name="IDS_YEE_SETTINGS_DOMAIN_PREVIEW_SUMMARY" desc="domainPreviewSummary: text in the browser settings UI." meaning="domainPreviewSummary"><ph name="VALUE1">$1<ex>1</ex></ph> to add · <ph name="VALUE2">$2<ex>1</ex></ph> duplicates · <ph name="VALUE3">$3<ex>1</ex></ph> invalid. Only new valid domains will be added; existing rules stay as they are.</message>
      <message name="IDS_YEE_SETTINGS_APPLY_DOMAIN_IMPORT" desc="applyDomainImport: text in the browser settings UI." meaning="applyDomainImport">Add <ph name="VALUE">$1<ex>1</ex></ph> domains</message>
      <message name="IDS_YEE_SETTINGS_CANCEL_DOMAIN_IMPORT" desc="cancelDomainImport: text in the browser settings UI." meaning="cancelDomainImport">Cancel</message>
      <message name="IDS_YEE_SETTINGS_DOMAIN_IMPORT_ADDED" desc="domainImportAdded: text in the browser settings UI." meaning="domainImportAdded">Added <ph name="VALUE">$1<ex>1</ex></ph> domains. Reload affected pages to apply the change.</message>
      <message name="IDS_YEE_SETTINGS_DOMAIN_IMPORT_DUPLICATE" desc="domainImportDuplicate: text in the browser settings UI." meaning="domainImportDuplicate">Already added or repeated in file</message>
      <message name="IDS_YEE_SETTINGS_DOMAIN_IMPORT_ADD" desc="domainImportAdd: text in the browser settings UI." meaning="domainImportAdd">Ready to add</message>
      <message name="IDS_YEE_SETTINGS_DOMAIN_IMPORT_INVALID_COLUMNS" desc="domainImportInvalidColumns: text in the browser settings UI." meaning="domainImportInvalidColumns">Column count does not match the header</message>
      <message name="IDS_YEE_SETTINGS_DOMAIN_IMPORT_INVALID_SCOPE" desc="domainImportInvalidScope: text in the browser settings UI." meaning="domainImportInvalidScope">Use true/false for include_subdomains</message>
      <message name="IDS_YEE_SETTINGS_DOMAIN_IMPORT_INVALID_FILE" desc="domainImportInvalidFile: text in the browser settings UI." meaning="domainImportInvalidFile">Could not read the file. Use the CSV template or a UTF-8 TXT file with one domain per line.</message>
      <message name="IDS_YEE_SETTINGS_DOMAIN_IMPORT_TOO_LARGE" desc="domainImportTooLarge: text in the browser settings UI." meaning="domainImportTooLarge">Choose a file no larger than 2 MB.</message>
      <message name="IDS_YEE_SETTINGS_DOMAIN_IMPORT_LIMIT" desc="domainImportLimit: text in the browser settings UI." meaning="domainImportLimit">A file and the saved list can each contain up to 5,000 domains. No changes were saved.</message>
      <message name="IDS_YEE_SETTINGS_DOMAIN_IMPORT_EMPTY" desc="domainImportEmpty: text in the browser settings UI." meaning="domainImportEmpty">The file has no domains to import.</message>
      <message name="IDS_YEE_SETTINGS_PREVIEW_LINE_COLUMN" desc="previewLineColumn: text in the browser settings UI." meaning="previewLineColumn">Line</message>
