      <message name="IDS_YEE_SETTINGS_DOMAIN_AND_SUBDOMAINS" desc="domainAndSubdomains: text in the browser settings UI." meaning="domainAndSubdomains">Domain and subdomains</message>
      <message name="IDS_YEE_SETTINGS_READING_DOMAIN_FILE" desc="readingDomainFile: text in the browser settings UI." meaning="readingDomainFile">Reading…</message>
      <message name="IDS_YEE_SETTINGS_PREVIOUS_PAGE" desc="previousPage: text in the browser settings UI." meaning="previousPage">Previous</message>
